@@ -1954,6 +1954,22 @@ pub trait TDisplayObject<'gc>:
             if let Some(int) = self.as_interactive() {
                 int.drop_focus(context);
             }
+            // PS5_RUFFLE_DIRPLAYER_FLASH_V1 (Ruffle5 1.000.038): the focus of an object inside
+            // what was removed goes too. Flash sets the stage's focus to null when the focused
+            // object leaves the display list with one of its ancestors; without this the keys kept
+            // going to a button of a menu already taken down and never reached the stage (Happy
+            // Wheels: after "PLAY NOW" the arrows did nothing until a click into the level).
+            if let Some(focused) = context.focus_tracker.get() {
+                let mut ancestor = focused.as_displayobject().parent();
+                while let Some(a) = ancestor {
+                    if std::ptr::eq(a.as_ptr(), self.as_ptr()) {
+                        let tracker = context.focus_tracker;
+                        tracker.set(None, context);
+                        break;
+                    }
+                    ancestor = a.parent();
+                }
+            }
 
             self.on_parent_removed(context);
         }
