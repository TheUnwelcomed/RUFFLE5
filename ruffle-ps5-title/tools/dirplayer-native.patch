+                "set 3 _root.progress 50",
+                "call 3 _root.mc.gotoAndStop [Number(101.0)]",
+                "get 3 /:_currentframe",
+                "get 3 /mc:_x",
+                "set 3 /:_visible 0",
+            ]
+        );
+    }
+
+    #[test]
+    fn calls_come_back_in_the_order_posted() {
+        clear_calls();
+        post(FlashCall::Event { cast_lib: 1, cast_member: 4, body: "flash_start_game".into() });
+        post(FlashCall::Lingo("startGame".into()));
+        assert_eq!(take_calls().len(), 2);
+        assert!(take_calls().is_empty());
+    }
