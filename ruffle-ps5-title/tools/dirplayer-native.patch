+/// PS5_RUFFLE_DIRPLAYER_NATIVE (1.000.036): the answer of a Flash function, from the program's
+/// Flash host (player/flash_host.rs), as the web version below makes it of the JavaScript one:
+/// undefined and null are VOID, a whole number an integer, a boolean 1 or 0, an array a 0-based
+/// list, an object a handle to where its movie keeps it.
+#[cfg(not(target_arch = "wasm32"))]
+fn convert_js_result_to_lingo_datum(
+    player: &mut crate::player::DirPlayer,
+    result: FlashValue,
+    context_path: &str,
+    cast_lib: i32,
+    cast_member: i32,
+) -> Result<DatumRef, ScriptError> {
+    Ok(match result {
+        FlashValue::Undefined | FlashValue::Null => player.alloc_datum(Datum::Void),
+        FlashValue::String(s) => player.alloc_datum(Datum::String(s)),
+        FlashValue::Number(n) if n.fract() == 0.0 && n >= i32::MIN as f64 && n <= i32::MAX as f64 => player.alloc_datum(Datum::Int(n as i32)),
+        FlashValue::Number(n) => player.alloc_datum(Datum::Float(n)),
+        FlashValue::Bool(b) => player.alloc_datum(Datum::Int(b as i32)),
+        FlashValue::List(values) => {
+            let mut items = VecDeque::new();
+            for v in values {
+                items.push_back(convert_js_result_to_lingo_datum(player, v, context_path, cast_lib, cast_member)?);
+            }
+            player.alloc_datum(Datum::List(crate::director::lingo::datum::DatumType::XmlChildNodes, items, false))
+        }
+        FlashValue::Object(path) => player.alloc_datum(Datum::FlashObjectRef(FlashObjectRef::from_path_with_member(&path, cast_lib, cast_member))),
+    })
+}
