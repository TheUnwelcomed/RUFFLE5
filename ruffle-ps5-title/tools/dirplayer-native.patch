+    pub fn uniform_matrix4fv_with_f32_array(&self, l: Option<&WebGlUniformLocation>, transpose: bool, v: &[f32]) {
+        if let Some(l) = l {
+            tr!(self, "uniformMatrix4fv", J::U(l.program), J::S(&l.full), J::B(transpose), J::Fs(v));
+        }
+        if transpose {
+            // WebGL2 allows it; the 3D renderer never asks for it. Transposed per matrix.
+            let mut t = v.to_vec();
+            for (m, src) in t.chunks_mut(16).zip(v.chunks(16)) {
+                if m.len() == 16 {
+                    for r in 0..4 {
+                        for c in 0..4 {
+                            m[c * 4 + r] = src[r * 4 + c];
+                        }
+                    }
+                }
+            }
+            self.st.borrow_mut().set_uniform(l, &t);
+        } else {
+            self.st.borrow_mut().set_uniform(l, v);
+        }
+    }
