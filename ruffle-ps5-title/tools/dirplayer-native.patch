+//! PS5_RUFFLE_DIRPLAYER_NATIVE — DirPlayer inside another program, without a browser.
+//!
+//! The web front end drives the VM from JavaScript: it loads the movie, runs the frame loop on
+//! `requestAnimationFrame`, forwards DOM input events and draws the stage on a canvas. Off the web
+//! the same jobs fall to the host — Ruffle5 on the PS5 — through [`NativePlayer`]: load a movie
+//! from a file (its external casts and linked movies are read from beside it, as `file:` URLs),
+//! run one score frame at a time, send keys and the mouse, and render the stage into an RGBA
+//! buffer the host shows however it likes. Sound goes to [`super::native_audio`], which the host's
+//! audio thread drains.
+//!
+//! Built on the same pieces as the native test harness (`testing.rs`), without its test-only
+//! parts (the global test lock, panicking on a missing file, sleeping between frames).
+//!
+//! The VM is one global instance (`PLAYER_OPT`): one `NativePlayer` at a time, and every call —
+//! including the async ones, which must be driven by [`block_on`] on the thread that made it —
+//! from one thread.
+//!
+//! 1.000.036: Flash cast members. A host that plays them installs a Flash host
+//! ([`super::flash_host::set_host`]); each frame then starts the Flash sprites that came on stage
+//! as the web frame loop does (`pre_dispatch_flash_members`), and what the Flash movies said to
+//! Lingo runs at the start of each frame and after each input event ([`run_flash_calls`]). The
+//! mouse moves over a Flash sprite reach its movie ([`flash_mouse_move`]).
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::path::Path;
+
+use async_std::channel;
+
+use crate::director::file::read_director_file_bytes;
+use crate::director::lingo::datum::Datum;
+use crate::player::{
+    bitmap::bitmap::{get_system_default_palette, Bitmap, PaletteRef},
+    commands::{run_player_command, PlayerVMCommand},
+    events::{player_invoke_frame_and_movie_scripts, run_event_loop},
+    symbols::symbol::Symbol,
+    fire_pending_timeouts, reserve_player_mut, reserve_player_ref, run_movie_init_sequence,
+    run_single_frame, DirPlayer, PlayerVMExecutionItem, PLAYER_OPT,
+};
+use crate::rendering::render_stage_to_bitmap;
+
+/// Runs `f` to completion on this thread, with DirPlayer's task executor (the VM spawns its
+/// helper tasks onto the calling thread; they only make progress while something here awaits).
+pub fn block_on<F: std::future::Future>(f: F) -> F::Output {
+    crate::player::native_rt::block_on(f)
+}
+
+// ---- what the web gives a movie and the host gives it here ----
+
+/// `setPref` / `getPref`: the web keeps them in the browser's localStorage; here they are files
+/// in the folder the host names ([`NativePlayer::set_prefs_dir`]), one per pref, or — without a
+/// folder — kept for as long as the program runs.
+static PREFS: std::sync::Mutex<(Option<std::path::PathBuf>, Vec<(String, String)>)> = std::sync::Mutex::new((None, Vec::new()));
+
+/// A pref's file name: Director wants a valid file name; anything else becomes `_`.
+fn pref_file_name(name: &str) -> String {
+    let s: String = name.chars().take(64).map(|c| if c.is_ascii_alphanumeric() || "._-".contains(c) { c } else { '_' }).collect();
+    let s = s.trim_start_matches('.').to_string();
+    if s.is_empty() { "_".into() } else { s }
+}
+
+pub(crate) fn read_pref(name: &str) -> Option<String> {
+    let p = PREFS.lock().ok()?;
+    match &p.0 {
+        Some(dir) => std::fs::read_to_string(dir.join(pref_file_name(name))).ok(),
+        None => p.1.iter().find(|(k, _)| k == name).map(|(_, v)| v.clone()),
+    }
+}
+
+pub(crate) fn write_pref(name: &str, value: &str) {
+    let Ok(mut p) = PREFS.lock() else {
+        return;
+    };
+    match p.0.clone() {
+        Some(dir) => {
+            let file = dir.join(pref_file_name(name));
+            let tmp = dir.join(format!(".{}.tmp", pref_file_name(name)));
+            let r = std::fs::create_dir_all(&dir).and_then(|_| std::fs::write(&tmp, value)).and_then(|_| std::fs::rename(&tmp, &file));
+            match r {
+                Ok(()) => log::info!("setPref {name}: {} bytes to {}", value.len(), file.display()),
+                Err(e) => log::warn!("setPref {name}: {}: {e}", file.display()),
+            }
+        }
+        None => match p.1.iter_mut().find(|(k, _)| k == name) {
+            Some(kv) => kv.1 = value.to_string(),
+            None => p.1.push((name.to_string(), value.to_string())),
+        },
+    }
+}
+
+/// What a movie asked for that only a browser does (`gotoNetPage`), for the host to tell the
+/// player about: taken with [`take_notices`].
+static NOTICES: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+
+pub(crate) fn notice(text: String) {
+    log::info!("{text}");
+    if let Ok(mut n) = NOTICES.lock() {
+        if n.len() < 16 {
+            n.push(text);
+        }
+    }
+}
+
+/// The notices since the last call, oldest first.
+pub fn take_notices() -> Vec<String> {
+    NOTICES.lock().map(|mut n| std::mem::take(&mut *n)).unwrap_or_default()
+}
+
+// ---- a Shockwave Projector launch command (Flashpoint's entries) ----
+
+/// A Shockwave Projector (SPR) launch command as archives publish it — the movie's address, then
+/// projector flags — parsed as DirPlayer's web front end parses it (src/utils/launchCommand.js,
+/// `parseLaunchCommand`, ported line for line): the LeechProtectionRemovalHelp flags become Lingo
+/// calls run with `--do` once the movie is loaded (`forceTheExitLock(0)`, `setTheRunMode("Plugin")`),
+/// `--doBefore` runs before it loads, `--go N` goes to a frame once it runs, `--setExternalParam`
+/// sets an external param; projector-only flags are noted and skipped.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct LaunchCommand {
+    pub movie_url: Option<String>,
+    pub external_params: Vec<(String, String)>,
+    pub startup_do: String,
+    pub startup_do_before: String,
+    pub startup_go: u32,
+    pub ignored: Vec<String>,
+}
+
+const LPRH_STRING: [&str; 8] = [
+    "setTheMoviePath",
+    "setTheMovieName",
+    "setTheEnvironment_shockMachineVersion",
+    "setThePlatform",
+    "setTheRunMode",
+    "setTheEnvironment_productBuildVersion",
+    "setTheProductVersion",
+    "setTheEnvironment_osVersion",
+];
+const LPRH_INT: [&str; 4] = ["setTheEnvironment_shockMachine", "setTheMachineType", "forceTheExitLock", "forceTheSafePlayer"];
+const LPRH_BARE: [&str; 3] = ["disableGoToNetMovie", "disableGoToNetPage", "bugfixShockwave3DBadDriverList"];
+const IGNORED_WITH_VALUE: [&str; 7] = ["preload", "newScriptName", "newScriptText", "newScriptType", "trace", "traceLoad", "traceLogFile"];
+const IGNORED_BARE: [&str; 2] = ["versionStrict", "noDirectX7"];
+
+fn find_flag<'a>(list: &[&'a str], name: &str) -> Option<&'a str> {
+    list.iter().find(|f| f.eq_ignore_ascii_case(name)).copied()
+}
+
+/// JavaScript's `/\s/`: Unicode white space and U+FEFF.
+fn js_space(c: char) -> bool {
+    c.is_whitespace() || c == '\u{feff}'
+}
+
+/// The command's tokens: `"…"` quotes one (a `\"` in it is a quote), else white space ends one.
+fn launch_tokens(cmd: &str) -> Vec<String> {
+    let c: Vec<char> = cmd.chars().collect();
+    let mut tokens = Vec::new();
+    let mut i = 0;
+    while i < c.len() {
+        while i < c.len() && js_space(c[i]) {
+            i += 1;
+        }
+        if i >= c.len() {
+            break;
+        }
+        let mut buf = String::new();
+        if c[i] == '"' {
+            i += 1;
+            while i < c.len() {
+                if c[i] == '\\' && c.get(i + 1) == Some(&'"') {
+                    buf.push('"');
+                    i += 2;
+                    continue;
+                }
+                if c[i] == '"' {
+                    i += 1;
+                    break;
+                }
+                buf.push(c[i]);
+                i += 1;
+            }
+        } else {
+            while i < c.len() && !js_space(c[i]) {
+                buf.push(c[i]);
+                i += 1;
+            }
+        }
+        tokens.push(buf);
+    }
+    tokens
+}
+
+/// Lingo has one string delimiter, `"`; a payload written with `'` (inside the command's own
+/// double quotes) gets them back, unless it already has a `"`.
+fn normalize_quotes(code: &str) -> String {
+    if code.contains('"') || !code.contains('\'') {
+        code.to_string()
+    } else {
+        code.replace('\'', "\"")
+    }
+}
+
+/// JavaScript's `parseInt(s, 10)`: an optional sign and the digits at the start, after white space.
+fn js_parse_int(s: &str) -> Option<i64> {
+    let t = s.trim_start_matches(js_space);
+    let (neg, rest) = match t.strip_prefix('-') {
+        Some(r) => (true, r),
+        None => (false, t.strip_prefix('+').unwrap_or(t)),
+    };
+    let digits: String = rest.chars().take_while(|c| c.is_ascii_digit()).collect();
+    let n: i64 = digits.parse().ok()?;
+    Some(if neg { -n } else { n })
+}
+
+/// `…SPR.exe ` in front of a command (some entries name the projector), dropped.
+fn strip_projector(cmd: &str) -> &str {
+    let t = cmd.trim_start_matches(js_space);
+    let end = t.find(js_space).unwrap_or(t.len());
+    let first = t[..end].to_ascii_lowercase();
+    let is_spr = first.strip_suffix(".exe").is_some_and(|stem| stem.rfind("spr").is_some_and(|i| stem[i + 3..].chars().all(|c| c.is_ascii_alphabetic())));
+    let rest = &t[end..];
+    if is_spr && rest.starts_with(js_space) {
+        rest.trim_start_matches(js_space)
+    } else {
+        cmd
+    }
+}
+
+pub fn parse_launch_command(cmd: &str) -> LaunchCommand {
+    let mut result = LaunchCommand::default();
+    let tokens = launch_tokens(strip_projector(cmd));
+    let mut lprh = Vec::new();
+    let mut doing = Vec::new();
+    let mut i = 0;
+    let next = |i: &mut usize| -> String {
+        if *i + 1 < tokens.len() {
+            *i += 1;
+            tokens[*i].clone()
+        } else {
+            String::new()
+        }
+    };
+    while i < tokens.len() {
+        let raw = tokens[i].clone();
+        let Some(flag) = raw.strip_prefix("--") else {
+            if result.movie_url.is_none() {
+                result.movie_url = Some(raw);
+            }
+            i += 1;
+            continue;
+        };
+        let lower = flag.to_ascii_lowercase();
+        if lower == "do" {
+            doing.push(normalize_quotes(&next(&mut i)));
+        } else if lower == "dobefore" {
+            let before = normalize_quotes(&next(&mut i));
+            if result.startup_do_before.is_empty() {
+                result.startup_do_before = before;
+            } else {
+                result.startup_do_before = format!("{}\n{before}", result.startup_do_before);
+            }
+        } else if lower == "go" {
+            if let Some(frame) = js_parse_int(&next(&mut i)) {
+                result.startup_go = frame.clamp(0, u32::MAX as i64) as u32;
+            }
+        } else if lower == "setexternalparam" {
+            let key = next(&mut i);
+            let value = next(&mut i);
+            if !key.is_empty() {
+                match result.external_params.iter_mut().find(|(k, _)| *k == key) {
+                    Some(kv) => kv.1 = value,
+                    None => result.external_params.push((key, value)),
+                }
+            }
+        } else if let Some(f) = find_flag(&LPRH_STRING, flag) {
+            lprh.push(format!("{f}(\"{}\")", next(&mut i).replace('"', "")));
+        } else if let Some(f) = find_flag(&LPRH_INT, flag) {
+            lprh.push(format!("{f}({})", js_parse_int(&next(&mut i)).unwrap_or(0)));
+        } else if let Some(f) = find_flag(&LPRH_BARE, flag) {
+            lprh.push(format!("{f}()"));
+        } else if find_flag(&IGNORED_WITH_VALUE, flag).is_some() {
+            next(&mut i);
+            result.ignored.push(flag.to_string());
+        } else if find_flag(&IGNORED_BARE, flag).is_some() {
+            result.ignored.push(flag.to_string());
+        } else {
+            // unknown: a value after it that is not a flag is its own, not the movie
+            if i + 1 < tokens.len() && !tokens[i + 1].starts_with("--") {
+                i += 1;
+            }
+            result.ignored.push(flag.to_string());
+        }
+        i += 1;
+    }
+    result.startup_do = lprh.into_iter().chain(doing).filter(|l| !l.is_empty()).collect::<Vec<_>>().join("\n");
+    result
+}
+
+/// What a launch command asks for (`parse_launch_command`), as the web front end's
+/// `applyLaunchCommand` hands it to the VM: its external params, and the Lingo for before the
+/// movie loads (`--doBefore`, run by [`NativePlayer::load`]), after it loads (`--do`, before its
+/// `prepareMovie`), and the frame to go to once it runs (`--go`). For the movie about to load.
+pub fn apply_launch_command(lc: &LaunchCommand) {
+    reserve_player_mut(|player| {
+        for (k, v) in &lc.external_params {
+            player.external_params.insert(k.to_string(), v.to_string());
+        }
+        player.startup_do_before = Some(lc.startup_do_before.clone()).filter(|s| !s.is_empty());
+        player.startup_do = Some(lc.startup_do.clone()).filter(|s| !s.is_empty());
+        player.startup_go = Some(lc.startup_go).filter(|&f| f != 0);
+    });
+    if !lc.ignored.is_empty() {
+        log::info!("launch command: projector-only flags skipped: {}", lc.ignored.join(", "));
+    }
+}
+
+/// The address the movie was published at (`http://host/path/movie.dcr`): `the moviePath` and
+/// `the movieName` say it, as on its old site — a sitelocked movie checks them — and the files it
+/// asks for under that address are read from the folder it was loaded from (DirPlayer's movie
+/// path override, `set_movie_path_override` on the web). For the movie about to load.
+pub fn set_movie_address(url: &str) {
+    reserve_player_mut(|player| {
+        player.movie_path_override = Some(url.to_string()).filter(|s| !s.is_empty());
+    });
+}
+
+/// 1.000.034: what the host fetches for a request not on disk (see
+/// [`crate::player::net_task::Fetcher`]); [`NativePlayer::new`] clears it.
+pub fn set_fetcher(f: Option<crate::player::net_task::Fetcher>) {
+    crate::player::net_task::set_fetcher(f);
+}
