+/// The folder web addresses are read from: `http://host/dir/file` is `<dir>/host/dir/file`, as
+/// an archive's game data holds a game's captured files (Flashpoint: its `content/` folder).
+/// Without one (and [`NativePlayer::new`] clears it) a web address the movie asks for is not read.
+pub fn set_web_root(dir: &str) {
+    crate::player::net_task::set_web_root(Some(std::path::PathBuf::from(dir)).filter(|d| !d.as_os_str().is_empty()));
+}
