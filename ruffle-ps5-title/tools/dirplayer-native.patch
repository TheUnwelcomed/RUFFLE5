index 0000000..3af20f3
--- /dev/null
+++ b/vm-rust/src/player/native.rs
@@ -0,0 +1,182 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE — DirPlayer inside another program, without a browser.
+//!
+//! The web front end drives the VM from JavaScript: it loads the movie, runs the frame loop on
+//! `requestAnimationFrame`, forwards DOM input events and draws the stage on a canvas. Off the web
+//! the same jobs fall to the host — Ruffle5 on the PS5 — through [`NativePlayer`]: load a movie
+//! from a file (its external casts and linked movies are read from beside it, as `file:` URLs),
+//! run one score frame at a time, send keys and the mouse, and render the stage into an RGBA
+//! buffer the host shows however it likes. Sound goes to [`super::native_audio`], which the host's
+//! audio thread drains.
+//!
+//! Built on the same pieces as the native test harness (`testing.rs`), without its test-only
+//! parts (the global test lock, panicking on a missing file, sleeping between frames).
+//!
+//! The VM is one global instance (`PLAYER_OPT`): one `NativePlayer` at a time, and every call —
+//! including the async ones, which must be driven by [`block_on`] on the thread that made it —
+//! from one thread.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::path::Path;
+
+use async_std::channel;
+
+use crate::director::file::read_director_file_bytes;
+use crate::player::{
+    bitmap::bitmap::{get_system_default_palette, Bitmap, PaletteRef},
+    commands::{run_player_command, PlayerVMCommand},
+    events::run_event_loop,
+    fire_pending_timeouts, reserve_player_mut, reserve_player_ref, run_movie_init_sequence,
+    run_single_frame, DirPlayer, PlayerVMExecutionItem, PLAYER_OPT,
+};
+use crate::rendering::render_stage_to_bitmap;
+
+/// Runs `f` to completion on this thread, with DirPlayer's task executor (the VM spawns its
+/// helper tasks onto the calling thread; they only make progress while something here awaits).
+pub fn block_on<F: std::future::Future>(f: F) -> F::Output {
+    async_std::task::block_on(f)
+}
+
+pub struct NativePlayer {
+    _tx: channel::Sender<PlayerVMExecutionItem>,
+    stage: Option<Bitmap>,
+}
+
+impl NativePlayer {
+    /// Sets up the global VM. Call inside [`block_on`].
+    pub fn new() -> NativePlayer {
+        let (tx, _rx) = channel::unbounded();
+        let (event_tx, event_rx) = channel::unbounded();
+        unsafe {
+            crate::player::PLAYER_TX = Some(tx.clone());
+            crate::player::PLAYER_EVENT_TX = Some(event_tx.clone());
+            crate::player::xtra::multiuser::MULTIUSER_XTRA_MANAGER_OPT =
+                Some(crate::player::xtra::multiuser::MultiuserXtraManager::new());
+            crate::player::xtra::xmlparser::XMLPARSER_XTRA_MANAGER_OPT =
+                Some(crate::player::xtra::xmlparser::XmlParserXtraManager::new());
+            crate::player::xtra::curl::CURL_XTRA_MANAGER_OPT = Some(crate::player::xtra::curl::CurlXtraManager::new());
+            PLAYER_OPT = Some(DirPlayer::new(tx.clone()));
+        }
+        crate::player::spawn_player_local(async move {
+            run_event_loop(event_rx).await;
+        });
+        NativePlayer { _tx: tx, stage: None }
+    }
+
+    /// Loads the movie at `path` (a .dir, .dxr or .dcr); its casts and the movies it goes to are
+    /// looked up in the same folder.
+    pub async fn load(&mut self, path: &str) -> Result<(), String> {
+        let bytes = std::fs::read(path).map_err(|e| format!("{path}: {e}"))?;
+        let path = Path::new(path);
+        let file_name = path.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default();
+        let dir = path.parent().ok_or_else(|| format!("{}: no folder", path.display()))?;
+        let dir = std::fs::canonicalize(dir).unwrap_or_else(|_| dir.to_path_buf());
+        let base_url = url::Url::from_directory_path(&dir)
+            .map_err(|_| format!("{}: not a usable folder", dir.display()))?
+            .to_string();
+        let dir_file = read_director_file_bytes(&bytes, &file_name, &base_url)?;
+        reserve_player_mut(|player| {
+            player.is_playing = true;
+            player.is_script_paused = false;
+        });
+        unsafe {
+            let player = crate::player::player_mut();
+            player.load_movie_from_dir(dir_file).await;
+        }
+        Ok(())
+    }
+
+    /// `externalParamValue(name)` for the movie, as an embedding page's `<param>` would set it.
+    /// Call before [`Self::init`].
+    pub fn set_external_param(&mut self, name: &str, value: &str) {
+        reserve_player_mut(|player| {
+            player.external_params.insert(name.to_string(), value.to_string());
+        });
+    }
+
+    /// Starts the movie (prepareMovie, startMovie, the first frame's scripts).
+    pub async fn init(&mut self) {
+        run_movie_init_sequence().await;
+    }
+
+    /// One score frame: due timeouts, then the frame's scripts and events. False once the movie
+    /// has stopped playing.
+    pub async fn frame(&mut self) -> bool {
+        fire_pending_timeouts().await;
+        let (is_playing, _) = run_single_frame().await;
+        is_playing
+    }
+
+    /// Frames per second the score asks for now (puppetTempo or the tempo channel); 0 if none.
+    pub fn tempo(&self) -> u32 {
+        reserve_player_ref(|player| player.movie.get_effective_tempo())
+    }
+
+    pub fn stage_size(&self) -> (u32, u32) {
+        reserve_player_ref(|player| (player.movie.rect.width().max(1) as u32, player.movie.rect.height().max(1) as u32))
+    }
+
+    pub fn current_frame(&self) -> u32 {
+        reserve_player_ref(|player| player.movie.current_frame)
+    }
+
+    /// Renders the stage; returns its RGBA pixels (`width * height * 4` bytes) and size.
+    pub fn render(&mut self) -> (&[u8], u32, u32) {
+        let (w, h) = self.stage_size();
+        let fits = self.stage.as_ref().is_some_and(|b| b.width as u32 == w && b.height as u32 == h);
+        if !fits {
+            self.stage = Some(Bitmap::new(w as u16, h as u16, 32, 32, 0, PaletteRef::BuiltIn(get_system_default_palette())));
+        }
+        let bitmap = self.stage.as_mut().unwrap();
+        reserve_player_mut(|player| render_stage_to_bitmap(player, bitmap, None));
+        (&bitmap.data[..], w, h)
+    }
+
+    /// A key went down. `key` and `code` as a browser's `KeyboardEvent` has them (`"ArrowLeft"`,
+    /// 37; `"a"`, 65; `" "`, 32; `"Enter"`, 13): the VM maps them to Director's.
+    pub async fn key_down(&mut self, key: &str, code: u16) {
+        reserve_player_mut(|player| player.keyboard_manager.key_down(key.to_string(), code));
+        let _ = run_player_command(PlayerVMCommand::KeyDown(key.to_string(), code)).await;
+    }
+
+    pub async fn key_up(&mut self, key: &str, code: u16) {
+        reserve_player_mut(|player| player.keyboard_manager.key_up(key, code));
+        let _ = run_player_command(PlayerVMCommand::KeyUp(key.to_string(), code)).await;
+    }
+
+    /// The mouse moved to `(x, y)` in stage pixels.
+    pub async fn mouse_move(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| player.mouse_loc = (x, y));
+        let _ = run_player_command(PlayerVMCommand::MouseMove((x, y))).await;
+    }
+
+    pub async fn mouse_down(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| {
+            player.mouse_loc = (x, y);
+            player.movie.mouse_down = true;
+        });
+        let _ = run_player_command(PlayerVMCommand::MouseDown((x, y))).await;
+    }
+
+    pub async fn mouse_up(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| {
+            player.mouse_loc = (x, y);
+            player.movie.mouse_down = false;
+        });
+        let _ = run_player_command(PlayerVMCommand::MouseUp((x, y))).await;
+    }
+}
+
+impl Drop for NativePlayer {
+    fn drop(&mut self) {
+        crate::player::native_audio::stop_all();
+        unsafe {
+            // As the test harness does: the VM's globals hold references into the player, so it
+            // is leaked rather than dropped.
+            if let Some(player) = PLAYER_OPT.take() {
+                std::mem::forget(player);
+            }
+            crate::player::PLAYER_TX = None;
+            crate::player::PLAYER_EVENT_TX = None;
+        }
+    }
+}
diff --git a/vm-rust/src/player/native_audio.rs b/vm-rust/src/player/native_audio.rs
new file mode 100644
index 0000000..fbf3183
--- /dev/null
+++ b/vm-rust/src/player/native_audio.rs
@@ -0,0 +1,265 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE — sound without a browser.
+//!
+//! On the web every sound channel plays through Web Audio (an `AudioContext`, buffer sources,
+//! gain and panner nodes). Off the web — Ruffle5 on the PS5, the native tests — there is no
+//! `AudioContext`, so a channel hands its decoded samples to this mixer instead: one [`Voice`] per
+//! playing sound, mixed on demand into whatever buffer the host's audio thread asks for
+//! ([`mix`]). The channel keeps owning the playback *state* (status, loops, playlists, fades,
+//! cues); a voice only knows its samples, where it is, its volume and pan, and whether it has
+//! reached the end — which `SoundChannel::update` turns into the same "ended" the Web Audio
+//! callback reports.
+//!
+//! MP3 (Shockwave Audio, and MP3 cast members) is decoded with Symphonia, the decoder Ruffle
+//! uses; the web build hands those bytes to the browser's `decodeAudioData` instead.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+
+/// One playing sound: its samples (interleaved, `channels` per frame) and where it is.
+pub struct Voice {
+    samples: Arc<Vec<f32>>,
+    channels: usize,
+    frames: usize,
+    rate: f64,
+    looping: bool,
+    /// Playback position in source frames (an `f64`, stored as bits).
+    pos: AtomicU64,
+    /// Linear gain 0..1 and pan -1..1 (`f32` bits).
+    volume: AtomicU32,
+    pan: AtomicU32,
+    paused: AtomicBool,
+    stopped: AtomicBool,
+    finished: AtomicBool,
+}
+
+impl Voice {
+    /// `samples` interleaved with `channels` per frame (1 or 2 are mixed; more use the first two).
+    pub fn new(samples: Arc<Vec<f32>>, channels: u16, rate: u32, looping: bool, volume: f32, pan: f32) -> Arc<Voice> {
+        let channels = (channels.max(1)) as usize;
+        let frames = samples.len() / channels;
+        Arc::new(Voice {
+            samples,
+            channels,
+            frames,
+            rate: rate.max(1) as f64,
+            looping,
+            pos: AtomicU64::new(0f64.to_bits()),
+            volume: AtomicU32::new(volume.clamp(0.0, 1.0).to_bits()),
+            pan: AtomicU32::new(pan.clamp(-1.0, 1.0).to_bits()),
+            paused: AtomicBool::new(false),
+            stopped: AtomicBool::new(false),
+            finished: AtomicBool::new(frames == 0),
+        })
+    }
+
+    pub fn set_volume(&self, volume: f32) {
+        self.volume.store(volume.clamp(0.0, 1.0).to_bits(), Ordering::Relaxed);
+    }
+
+    pub fn set_pan(&self, pan: f32) {
+        self.pan.store(pan.clamp(-1.0, 1.0).to_bits(), Ordering::Relaxed);
+    }
+
+    pub fn set_paused(&self, paused: bool) {
+        self.paused.store(paused, Ordering::Relaxed);
+    }
+
+    /// Silences the voice at once; the mixer drops it.
+    pub fn stop(&self) {
+        self.stopped.store(true, Ordering::Relaxed);
+    }
+
+    /// Played to its end (a looping voice never is).
+    pub fn is_finished(&self) -> bool {
+        self.finished.load(Ordering::Relaxed)
+    }
+
+    /// Seconds into the sound.
+    pub fn position_secs(&self) -> f64 {
+        f64::from_bits(self.pos.load(Ordering::Relaxed)) / self.rate
+    }
+
+    pub fn duration_secs(&self) -> f64 {
+        self.frames as f64 / self.rate
+    }
+
+    #[inline]
+    fn frame(&self, i: usize) -> (f32, f32) {
+        let base = i * self.channels;
+        let l = self.samples[base];
+        let r = if self.channels > 1 { self.samples[base + 1] } else { l };
+        (l, r)
+    }
+
+    /// Adds this voice into `out` (interleaved stereo) at `out_rate`.
+    fn mix_into(&self, out: &mut [f32], out_rate: f64) {
+        if self.paused.load(Ordering::Relaxed) || self.stopped.load(Ordering::Relaxed) || self.is_finished() {
+            return;
+        }
+        let volume = f32::from_bits(self.volume.load(Ordering::Relaxed));
+        let pan = f32::from_bits(self.pan.load(Ordering::Relaxed));
+        // Web Audio's StereoPannerNode on a stereo source keeps the near side and moves part of
+        // the far side across; for the mix here a linear balance is close enough.
+        let gl = volume * (1.0 - pan.max(0.0));
+        let gr = volume * (1.0 + pan.min(0.0));
+        let step = self.rate / out_rate;
+        let mut pos = f64::from_bits(self.pos.load(Ordering::Relaxed));
+        let frames = self.frames;
+        for o in out.chunks_exact_mut(2) {
+            if pos >= frames as f64 {
+                if self.looping && frames > 0 {
+                    pos %= frames as f64;
+                } else {
+                    self.finished.store(true, Ordering::Relaxed);
+                    break;
+                }
+            }
+            let i = pos as usize;
+            let t = (pos - i as f64) as f32;
+            let (l0, r0) = self.frame(i);
+            let next = if i + 1 < frames { i + 1 } else if self.looping { 0 } else { i };
+            let (l1, r1) = self.frame(next);
+            o[0] += (l0 + (l1 - l0) * t) * gl;
+            o[1] += (r0 + (r1 - r0) * t) * gr;
+            pos += step;
+        }
+        self.pos.store(pos.to_bits(), Ordering::Relaxed);
+    }
+}
+
+static VOICES: Mutex<Vec<Arc<Voice>>> = Mutex::new(Vec::new());
+
+/// Starts mixing `voice`.
+pub fn start(voice: &Arc<Voice>) {
+    if let Ok(mut voices) = VOICES.lock() {
+        voices.push(voice.clone());
+    }
+}
+
+/// Silences every voice (a movie ends, or the host leaves it).
+pub fn stop_all() {
+    if let Ok(mut voices) = VOICES.lock() {
+        for v in voices.iter() {
+            v.stop();
+        }
+        voices.clear();
+    }
+}
+
+/// How many voices are playing.
+pub fn playing() -> usize {
+    VOICES.lock().map(|v| v.len()).unwrap_or(0)
+}
+
+/// Adds every playing voice into `out`, interleaved stereo `f32` at `out_rate` Hz (the caller
+/// zeroes it first, and clamps when converting to integers). Voices that ended or were stopped are
+/// dropped here.
+pub fn mix(out: &mut [f32], out_rate: u32) {
+    let Ok(mut voices) = VOICES.lock() else { return };
+    voices.retain(|v| !v.stopped.load(Ordering::Relaxed) && !v.is_finished());
+    for v in voices.iter() {
+        v.mix_into(out, out_rate as f64);
+    }
+}
+
+type Decoded = (Arc<Vec<f32>>, u32, u16);
+
+/// [`decode_mp3`], remembering the last few results: a game plays the same punch or jingle many
+/// times, and decoding it again each time would cost a frame's worth of CPU for longer sounds.
+pub fn decode_mp3_cached(bytes: &[u8]) -> Option<Decoded> {
+    const KEEP: usize = 64;
+    static CACHE: Mutex<Vec<(u64, usize, Decoded)>> = Mutex::new(Vec::new());
+    // FNV-1a over the bytes: cheap next to decoding them.
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in bytes {
+        h = (h ^ *b as u64).wrapping_mul(0x100000001b3);
+    }
+    if let Ok(cache) = CACHE.lock() {
+        if let Some((_, _, d)) = cache.iter().find(|(k, len, _)| *k == h && *len == bytes.len()) {
+            return Some(d.clone());
+        }
+    }
+    let (samples, rate, channels) = decode_mp3(bytes)?;
+    let decoded: Decoded = (Arc::new(samples), rate, channels);
+    if let Ok(mut cache) = CACHE.lock() {
+        if cache.len() >= KEEP {
+            cache.remove(0);
+        }
+        cache.push((h, bytes.len(), decoded.clone()));
+    }
+    Some(decoded)
+}
+
+/// An MP3 stream (MPEG-1/2 layer III, as Shockwave Audio and MP3 members hold it) to samples:
+/// (interleaved f32, sample rate, channels). `None` if Symphonia finds no stream in it.
+pub fn decode_mp3(bytes: &[u8]) -> Option<(Vec<f32>, u32, u16)> {
+    use symphonia::core::{audio::SampleBuffer, errors::Error, formats::FormatReader, io};
+    use symphonia::default::formats::MpaReader;
+
+    let cursor = std::io::Cursor::new(bytes.to_vec());
+    let source = io::MediaSourceStream::new(Box::new(cursor) as Box<dyn io::MediaSource>, Default::default());
+    let mut reader = MpaReader::try_new(source, &Default::default()).ok()?;
+    let track = reader.default_track()?;
+    let params = track.codec_params.clone();
+    let mut decoder = symphonia::default::get_codecs().make(&params, &Default::default()).ok()?;
+    let mut rate = params.sample_rate.unwrap_or(0);
+    let mut channels = params.channels.map(|c| c.count() as u16).unwrap_or(0);
+    let mut out: Vec<f32> = Vec::new();
+    let mut buf: Option<SampleBuffer<f32>> = None;
+    loop {
+        let packet = match reader.next_packet() {
+            Ok(p) => p,
+            Err(_) => break,
+        };
+        match decoder.decode(&packet) {
+            Ok(decoded) => {
+                let spec = *decoded.spec();
+                rate = spec.rate;
+                channels = spec.channels.count() as u16;
+                let needed = decoded.capacity() as u64;
+                if buf.as_ref().map_or(true, |b| (b.capacity() as u64) < needed * spec.channels.count() as u64) {
+                    buf = Some(SampleBuffer::new(needed, spec));
+                }
+                let b = buf.as_mut().unwrap();
+                b.copy_interleaved_ref(decoded);
+                out.extend_from_slice(b.samples());
+            }
+            Err(Error::DecodeError(_)) => continue,
+            Err(_) => break,
+        }
+    }
+    if out.is_empty() || rate == 0 || channels == 0 {
+        return None;
+    }
+    Some((out, rate, channels))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_voice_plays_to_its_end_and_loops_when_asked() {
+        let once = Voice::new(Arc::new(vec![0.5; 100]), 1, 100, false, 1.0, 0.0);
+        let mut out = vec![0.0f32; 2 * 150];
+        once.mix_into(&mut out, 100.0);
+        assert!(once.is_finished());
+        assert_eq!(out[0], 0.5);
+        assert_eq!(out[2 * 120], 0.0);
+
+        let looping = Voice::new(Arc::new(vec![0.25; 10]), 1, 100, true, 1.0, 0.0);
+        let mut out = vec![0.0f32; 2 * 50];
+        looping.mix_into(&mut out, 100.0);
+        assert!(!looping.is_finished());
+        assert_eq!(out[2 * 45], 0.25);
+    }
+
+    #[test]
+    fn volume_and_pan_reach_the_mix() {
+        let v = Voice::new(Arc::new(vec![1.0; 10]), 1, 100, false, 0.5, 1.0);
+        let mut out = vec![0.0f32; 2 * 4];
+        v.mix_into(&mut out, 100.0);
+        assert_eq!((out[0], out[1]), (0.0, 0.5));
+    }
+}
