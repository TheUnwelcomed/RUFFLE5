 use std::collections::HashMap;
 
+/// PS5_RUFFLE_DIRPLAYER_NATIVE: what drawing sprites costs, for the console's frame log (Ruffle5
+/// prints it every 5 s; dcr-probe on a PC), and the switch for `copy_pixels_with_params`' upright
+/// fast path (which draws the same pixels as its pixel loop). The timings are off the web only (no
+/// clock there).
+pub mod draw_stats {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    /// copyPixels-style blits, their nanoseconds, destination pixels; matte masks built, their
+    /// nanoseconds, source pixels scanned.
+    pub static COPIES: AtomicU64 = AtomicU64::new(0);
+    pub static COPY_NS: AtomicU64 = AtomicU64::new(0);
+    pub static COPY_PIXELS: AtomicU64 = AtomicU64::new(0);
+    pub static MATTES: AtomicU64 = AtomicU64::new(0);
+    pub static MATTE_NS: AtomicU64 = AtomicU64::new(0);
+    pub static MATTE_PIXELS: AtomicU64 = AtomicU64::new(0);
+
+    #[cfg(not(target_arch = "wasm32"))]
+    pub type Mark = std::time::Instant;
+    #[cfg(target_arch = "wasm32")]
+    pub type Mark = ();
+
+    #[inline]
+    pub fn mark() -> Mark {
+        #[cfg(not(target_arch = "wasm32"))]
+        {
+            std::time::Instant::now()
+        }
+    }
+
+    #[inline]
+    pub fn add(counter: &AtomicU64, ns: &AtomicU64, since: Mark) {
+        counter.fetch_add(1, Relaxed);
+        #[cfg(not(target_arch = "wasm32"))]
+        ns.fetch_add(since.elapsed().as_nanos() as u64, Relaxed);
+        #[cfg(target_arch = "wasm32")]
+        let _ = (ns, since);
+    }
+
+    /// Whether `copy_pixels_with_params` may take its upright fast path (on unless dcr-probe
+    /// turns it off, to compare the two pixel for pixel).
+    pub static FAST_PATHS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+    #[inline]
+    pub fn fast_paths() -> bool {
+        FAST_PATHS.load(Relaxed)
+    }
+
+    /// Blits the upright fast path drew (of `COPIES`).
+    pub static FAST_BLITS: AtomicU64 = AtomicU64::new(0);
+
+    /// (blits, ms, megapixels, matte masks, ms, megapixels) since the last call.
+    pub fn take() -> (u64, f64, f64, u64, f64, f64) {
+        (
+            COPIES.swap(0, Relaxed),
+            COPY_NS.swap(0, Relaxed) as f64 / 1e6,
+            COPY_PIXELS.swap(0, Relaxed) as f64 / 1e6,
+            MATTES.swap(0, Relaxed),
+            MATTE_NS.swap(0, Relaxed) as f64 / 1e6,
+            MATTE_PIXELS.swap(0, Relaxed) as f64 / 1e6,
+        )
+    }
+}
