+/// PS5_RUFFLE_DIRPLAYER_NATIVE (1.000.028): the folder web addresses are read from, as an
+/// archive's local web server serves a game's captured files — `http://host/dir/file` is
+/// `<root>/host/dir/file` (Flashpoint's game data has them so, under `content/`). None: a web
+/// address is not read at all (a tracker, an ad server, a high-score page fail as unreachable).
+#[cfg(not(target_arch = "wasm32"))]
+static WEB_ROOT: std::sync::Mutex<Option<std::path::PathBuf>> = std::sync::Mutex::new(None);
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn set_web_root(dir: Option<std::path::PathBuf>) {
+    if let Ok(mut r) = WEB_ROOT.lock() {
+        *r = dir;
+    }
+}
+
+/// The file a web address is under the web root: its host, then its path's parts decoded. The
+/// query is not part of it (a captured file is the same file whatever was asked of it). None
+/// without a web root, or for a part that would leave its folder.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn web_root_path(url: &Url) -> Option<std::path::PathBuf> {
+    let root = WEB_ROOT.lock().ok()?.clone()?;
+    let host = url.host_str()?;
+    if host.is_empty() || host.contains(['/', '\\']) || host.starts_with('.') {
+        return None;
+    }
+    let mut path = root.join(host);
+    for seg in url.path_segments()? {
+        let part = percent_decode_str(seg).decode_utf8().ok()?;
+        if part.is_empty() {
+            continue;
+        }
+        if part == "." || part == ".." || part.contains(['/', '\\', '\0']) {
+            return None;
+        }
+        path.push(part.as_ref());
+    }
+    Some(path)
+}
+
+/// PS5_RUFFLE_DIRPLAYER_NATIVE (1.000.034): what the host gives for a GET that is not on disk —
+/// Ruffle5 fetches a Flashpoint game's file from Flashpoint's server and keeps it, as Flashpoint's
+/// game server does for files a game's data does not hold. Called with the address asked for (a
+/// web address, or a file address in the movie's folder where the movie's own address stands for
+/// it) and the place it was looked for (None: a web address with no web root). The bytes, or None.
+#[cfg(not(target_arch = "wasm32"))]
+pub type Fetcher = Box<dyn Fn(&Url, Option<&std::path::Path>) -> Option<Vec<u8>> + Send>;
+
+#[cfg(not(target_arch = "wasm32"))]
+static FETCHER: std::sync::Mutex<Option<Fetcher>> = std::sync::Mutex::new(None);
+
+/// Sets (or, None, clears) the host's fetcher: see [`Fetcher`].
+#[cfg(not(target_arch = "wasm32"))]
+pub fn set_fetcher(f: Option<Fetcher>) {
+    if let Ok(mut g) = FETCHER.lock() {
+        *g = f;
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn fetch_missing(url: &Url, path: Option<&std::path::Path>) -> Option<Vec<u8>> {
+    let g = FETCHER.lock().ok()?;
+    let f = g.as_ref()?;
+    f(url, path)
+}
+
+/// A request read off disk: a file address as its file; a web address (GET only) as its file
+/// under the web root. A name not there as written is looked for ignoring case, as the Windows
+/// file systems and servers these movies were made on and served from found it. 1.000.034: what
+/// is not there either goes to the host's fetcher (GET only), and a request that fails is named
+/// in the log.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn native_read(url: &Url, is_get: bool) -> NetResult {
+    let path = match url.scheme() {
+        "file" => url.to_file_path().ok(),
+        "http" | "https" if is_get => web_root_path(url),
+        _ => None,
+    };
+    let Some(path) = path else {
+        if is_get && matches!(url.scheme(), "http" | "https") {
+            if let Some(bytes) = fetch_missing(url, None) {
+                return Ok(bytes);
+            }
+        }
+        let why = if !is_get {
+            "a POST, not sent".to_string()
+        } else if matches!(url.scheme(), "http" | "https") {
+            "no folder is set for web addresses, or the address leaves it".to_string()
+        } else {
+            format!("a {}: address", url.scheme())
+        };
+        log::warn!("net: {url}: not read ({why})");
+        return Err(-1);
+    };
+    match std::fs::read(&path) {
+        Ok(bytes) => Ok(bytes),
+        Err(_) => match find_ignoring_case(&path) {
+            Some(found) if found.is_file() => {
+                log::info!("{} read as {}", path.display(), found.display());
+                std::fs::read(found).map_err(|_| -1)
+            }
+            _ => {
+                if is_get {
+                    if let Some(bytes) = fetch_missing(url, Some(&path)) {
+                        return Ok(bytes);
+                    }
+                }
+                log::warn!("net: {url}: not found ({})", path.display());
+                Err(-1)
+            }
+        },
+    }
+}
+
+/// PS5_RUFFLE_DIRPLAYER_NATIVE: `path` as a case-blind file system finds it: from the deepest
+/// part that is there as written, each further part matched ignoring case in its folder.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn find_ignoring_case(path: &std::path::Path) -> Option<std::path::PathBuf> {
+    use std::path::{Component, PathBuf};
+    if path.exists() {
+        return Some(path.to_path_buf());
+    }
+    let mut cur = PathBuf::new();
+    for comp in path.components() {
+        match comp {
+            Component::Normal(name) => {
+                let exact = cur.join(name);
+                if exact.exists() {
+                    cur = exact;
+                    continue;
+                }
+                let want = name.to_string_lossy().to_lowercase();
+                let dir = if cur.as_os_str().is_empty() { PathBuf::from(".") } else { cur.clone() };
+                let found = std::fs::read_dir(&dir).ok()?.filter_map(|e| e.ok()).find(|e| e.file_name().to_string_lossy().to_lowercase() == want)?;
+                cur = cur.join(found.file_name());
+            }
+            other => cur.push(other.as_os_str()),
+        }
+    }
+    cur.exists().then_some(cur)
+}
