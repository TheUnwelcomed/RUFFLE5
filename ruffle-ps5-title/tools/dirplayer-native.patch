+    pub fn clear_color(&self, r: f32, g: f32, b: f32, a: f32) {
+        tr!(self, "clearColor", J::F(r), J::F(g), J::F(b), J::F(a));
+        self.st.borrow_mut().clear_color = [r, g, b, a];
+    }
+    pub fn clear_depth(&self, d: f32) {
+        tr!(self, "clearDepth", J::F(d));
+        self.st.borrow_mut().clear_depth = d.clamp(0.0, 1.0);
+    }
+    pub fn clear(&self, mask: u32) {
+        tr!(self, "clear", J::U(mask));
+        self.st.borrow_mut().clear(mask);
+    }
+    pub fn depth_func(&self, f: u32) {
+        tr!(self, "depthFunc", J::U(f));
+        self.st.borrow_mut().depth_func = f;
+    }
+    pub fn depth_mask(&self, on: bool) {
+        tr!(self, "depthMask", J::B(on));
+        self.st.borrow_mut().depth_mask = on;
+    }
+    pub fn color_mask(&self, r: bool, g: bool, b: bool, a: bool) {
+        tr!(self, "colorMask", J::B(r), J::B(g), J::B(b), J::B(a));
+        self.st.borrow_mut().color_mask = [r, g, b, a];
+    }
+    pub fn cull_face(&self, mode: u32) {
+        tr!(self, "cullFace", J::U(mode));
+        self.st.borrow_mut().cull_mode = mode;
+    }
+    pub fn front_face(&self, mode: u32) {
+        tr!(self, "frontFace", J::U(mode));
+        self.st.borrow_mut().front_face = mode;
+    }
+    pub fn polygon_offset(&self, factor: f32, units: f32) {
+        tr!(self, "polygonOffset", J::F(factor), J::F(units));
+        self.st.borrow_mut().polygon_offset = [factor, units];
+    }
+    pub fn blend_func(&self, src: u32, dst: u32) {
+        tr!(self, "blendFunc", J::U(src), J::U(dst));
+        self.st.borrow_mut().blend_func = [src, dst, src, dst];
+    }
+    pub fn blend_func_separate(&self, src_rgb: u32, dst_rgb: u32, src_a: u32, dst_a: u32) {
+        tr!(self, "blendFuncSeparate", J::U(src_rgb), J::U(dst_rgb), J::U(src_a), J::U(dst_a));
+        self.st.borrow_mut().blend_func = [src_rgb, dst_rgb, src_a, dst_a];
+    }
+    pub fn blend_equation(&self, eq: u32) {
+        tr!(self, "blendEquation", J::U(eq));
+        self.st.borrow_mut().blend_equation = [eq, eq];
+    }
+    pub fn blend_equation_separate(&self, rgb: u32, a: u32) {
+        tr!(self, "blendEquationSeparate", J::U(rgb), J::U(a));
+        self.st.borrow_mut().blend_equation = [rgb, a];
+    }
+
+    // ---- drawing ----
+    pub fn draw_arrays(&self, mode: u32, first: i32, count: i32) {
+        tr!(self, "drawArrays", J::U(mode), J::I(first), J::I(count));
+        self.st.borrow_mut().draw(mode, first.max(0) as usize, count.max(0) as usize, None);
+    }
+    pub fn draw_elements_with_i32(&self, mode: u32, count: i32, kind: u32, offset: i32) {
+        tr!(self, "drawElements", J::U(mode), J::I(count), J::U(kind), J::I(offset));
+        self.st.borrow_mut().draw(mode, 0, count.max(0) as usize, Some((kind, offset.max(0) as usize)));
+    }
+    pub fn flush(&self) {}
+    pub fn finish(&self) {}
+
+    // ---- not WebGL: for the native compositor ----
+    /// The colour of level 0 of `t`, rows bottom-up as GL keeps them, and its size.
+    pub fn soft_texture_pixels(&self, t: &WebGlTexture) -> Option<(u32, u32, std::sync::Arc<Vec<u8>>)> {
+        self.st.borrow_mut().texture_pixels(t.0)
+    }
+    /// What the software rasteriser drew since the last call: (triangles, pixels shaded).
+    pub fn soft_take_stats(&self) -> (u64, u64) {
+        self.st.borrow_mut().take_stats()
+    }
+    /// The programs linked that are not the ones ported (their first lines), once each.
+    pub fn soft_unknown_programs(&self) -> Vec<String> {
+        self.st.borrow_mut().take_unknown_programs()
+    }
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/mod.rs b/vm-rust/src/rendering_gpu/softgl/mod.rs
new file mode 100644
index 00000000..d949e31a
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/mod.rs
@@ -0,0 +1,399 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: Shockwave 3D off the web. DirPlayer draws 3D only with WebGL2
+//! (`webgl2/scene3d.rs`); here the same renderer — the same three files, compiled a second time
+//! against `gl.rs` instead of web_sys — draws into a software WebGL2 context, and the CPU
+//! compositor (`rendering.rs`) puts the result on the stage the way the WebGL compositor does
+//! (`webgl2/mod.rs` `render_sprite`: the per-frame 3D steps, one pass per sprite camera,
+//! overlays, the sprite's ink and blend, directToStage sprites last).
+
+pub mod gl;
+mod pool;
+mod programs;
+mod raster;
+mod state;
+mod texture;
+mod trace;
+pub mod replay;
+
+#[path = "../webgl2/context.rs"]
+pub mod context;
+#[path = "../webgl2/mesh3d.rs"]
+pub mod mesh3d;
+#[path = "../webgl2/scene3d.rs"]
+pub mod scene3d;
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use crate::director::chunks::w3d::types::W3dNodeType;
+use crate::player::cast_lib::CastMemberRef;
+use crate::player::cast_member::{CastMemberType, Shockwave3dRuntimeState};
+use crate::player::symbols::symbol::Symbol;
+use crate::player::DirPlayer;
+
+struct Soft3d {
+    gl: gl::WebGl2RenderingContext,
+    context: context::WebGL2Context,
+    renderer: scene3d::Scene3dRenderer,
+    frames: u64,
+    triangles: u64,
+    fragments: u64,
+}
+
+thread_local! {
+    static SOFT3D: RefCell<Option<Soft3d>> = const { RefCell::new(None) };
+}
+
+/// DIRPLAYER_SOFTGL_PICK: the fragments written at the picked pixel since the last call.
+pub fn take_pick() -> Vec<String> {
+    raster::pick_take()
+}
+
+fn with_soft3d<R>(f: impl FnOnce(&mut Soft3d) -> R) -> R {
+    static DEBUG_ENV: std::sync::Once = std::sync::Once::new();
+    DEBUG_ENV.call_once(|| {
+        raster::pick_init();
+        raster::depth_bits_init();
+    });
+    SOFT3D.with(|cell| {
+        let mut slot = cell.borrow_mut();
+        if slot.is_none() {
+            let gl = gl::WebGl2RenderingContext::new_soft_traced(1, 1);
+            let context = context::WebGL2Context::new(gl.clone()).expect("software WebGL2 context");
+            *slot = Some(Soft3d { gl, context, renderer: scene3d::Scene3dRenderer::new(), frames: 0, triangles: 0, fragments: 0 });
+        }
+        f(slot.as_mut().unwrap())
+    })
+}
+
+/// Time spent setting up draws (vertex shading, clipping, triangle setup) and writing their
+/// pixels, and in whole 3D sprite frames (nanoseconds, since the last `take_times`).
+pub(crate) static TIME_SETUP_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) static TIME_EXEC_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static TIME_FRAME_NS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// (setup, pixels, whole 3D frames) in milliseconds since the last call.
+pub fn take_times() -> (f64, f64, f64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let ms = |a: &std::sync::atomic::AtomicU64| a.swap(0, Relaxed) as f64 / 1e6;
+    (ms(&TIME_SETUP_NS), ms(&TIME_EXEC_NS), ms(&TIME_FRAME_NS))
+}
+
+/// How many threads (with the one drawing) write the 3D pixels; before the first 3D frame.
+pub fn set_threads(n: usize) {
+    pool::set_threads(n);
+}
+
+/// How many threads write the 3D pixels (starts the workers if they are not running yet).
+pub fn threads() -> usize {
+    pool::get().threads()
+}
+
+/// Forget every member's geometry and textures (a new movie).
+pub fn reset() {
+    SOFT3D.with(|cell| *cell.borrow_mut() = None);
+}
+
+/// Samples of incomplete textures since the last call (GL draws them black).
+pub fn take_incomplete_samples() -> u64 {
+    texture::INCOMPLETE_SAMPLES.swap(0, std::sync::atomic::Ordering::Relaxed)
+}
+
+/// (3D sprite frames drawn, triangles, fragments) since the last call.
+pub fn take_stats() -> (u64, u64, u64) {
+    SOFT3D.with(|cell| {
+        let mut slot = cell.borrow_mut();
+        match slot.as_mut() {
+            Some(s) => {
+                let r = (s.frames, s.triangles, s.fragments);
+                s.frames = 0;
+                s.triangles = 0;
+                s.fragments = 0;
+                r
+            }
+            None => (0, 0, 0),
+        }
+    })
+}
+
+/// The per-frame steps webgl2/mod.rs `render_sprite` takes for a sprite before drawing it, which
+/// the movie can see: a 1x1 placeholder texture filled from the cast bitmap of the same name, the
+/// next queued motion when a non-looping one has ended, and `animationEnabled` auto-play.
+fn prepare(player: &mut DirPlayer, member_ref: &CastMemberRef, motion_ended: &mut bool) {
+    // Placeholder textures (IFX stores 1x1 white placeholders for textures that come from cast
+    // members).
+    let placeholder_names: Vec<Symbol> = player
+        .movie
+        .cast_manager
+        .find_member_by_ref(member_ref)
+        .and_then(|m| m.member_type.as_shockwave3d())
+        .and_then(|w3d| w3d.parsed_scene.as_ref())
+        .map(|scene| {
+            scene
+                .texture_images
+                .iter()
+                .filter(|(_, data)| data.len() == 12 && data[..8] == [1, 0, 0, 0, 1, 0, 0, 0])
+                .map(|(name, _)| *name)
+                .collect()
+        })
+        .unwrap_or_default();
+    if !placeholder_names.is_empty() {
+        let mut resolved: Vec<(Symbol, Vec<u8>)> = Vec::new();
+        let palettes = player.movie.cast_manager.palettes();
+        for tex_name in &placeholder_names {
+            let Some(src_ref) = player.movie.cast_manager.find_member_ref_by_name(&tex_name.to_string()) else { continue };
+            let Some(src_member) = player.movie.cast_manager.find_member_by_ref(&src_ref) else { continue };
+            let CastMemberType::Bitmap(bmp_member) = &src_member.member_type else { continue };
+            let Some(bmp) = player.bitmap_manager.get_bitmap(bmp_member.image_ref) else { continue };
+            if bmp.width > 1 || bmp.height > 1 {
+                let (w, h) = (bmp.width as usize, bmp.height as usize);
+                let mut tex_data = Vec::with_capacity(8 + w * h * 4);
+                tex_data.extend_from_slice(&(w as u32).to_le_bytes());
+                tex_data.extend_from_slice(&(h as u32).to_le_bytes());
+                for y in 0..h {
+                    for x in 0..w {
+                        let (r, g, b, a) = bmp.get_pixel_color_with_alpha(&palettes, x as u16, y as u16);
+                        tex_data.extend_from_slice(&[r, g, b, a]);
+                    }
+                }
+                resolved.push((*tex_name, tex_data));
+            }
+        }
+        if !resolved.is_empty() {
+            if let Some(scene) = player
+                .movie
+                .cast_manager
+                .find_mut_member_by_ref(member_ref)
+                .and_then(|m| m.member_type.as_shockwave3d_mut())
+                .and_then(|w3d| w3d.scene_mut())
+            {
+                for (name, data) in resolved {
+                    scene.put_texture_image(name, data);
+                }
+            }
+        }
+    }
+
+    let Some(w3d) = player.movie.cast_manager.find_mut_member_by_ref(member_ref).and_then(|m| m.member_type.as_shockwave3d_mut()) else {
+        return;
+    };
+    // Auto-advance: a non-looping motion ended, play the next queued one.
+    if *motion_ended && !w3d.runtime_state.motion_queue.is_empty() {
+        let next = w3d.runtime_state.motion_queue.remove(0);
+        w3d.runtime_state.current_motion = Some(next.name);
+        w3d.runtime_state.animation_loop = next.looped;
+        w3d.runtime_state.animation_start_time = next.start_time;
+        w3d.runtime_state.animation_end_time = next.end_time;
+        w3d.runtime_state.animation_scale = next.scale;
+        w3d.runtime_state.animation_time = if next.offset >= 0.0 { next.offset } else { next.start_time };
+        w3d.runtime_state.animation_playing = true;
+        w3d.runtime_state.motion_ended = false;
+        *motion_ended = false;
+    }
+    // animationEnabled: the member's first motion plays when its sprite first appears.
+    if w3d.info.animation_enabled {
+        let first_motion = w3d.parsed_scene.as_ref().and_then(|s| s.motions.first()).map(|m| m.name);
+        let loops = w3d.info.loops;
+        if let Some(motion_name) = first_motion {
+            let skinned: Vec<String> = w3d
+                .parsed_scene
+                .as_ref()
+                .map(|s| {
+                    s.nodes
+                        .iter()
+                        .filter(|n| n.node_type == W3dNodeType::Model)
+                        .filter(|n| {
+                            let key = if !n.model_resource_name.as_str().is_empty() { n.model_resource_name } else { n.resource_name };
+                            s.skeletons.iter().any(|sk| sk.name == key && sk.bones.len() > 1)
+                        })
+                        .map(|n| n.name.to_string())
+                        .collect()
+                })
+                .unwrap_or_default();
+            let any_skinned = !skinned.is_empty();
+            let unambiguous = skinned.len() == 1 || w3d.parsed_scene.as_ref().map(|s| s.motions.len() == 1).unwrap_or(false);
+            if unambiguous {
+                for model in &skinned {
+                    let bp = w3d.runtime_state.bones_player_mut(Symbol::from_str(model));
+                    if bp.current_motion.is_none() && !bp.animation_playing {
+                        bp.current_motion = Some(Symbol::from_str(&motion_name.to_string()));
+                        bp.animation_playing = true;
+                        bp.animation_loop = loops;
+                    }
+                }
+            }
+            let seeded_any = w3d.runtime_state.auto_play_seeded;
+            if !any_skinned && !seeded_any && !w3d.runtime_state.animation_playing && w3d.runtime_state.current_motion.is_none() {
+                w3d.runtime_state.current_motion = Some(motion_name);
+                w3d.runtime_state.animation_playing = true;
+                w3d.runtime_state.animation_loop = loops;
+            }
+        }
+    }
+}
+
+struct Pass {
+    member_key: (i32, i32),
+    scene: Rc<crate::director::chunks::w3d::types::W3dScene>,
+    runtime_state: Rc<Shockwave3dRuntimeState>,
+    camera: Option<Symbol>,
+}
+
+/// What a 3D sprite shows, as webgl2/mod.rs draws it into its FBO: `width` x `height` RGBA, top
+/// row first. `channel` is the sprite's channel on the stage score; `ink` its ink (36 clears to
+/// transparent). None when the member has no scene.
+pub fn render_sprite(
+    player: &mut DirPlayer,
+    channel: i16,
+    member_ref: &CastMemberRef,
+    width: u32,
+    height: u32,
+    ink: i32,
+) -> Option<(u32, u32, std::sync::Arc<Vec<u8>>)> {
+    let (sprite_w, sprite_h, cam, extra_cams) = {
+        let sprite = player.movie.score.get_sprite(channel)?;
+        (sprite.width, sprite.height, sprite.w3d_camera.clone(), sprite.w3d_cameras.clone())
+    };
+    let frame_t0 = std::time::Instant::now();
+    let mut motion_ended = with_soft3d(|s| s.renderer.motion_ended);
+    prepare(player, member_ref, &mut motion_ended);
+    with_soft3d(|s| s.renderer.motion_ended = motion_ended);
+
+    // One pass per camera in the sprite's camera list, each against the member that owns it.
+    let own_key = (member_ref.cast_lib, member_ref.cast_member);
+    let member = player.movie.cast_manager.find_member_by_ref(member_ref)?;
+    let w3d = member.member_type.as_shockwave3d()?;
+    let parsed_scene = w3d.parsed_scene.clone()?;
+    let own_state = Rc::new(w3d.runtime_state.clone());
+    let mut cam_list: Vec<crate::player::sprite::SpriteCamera> = cam.iter().cloned().collect();
+    cam_list.extend(extra_cams.iter().cloned());
+    let mut passes: Vec<Pass> = Vec::new();
+    let mut state_cache: Vec<((i32, i32), Rc<Shockwave3dRuntimeState>)> = vec![(own_key, own_state.clone())];
+    for c in &cam_list {
+        let key = c.member.unwrap_or(own_key);
+        let resolved = if key == own_key {
+            Some((parsed_scene.clone(), own_state.clone()))
+        } else {
+            let other = CastMemberRef { cast_lib: key.0, cast_member: key.1 };
+            player.movie.cast_manager.find_member_by_ref(&other).and_then(|m| m.member_type.as_shockwave3d()).and_then(|o| {
+                let st = match state_cache.iter().find(|(k, _)| *k == key) {
+                    Some((_, s)) => s.clone(),
+                    None => {
+                        let s = Rc::new(o.runtime_state.clone());
+                        state_cache.push((key, s.clone()));
+                        s
+                    }
+                };
+                o.parsed_scene.clone().map(|sc| (sc, st))
+            })
+        };
+        let Some((scene, state)) = resolved else { continue };
+        let exists = scene.nodes.iter().any(|n| n.node_type == W3dNodeType::View && n.name.eq_ignore_ascii_case(&c.name));
+        if !exists {
+            continue;
+        }
+        passes.push(Pass { member_key: key, scene, runtime_state: state, camera: Some(Symbol::from_str(&c.name)) });
+    }
+    if passes.is_empty() {
+        passes.push(Pass {
+            member_key: own_key,
+            scene: parsed_scene.clone(),
+            runtime_state: own_state.clone(),
+            camera: cam.as_ref().map(|c| Symbol::from_str(&c.name)),
+        });
+    }
+
+    let out = with_soft3d(|s| {
+        trace::frame_begin();
+        s.renderer.transparent_clear = ink == 36;
+        // The FBO is the sprite at movie size: backdrops and overlays need no rescaling.
+        s.renderer.stage_scale = 1.0;
+        for (i, pass) in passes.iter().enumerate() {
+            let clear = if i == 0 {
+                true
+            } else {
+                pass.camera.as_ref().and_then(|c| pass.runtime_state.camera_clear_at_render.get(c).copied()).unwrap_or(true)
+            };
+            s.renderer.pass_viewport = if i == 0 {
+                None
+            } else {
+                pass.camera
+                    .as_ref()
+                    .and_then(|c| pass.runtime_state.camera_rects.get(c).copied())
+                    .filter(|(l, t, r, b)| r > l && b > t && (*l > 0 || *t > 0))
+                    .map(|(l, t, r, b)| {
+                        let sx = if sprite_w > 0 { width as f32 / sprite_w as f32 } else { 1.0 };
+                        let sy = if sprite_h > 0 { height as f32 / sprite_h as f32 } else { 1.0 };
+                        ((l as f32 * sx).round() as i32, (t as f32 * sy).round() as i32, (r as f32 * sx).round() as i32, (b as f32 * sy).round() as i32)
+                    })
+            };
+            s.renderer.active_camera = pass.camera;
+            if let Err(e) = s.renderer.render_scene_with_state_ex(&s.context, pass.member_key, &pass.scene, width, height, Some(&pass.runtime_state), clear) {
+                log::warn!("[3D] render failed for member {:?} camera {:?}: {:?}", pass.member_key, pass.camera, e);
+                continue;
+            }
+        }
+        {
+            let g = s.context.gl();
+            g.disable(gl::WebGl2RenderingContext::SCISSOR_TEST);
+            g.viewport(0, 0, width as i32, height as i32);
+        }
+        for pass in &passes {
+            for overlays in pass.runtime_state.camera_overlays.values() {
+                if !overlays.is_empty() {
+                    s.renderer.render_overlays_to_fbo(&s.context, &pass.member_key, overlays, width, height);
+                }
+            }
+        }
+        for note in s.gl.soft_unknown_programs() {
+            log::warn!("{note}");
+        }
+        let (tris, frags) = s.gl.soft_take_stats();
+        s.frames += 1;
+        s.triangles += tris;
+        s.fragments += frags;
+        let tex = s.renderer.fbo_texture.clone()?;
+        let px = s.gl.soft_texture_pixels(&tex);
+        if let Some((tw, th, p)) = &px {
+            trace::frame_end(tex.0, *tw, *th, p);
+        }
+        px
+    });
+    player.w3d_rendered_this_frame = true;
+    TIME_FRAME_NS.fetch_add(frame_t0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    let (w, h, pixels) = out?;
+
+    // world.image, once a script has asked for it: this frame's picture.
+    if player.w3d_image_requested.contains(&own_key) {
+        use crate::player::bitmap::bitmap::{get_system_default_palette, Bitmap, PaletteRef};
+        let mut bitmap = Bitmap::new(w as u16, h as u16, 32, 32, 8, PaletteRef::BuiltIn(get_system_default_palette()));
+        bitmap.data = pixels.as_ref().clone();
+        bitmap.use_alpha = true;
+        if let Some(&existing) = player.w3d_frame_buffers.get(&own_key) {
+            player.bitmap_manager.replace_bitmap(existing, bitmap);
+        } else {
+            let r = player.bitmap_manager.add_bitmap(bitmap);
+            player.w3d_frame_buffers.insert(own_key, r);
+        }
+    }
+    Some((w, h, pixels))
+}
+
+/// shockwave3d.rs `render_3d_to_rgba` off the web: the scene through its default camera into a
+/// context of its own, `width` x `height` RGBA, top row first.
+pub fn render_offscreen(
+    scene: &crate::director::chunks::w3d::types::W3dScene,
+    runtime_state: &Shockwave3dRuntimeState,
+    width: u32,
+    height: u32,
+) -> Option<Vec<u8>> {
+    let g = gl::WebGl2RenderingContext::new_soft(width.max(1), height.max(1));
+    let context = context::WebGL2Context::new(g.clone()).ok()?;
+    let mut renderer = scene3d::Scene3dRenderer::new();
+    if let Err(e) = renderer.render_to_default_framebuffer(&context, (0, 0), scene, width.max(1), height.max(1), Some(runtime_state)) {
+        log::warn!("[W3D] render_3d_to_rgba failed: {e:?}");
+        return None;
+    }
+    let mut pixels = vec![0u8; (width * height * 4) as usize];
+    let _ = g.read_pixels_with_opt_u8_array(0, 0, width as i32, height as i32, gl::WebGl2RenderingContext::RGBA, gl::WebGl2RenderingContext::UNSIGNED_BYTE, Some(&mut pixels));
+    Some(pixels)
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/pool.rs b/vm-rust/src/rendering_gpu/softgl/pool.rs
new file mode 100644
index 00000000..3b07843f
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/pool.rs
@@ -0,0 +1,145 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: a fixed set of worker threads for the rasteriser. `run(n, f)`
+//! calls f(0) .. f(n-1) across the workers and the calling thread, and returns when every call
+//! has returned — so `f` may borrow from the caller's stack. One job at a time (the 3D renderer
+//! draws from one thread).
+
+use std::sync::{Arc, Condvar, Mutex, OnceLock};
+
+type JobFn = dyn Fn(usize) + Sync;
+
+struct Job {
+    /// The caller's closure, its lifetime erased: `run` does not return before the last call
+    /// through this pointer has returned.
+    f: *const JobFn,
+    n: usize,
+    next: usize,
+    left: usize,
+}
+
+// The pointer is only dereferenced while `run` keeps the closure alive (see Job::f).
+unsafe impl Send for Job {}
+
+struct Shared {
+    job: Mutex<Option<Job>>,
+    work: Condvar,
+    done: Condvar,
+}
+
+pub struct Pool {
+    shared: Arc<Shared>,
+    workers: usize,
+}
+
+/// Total threads to use (the caller and the workers), set before the pool is first used.
+static WANT: Mutex<Option<usize>> = Mutex::new(None);
+static POOL: OnceLock<Pool> = OnceLock::new();
+
+/// How many threads (including the drawing thread) rasterise; takes effect if called before the
+/// first draw. Default: DIRPLAYER_SOFTGL_THREADS, else the machine's parallelism, at most 8.
+pub fn set_threads(n: usize) {
+    if let Ok(mut w) = WANT.lock() {
+        *w = Some(n.clamp(1, 16));
+    }
+}
+
+pub fn get() -> &'static Pool {
+    POOL.get_or_init(|| {
+        let total = WANT
+            .lock()
+            .ok()
+            .and_then(|w| *w)
+            .or_else(|| std::env::var("DIRPLAYER_SOFTGL_THREADS").ok().and_then(|v| v.parse::<usize>().ok()))
+            .unwrap_or_else(|| std::thread::available_parallelism().map(|n| n.get()).unwrap_or(1).min(8))
+            .clamp(1, 16);
+        Pool::new(total - 1)
+    })
+}
+
+impl Pool {
+    fn new(workers: usize) -> Pool {
+        let shared = Arc::new(Shared { job: Mutex::new(None), work: Condvar::new(), done: Condvar::new() });
+        let mut started = 0;
+        for i in 0..workers {
+            let s = shared.clone();
+            let ok = std::thread::Builder::new().name(format!("softgl-{i}")).spawn(move || worker(s)).is_ok();
+            if ok {
+                started += 1;
+            }
+        }
+        Pool { shared, workers: started }
+    }
+
+    /// Threads that take part in a job: the workers and the caller.
+    pub fn threads(&self) -> usize {
+        self.workers + 1
+    }
+
+    pub fn run(&self, n: usize, f: &(dyn Fn(usize) + Sync)) {
+        if self.workers == 0 || n <= 1 {
+            for i in 0..n {
+                f(i);
+            }
+            return;
+        }
+        // SAFETY: only the lifetime is changed; this function does not return before `left`
+        // reaches 0, i.e. before the last call through the pointer has returned.
+        let fp: *const JobFn = unsafe { std::mem::transmute::<*const (dyn Fn(usize) + Sync + '_), *const JobFn>(f) };
+        {
+            let mut job = self.shared.job.lock().unwrap_or_else(|e| e.into_inner());
+            *job = Some(Job { f: fp, n, next: 0, left: n });
+        }
+        self.shared.work.notify_all();
+        loop {
+            let i = {
+                let mut job = self.shared.job.lock().unwrap_or_else(|e| e.into_inner());
+                match job.as_mut() {
+                    Some(j) if j.next < j.n => {
+                        j.next += 1;
+                        j.next - 1
+                    }
+                    _ => break,
+                }
+            };
+            f(i);
+            finish_one(&self.shared);
+        }
+        let mut job = self.shared.job.lock().unwrap_or_else(|e| e.into_inner());
+        while job.as_ref().is_some_and(|j| j.left > 0) {
+            job = self.shared.done.wait(job).unwrap_or_else(|e| e.into_inner());
+        }
+        *job = None;
+    }
+}
+
+fn finish_one(shared: &Shared) {
+    let mut job = shared.job.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(j) = job.as_mut() {
+        j.left -= 1;
+        if j.left == 0 {
+            shared.done.notify_all();
+        }
+    }
+}
+
+fn worker(shared: Arc<Shared>) {
+    loop {
+        let (f, i) = {
+            let mut job = shared.job.lock().unwrap_or_else(|e| e.into_inner());
+            loop {
+                if let Some(j) = job.as_mut() {
+                    if j.next < j.n {
+                        j.next += 1;
+                        break (j.f, j.next - 1);
+                    }
+                }
+                job = shared.work.wait(job).unwrap_or_else(|e| e.into_inner());
+            }
+        };
+        // SAFETY: see Job::f — the job is not finished (its `left` counts this call).
+        let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| unsafe { (*f)(i) }));
+        finish_one(&shared);
+        if r.is_err() {
+            log::warn!("softgl worker: a band panicked");
+        }
+    }
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/programs.rs b/vm-rust/src/rendering_gpu/softgl/programs.rs
new file mode 100644
index 00000000..fa7731e8
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/programs.rs
@@ -0,0 +1,931 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the GLSL programs of `webgl2/scene3d.rs`, ported to Rust: the
+//! 3D model shader, the particle billboard shader, the post-process (bloom / colour) shader and
+//! the #inker outline shader. A linked program is recognised by what its source declares.
+//!
+//! One deliberate difference, in the 3D model shader: its lighting (the IFX fixed-function
+//! equation — emissive, ambient, per-light diffuse with attenuation and spot cone, Blinn
+//! specular on untextured surfaces, toon steps) and its fog factor and sphere-map coordinates
+//! are evaluated per VERTEX and interpolated, as IFX's own OpenGL / Direct3D fixed-function
+//! renderer does; the GLSL evaluates the same expressions per fragment. Texturing, the
+//! lightmap / second layer, the reflection layer, fog blending, alpha test and opacity are
+//! per fragment as in the GLSL.
+
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use super::raster::{Frag, Program, VOut, MAXV, NATTR};
+use super::texture::SamplerTex;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ProgramKind {
+    Main3d,
+    Particle,
+    PostProcess,
+    Outline,
+}
+
+pub enum BuiltProgram {
+    Main(Main3d),
+    Particle(ParticleProg),
+    Post(PostProg),
+    Outline(OutlineProg),
+}
+
+/// FNV-1a 64 of a program's vertex + fragment source.
+fn fingerprint(vs: &str, fs: &str) -> u64 {
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in vs.bytes().chain(fs.bytes()) {
+        h ^= b as u64;
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    h
+}
+
+/// The sources the ports follow (DirPlayer cham/w3d-fullscreen b9b94666, scene3d.rs: the raw
+/// strings each program compiles; Main3d's checked against the sources a game's trace recorded).
+const PORTED: [(ProgramKind, u64); 4] = [
+    (ProgramKind::Main3d, 0xc5ed_be35_1301_5693),
+    (ProgramKind::Particle, 0x85f0_5dd3_3bff_cda3),
+    (ProgramKind::PostProcess, 0x06d7_d8ff_395e_60fc),
+    (ProgramKind::Outline, 0xe6c1_3110_fd4a_4f43),
+];
+
+/// Which ported program a linked vertex + fragment source is, and a note when its source is not
+/// the one the port follows (it is still drawn by the port).
+pub fn recognise(vs: &str, fs: &str) -> (Option<ProgramKind>, Option<String>) {
+    let kind = if vs.contains("u_bone_matrices") && fs.contains("u_has_lightmap") {
+        Some(ProgramKind::Main3d)
+    } else if vs.contains("a_center") && vs.contains("u_camera_right") {
+        Some(ProgramKind::Particle)
+    } else if vs.contains("in vec2 a_pos") && fs.contains("u_mode") {
+        Some(ProgramKind::PostProcess)
+    } else if vs.contains("u_outline_width") {
+        Some(ProgramKind::Outline)
+    } else {
+        None
+    };
+    let fp = fingerprint(vs, fs);
+    let note = match kind {
+        None => Some(format!(
+            "softgl: a program with no software port was linked (fnv {fp:016x}): {}",
+            vs.lines().find(|l| l.contains(" in ")).unwrap_or("").trim()
+        )),
+        Some(k) => {
+            let want = PORTED.iter().find(|(pk, _)| *pk == k).map(|(_, h)| *h).unwrap_or(0);
+            if want != 0 && want != fp {
+                Some(format!("softgl: the {k:?} program's GLSL is not the source its port follows (fnv {fp:016x}, ported {want:016x})"))
+            } else {
+                None
+            }
+        }
+    };
+    (kind, note)
+}
+
+/// Floats per array element, for `uniform*(location of name[i], ...)`.
+pub fn element_size(name: &str) -> usize {
+    match name {
+        "u_bone_matrices" => 16,
+        "u_light_pos" | "u_light_color" | "u_light_atten" | "u_light_dir" => 3,
+        _ => 1,
+    }
+}
+
+struct U<'a>(&'a HashMap<Rc<str>, Vec<f32>>);
+
+/// A uniform's values (one map lookup per uniform, however many elements are read), 0 where unset.
+struct Vals<'a>(&'a [f32]);
+
+impl Vals<'_> {
+    #[inline]
+    fn at(&self, i: usize) -> f32 {
+        self.0.get(i).copied().unwrap_or(0.0)
+    }
+    fn v3_at(&self, el: usize) -> [f32; 3] {
+        [self.at(el * 3), self.at(el * 3 + 1), self.at(el * 3 + 2)]
+    }
+}
+
+impl U<'_> {
+    fn vals(&self, name: &str) -> Vals<'_> {
+        Vals(self.0.get(name).map(|v| v.as_slice()).unwrap_or(&[]))
+    }
+    fn get(&self, name: &str, i: usize) -> f32 {
+        self.vals(name).at(i)
+    }
+    fn f(&self, name: &str) -> f32 {
+        self.get(name, 0)
+    }
+    fn i(&self, name: &str) -> i32 {
+        self.get(name, 0) as i32
+    }
+    fn v2(&self, name: &str) -> [f32; 2] {
+        let v = self.vals(name);
+        [v.at(0), v.at(1)]
+    }
+    fn v3(&self, name: &str) -> [f32; 3] {
+        self.vals(name).v3_at(0)
+    }
+    fn v4(&self, name: &str) -> [f32; 4] {
+        let v = self.vals(name);
+        [v.at(0), v.at(1), v.at(2), v.at(3)]
+    }
+    fn m4(&self, name: &str) -> [f32; 16] {
+        let v = self.vals(name);
+        let mut m = [0.0; 16];
+        for (k, e) in m.iter_mut().enumerate() {
+            *e = v.at(k);
+        }
+        m
+    }
+}
+
+fn sampler(samplers: &[Option<SamplerTex>], unit: i32) -> Option<SamplerTex> {
+    samplers.get(unit.max(0) as usize).cloned().flatten()
+}
+
+pub fn build(kind: ProgramKind, uniforms: &HashMap<Rc<str>, Vec<f32>>, samplers: Vec<Option<SamplerTex>>) -> Option<BuiltProgram> {
+    let u = U(uniforms);
+    Some(match kind {
+        ProgramKind::Main3d => BuiltProgram::Main(Main3d::new(&u, &samplers)),
+        ProgramKind::Particle => BuiltProgram::Particle(ParticleProg {
+            view_projection: u.m4("u_view_projection"),
+            camera_right: u.v3("u_camera_right"),
+            camera_up: u.v3("u_camera_up"),
+            size_start: u.f("u_size_start"),
+            size_end: u.f("u_size_end"),
+            lifetime: u.f("u_lifetime"),
+            color_start: u.v3("u_color_start"),
+            color_end: u.v3("u_color_end"),
+            blend_start: u.f("u_blend_start"),
+            blend_end: u.f("u_blend_end"),
+            has_tex: u.i("u_has_tex"),
+            tex: sampler(&samplers, u.i("u_tex")),
+        }),
+        ProgramKind::PostProcess => BuiltProgram::Post(PostProg {
+            input: sampler(&samplers, u.i("u_input")),
+            resolution: u.v2("u_resolution"),
+            direction: u.v2("u_direction"),
+            threshold: u.f("u_threshold"),
+            intensity: u.f("u_intensity"),
+            mode: u.i("u_mode"),
+            color_matrix: u.m4("u_color_matrix"),
+        }),
+        ProgramKind::Outline => BuiltProgram::Outline(OutlineProg {
+            model: u.m4("u_model"),
+            view: u.m4("u_view"),
+            projection: u.m4("u_projection"),
+            outline_width: u.f("u_outline_width"),
+            outline_pixels: u.f("u_outline_pixels"),
+            viewport: u.v2("u_viewport"),
+            far_only: u.f("u_far_only"),
+            outline_color: u.v4("u_outline_color"),
+        }),
+    })
+}
+
+// ---- small vector maths (column-major mat4, as GLSL) ----
+
+#[inline]
+fn mul4(m: &[f32; 16], v: [f32; 4]) -> [f32; 4] {
+    [
+        m[0] * v[0] + m[4] * v[1] + m[8] * v[2] + m[12] * v[3],
+        m[1] * v[0] + m[5] * v[1] + m[9] * v[2] + m[13] * v[3],
+        m[2] * v[0] + m[6] * v[1] + m[10] * v[2] + m[14] * v[3],
+        m[3] * v[0] + m[7] * v[1] + m[11] * v[2] + m[15] * v[3],
+    ]
+}
+
+/// mat3(m) * v: the upper-left 3x3.
+#[inline]
+fn mul3(m: &[f32; 16], v: [f32; 3]) -> [f32; 3] {
+    [
+        m[0] * v[0] + m[4] * v[1] + m[8] * v[2],
+        m[1] * v[0] + m[5] * v[1] + m[9] * v[2],
+        m[2] * v[0] + m[6] * v[1] + m[10] * v[2],
+    ]
+}
+
+fn mat_mul(a: &[f32; 16], b: &[f32; 16]) -> [f32; 16] {
+    let mut r = [0.0; 16];
+    for c in 0..4 {
+        for row in 0..4 {
+            r[c * 4 + row] = a[row] * b[c * 4] + a[4 + row] * b[c * 4 + 1] + a[8 + row] * b[c * 4 + 2] + a[12 + row] * b[c * 4 + 3];
+        }
+    }
+    r
+}
+
+#[inline]
+fn dot3(a: [f32; 3], b: [f32; 3]) -> f32 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+#[inline]
+fn sub3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+#[inline]
+fn add3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+
+#[inline]
+fn scale3(a: [f32; 3], s: f32) -> [f32; 3] {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+
+#[inline]
+fn mulc3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    [a[0] * b[0], a[1] * b[1], a[2] * b[2]]
+}
+
+#[inline]
+fn length3(a: [f32; 3]) -> f32 {
+    dot3(a, a).sqrt()
+}
+
+/// GLSL normalize (a zero vector stays zero here instead of becoming NaN).
+#[inline]
+fn normalize3(a: [f32; 3]) -> [f32; 3] {
+    let l = length3(a);
+    if l > 0.0 {
+        scale3(a, 1.0 / l)
+    } else {
+        a
+    }
+}
+
+#[inline]
+fn cross3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+#[inline]
+fn mix3(a: [f32; 3], b: [f32; 3], t: f32) -> [f32; 3] {
+    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]
+}
+
+#[inline]
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+#[inline]
+fn sample(tex: &Option<SamplerTex>, u: f32, v: f32, f: &Frag, du: usize, dv: usize) -> [f32; 4] {
+    match tex {
+        Some(t) => {
+            let (dudx, dudy) = f.deriv(du);
+            let (dvdx, dvdy) = f.deriv(dv);
+            t.sample(u, v, t.lambda(dudx, dvdx, dudy, dvdy))
+        }
+        // An unbound unit samples as an incomplete texture: (0, 0, 0, 1).
+        None => [0.0, 0.0, 0.0, 1.0],
+    }
+}
+
+// ---- the 3D model program ----
+
+// Varying slots.
+const V_UV: usize = 0;
+const V_UV2: usize = 2;
+const V_LIGHT: usize = 4;
+const V_FOG: usize = 7;
+const V_SPHERE: usize = 8;
+const V_WORLD: usize = 10;
+const V_VCOL: usize = 13;
+
+pub struct Main3d {
+    model: [f32; 16],
+    view: [f32; 16],
+    projection: [f32; 16],
+    skinning: i32,
+    bones: Vec<[f32; 16]>,
+    tex_transform: [f32; 16],
+    wrap_transform: [f32; 16],
+    texcoord2_direct: i32,
+    uv_proj_mode: i32,
+    diffuse: [f32; 4],
+    ambient: [f32; 4],
+    specular: [f32; 4],
+    emissive: [f32; 4],
+    has_vertex_color: i32,
+    shininess: f32,
+    opacity: f32,
+    alpha_threshold: f32,
+    has_texture: i32,
+    flat_shading: i32,
+    texture_unlit: i32,
+    has_lightmap: i32,
+    lightmap_intensity: f32,
+    has_texcoord2: i32,
+    layer2_blend: i32,
+    layer2_intensity: f32,
+    shader_mode: i32,
+    toon_steps: f32,
+    num_lights: usize,
+    light_pos: [[f32; 3]; 8],
+    light_color: [[f32; 3]; 8],
+    light_type: [i32; 8],
+    light_atten: [[f32; 3]; 8],
+    light_dir: [[f32; 3]; 8],
+    light_spot_angle: [f32; 8],
+    light_spot_exp: [f32; 8],
+    camera_pos: [f32; 3],
+    global_ambient: [f32; 3],
+    fog_enabled: i32,
+    fog_near: f32,
+    fog_far: f32,
+    fog_color: [f32; 3],
+    fog_mode: i32,
+    diffuse_tex: Option<SamplerTex>,
+    lightmap_tex: Option<SamplerTex>,
+    layer2_tex: Option<SamplerTex>,
+}
+
+impl Main3d {
+    fn new(u: &U, samplers: &[Option<SamplerTex>]) -> Main3d {
+        let skinning = u.i("u_skinning_enabled");
+        // The bone palette only when the draw skins (it is 96 matrices; most draws do not).
+        let bones = if skinning > 0 {
+            let b = u.vals("u_bone_matrices");
+            (0..96).map(|i| std::array::from_fn(|k| b.at(i * 16 + k))).collect()
+        } else {
+            Vec::new()
+        };
+        let mut light_pos = [[0.0; 3]; 8];
+        let mut light_color = [[0.0; 3]; 8];
+        let mut light_atten = [[0.0; 3]; 8];
+        let mut light_dir = [[0.0; 3]; 8];
+        let mut light_type = [0; 8];
+        let mut light_spot_angle = [0.0; 8];
+        let mut light_spot_exp = [0.0; 8];
+        let (lp, lc, la, ld) = (u.vals("u_light_pos"), u.vals("u_light_color"), u.vals("u_light_atten"), u.vals("u_light_dir"));
+        let (lt, lsa, lse) = (u.vals("u_light_type"), u.vals("u_light_spot_angle"), u.vals("u_light_spot_exp"));
+        for i in 0..8 {
+            light_pos[i] = lp.v3_at(i);
+            light_color[i] = lc.v3_at(i);
+            light_atten[i] = la.v3_at(i);
+            light_dir[i] = ld.v3_at(i);
+            light_type[i] = lt.at(i) as i32;
+            light_spot_angle[i] = lsa.at(i);
+            light_spot_exp[i] = lse.at(i);
+        }
+        Main3d {
+            model: u.m4("u_model"),
+            view: u.m4("u_view"),
+            projection: u.m4("u_projection"),
+            skinning,
+            bones,
+            tex_transform: u.m4("u_tex_transform"),
+            wrap_transform: u.m4("u_wrap_transform"),
+            texcoord2_direct: u.i("u_texcoord2_direct"),
+            uv_proj_mode: u.i("u_uv_proj_mode"),
+            diffuse: u.v4("u_diffuse_color"),
+            ambient: u.v4("u_ambient_color"),
+            specular: u.v4("u_specular_color"),
+            emissive: u.v4("u_emissive_color"),
+            has_vertex_color: u.i("u_has_vertex_color"),
+            shininess: u.f("u_shininess"),
+            opacity: u.f("u_opacity"),
+            alpha_threshold: u.f("u_alpha_threshold"),
+            has_texture: u.i("u_has_texture"),
+            flat_shading: u.i("u_flat_shading"),
+            texture_unlit: u.i("u_texture_unlit"),
+            has_lightmap: u.i("u_has_lightmap"),
+            lightmap_intensity: u.f("u_lightmap_intensity"),
+            has_texcoord2: u.i("u_has_texcoord2"),
+            layer2_blend: u.i("u_layer2_blend"),
+            layer2_intensity: u.f("u_layer2_intensity"),
+            shader_mode: u.i("u_shader_mode"),
+            toon_steps: u.f("u_toon_steps"),
+            num_lights: u.i("u_num_lights").clamp(0, 8) as usize,
+            light_pos,
+            light_color,
+            light_type,
+            light_atten,
+            light_dir,
+            light_spot_angle,
+            light_spot_exp,
+            camera_pos: u.v3("u_camera_pos"),
+            global_ambient: u.v3("u_global_ambient"),
+            fog_enabled: u.i("u_fog_enabled"),
+            fog_near: u.f("u_fog_near"),
+            fog_far: u.f("u_fog_far"),
+            fog_color: u.v3("u_fog_color"),
+            fog_mode: u.i("u_fog_mode"),
+            diffuse_tex: sampler(samplers, u.i("u_diffuse_tex")),
+            lightmap_tex: sampler(samplers, u.i("u_lightmap_tex")),
+            layer2_tex: sampler(samplers, u.i("u_layer2_tex")),
+        }
+    }
+
+    /// The fragment shader's lighting for a surface point: on the textured path the clamped
+    /// lighting times the vertex colour (what GL_MODULATE multiplies the texture by), on the
+    /// untextured path the lit colour before the lightmap.
+    fn light(&self, pos: [f32; 3], n_raw: [f32; 3], vcol: [f32; 3]) -> [f32; 3] {
+        let n = normalize3(n_raw);
+        let v = normalize3(sub3(self.camera_pos, pos));
+        // One-sided lighting with the normal turned to face the viewer.
+        let nl = if dot3(n, v) < 0.0 { scale3(n, -1.0) } else { n };
+        let amb = [self.ambient[0], self.ambient[1], self.ambient[2]];
+        let dif = [self.diffuse[0], self.diffuse[1], self.diffuse[2]];
+        let textured = self.has_texture > 0;
+        let base = if self.has_vertex_color > 0 { vcol } else { dif };
+        let mut out = [self.emissive[0], self.emissive[1], self.emissive[2]];
+        if !textured && self.has_lightmap > 0 {
+            // Lightmap-only: the material colour is what the baked map multiplies.
+            return add3(out, base);
+        }
+        out = add3(out, mulc3(self.global_ambient, amb));
+        for i in 0..self.num_lights {
+            let lc = self.light_color[i];
+            if self.light_type[i] == 0 {
+                out = add3(out, mulc3(lc, amb));
+                continue;
+            }
+            let (l, atten) = if self.light_type[i] == 1 {
+                (normalize3(self.light_pos[i]), 1.0)
+            } else {
+                let light_dir = sub3(self.light_pos[i], pos);
+                let dist = length3(light_dir);
+                let l = if dist > 0.0 { scale3(light_dir, 1.0 / dist) } else { light_dir };
+                let at = self.light_atten[i];
+                let mut atten = 1.0 / (at[0] + at[1] * dist + at[2] * dist * dist);
+                if self.light_spot_angle[i] > 0.0 {
+                    let spot_cos = dot3(normalize3(scale3(light_dir, -1.0)), self.light_dir[i]);
+                    let cone_cos = self.light_spot_angle[i].cos();
+                    if spot_cos < cone_cos {
+                        atten = 0.0;
+                    } else {
+                        atten *= spot_cos.powf(self.light_spot_exp[i]) * smoothstep(cone_cos, cone_cos + 0.02, spot_cos);
+                    }
+                }
+                (l, atten)
+            };
+            let mut diff = dot3(nl, l).max(0.0);
+            if self.shader_mode == 1 && self.toon_steps > 0.0 {
+                diff = (diff * self.toon_steps + 0.5).floor() / self.toon_steps;
+            }
+            if textured {
+                out = add3(out, scale3(mulc3(lc, dif), atten * diff));
+            } else {
+                out = add3(out, scale3(mulc3(lc, base), atten * diff));
+                if self.shininess > 0.0 && diff > 0.0 {
+                    let h = normalize3(add3(l, v));
+                    let spec = dot3(nl, h).max(0.0).powf(self.shininess);
+                    let sc = [self.specular[0], self.specular[1], self.specular[2]];
+                    out = add3(out, scale3(mulc3(lc, sc), spec * atten));
+                }
+            }
+        }
+        if textured {
+            let lit = [out[0].clamp(0.0, 1.0), out[1].clamp(0.0, 1.0), out[2].clamp(0.0, 1.0)];
+            let vt = if self.has_vertex_color > 0 { vcol } else { [1.0; 3] };
+            return mulc3(lit, vt);
+        }
+        out
+    }
+
+    fn sphere_uv(&self, world_n: [f32; 3], world_pos: [f32; 3]) -> [f32; 2] {
+        let n_eye = normalize3(mul3(&self.view, normalize3(world_n)));
+        let pe = mul4(&self.view, [world_pos[0], world_pos[1], world_pos[2], 1.0]);
+        let incident = normalize3([pe[0], pe[1], pe[2]]);
+        let d = dot3(n_eye, incident);
+        let r = sub3(incident, scale3(n_eye, 2.0 * d));
+        let m = (2.0 * (r[0] * r[0] + r[1] * r[1] + (r[2] + 1.0) * (r[2] + 1.0)).sqrt()).max(1e-4);
+        [r[0] / m + 0.5, 0.5 - r[1] / m]
+    }
+
+    fn fog_factor(&self, world_pos: [f32; 3]) -> f32 {
+        if self.fog_enabled <= 0 {
+            return 1.0;
+        }
+        let dist = length3(sub3(self.camera_pos, world_pos));
+        match self.fog_mode {
+            0 => (self.fog_far - dist) / (self.fog_far - self.fog_near),
+            1 => (-(4.605_170_2 / self.fog_far) * dist).exp(),
+            _ => {
+                let d = (2.145_966 / self.fog_far) * dist;
+                (-(d * d)).exp()
+            }
+        }
+    }
+
+    #[inline]
+    fn apply_fog(&self, c: [f32; 3], fog: f32) -> [f32; 3] {
+        if self.fog_enabled <= 0 {
+            return c;
+        }
+        mix3(self.fog_color, c, fog.clamp(0.0, 1.0))
+    }
+}
+
+impl Program for Main3d {
+    fn interp(&self) -> usize {
+        if self.layer2_blend >= 5 {
+            V_SPHERE + 2
+        } else {
+            V_FOG + 1
+        }
+    }
+
+    fn draws_nothing(&self) -> bool {
+        // `if (u_opacity < 0.004) discard;` — every fragment.
+        self.opacity < 0.004
+    }
+
+    fn point_size(&self) -> f32 {
+        2.0
+    }
+
+    fn vertex(&self, a: &[[f32; 4]; NATTR]) -> VOut {
+        let a_pos = [a[0][0], a[0][1], a[0][2], 1.0];
+        let a_nrm = [a[1][0], a[1][1], a[1][2]];
+        let tc = [a[2][0], a[2][1]];
+        let tc2 = [a[3][0], a[3][1]];
+        let (local_pos, local_n) = if self.skinning > 0 {
+            let mut sk = [0.0f32; 16];
+            for k in 0..4 {
+                let idx = a[4][k] as i32;
+                let w = a[5][k];
+                if (0..96).contains(&idx) && w != 0.0 {
+                    let m = &self.bones[idx as usize];
+                    for e in 0..16 {
+                        sk[e] += w * m[e];
+                    }
+                }
+            }
+            (mul4(&sk, a_pos), mul3(&sk, a_nrm))
+        } else {
+            (a_pos, a_nrm)
+        };
+        let world = mul4(&self.model, local_pos);
+        let view_pos = mul4(&self.view, world);
+        let world3 = [world[0], world[1], world[2]];
+        let normal = mul3(&self.model, local_n);
+
+        let base_uv = if self.uv_proj_mode == 5 {
+            let m = mul4(&self.wrap_transform, a_pos);
+            [m[0], m[1]]
+        } else if self.skinning == -1 {
+            tc
+        } else {
+            [tc[0] + 0.5, 0.5 - tc[1]]
+        };
+        let uv = if self.uv_proj_mode == 5 || self.skinning == -1 {
+            let t = mul4(&self.tex_transform, [base_uv[0], base_uv[1], 0.0, 1.0]);
+            [t[0], t[1]]
+        } else {
+            let t = mul4(&self.tex_transform, [tc[0] + 0.5, tc[1] + 0.5, 0.0, 1.0]);
+            [t[0], 1.0 - t[1]]
+        };
+        let uv2 = if self.skinning == -1 {
+            tc2
+        } else if self.texcoord2_direct > 0 {
+            [tc2[0], 1.0 - tc2[1]]
+        } else {
+            [tc2[0] + 0.5, 0.5 - tc2[1]]
+        };
+
+        let vcol = [a[6][0], a[6][1], a[6][2]];
+        let mut o = VOut { pos: mul4(&self.projection, view_pos), v: [0.0; MAXV] };
+        o.v[V_UV] = uv[0];
+        o.v[V_UV + 1] = uv[1];
+        o.v[V_UV2] = uv2[0];
+        o.v[V_UV2 + 1] = uv2[1];
+        let l = self.light(world3, normal, vcol);
+        o.v[V_LIGHT..V_LIGHT + 3].copy_from_slice(&l);
+        o.v[V_FOG] = self.fog_factor(world3);
+        if self.layer2_blend >= 5 {
+            let s = self.sphere_uv(normal, world3);
+            o.v[V_SPHERE] = s[0];
+            o.v[V_SPHERE + 1] = s[1];
+        }
+        o.v[V_WORLD..V_WORLD + 3].copy_from_slice(&world3);
+        o.v[V_VCOL..V_VCOL + 3].copy_from_slice(&vcol);
+        o
+    }
+
+    fn triangle(&self, t: &mut [VOut; 3]) {
+        if self.flat_shading <= 0 {
+            return;
+        }
+        // `shader.flat`: one normal per face, and (as Director documents it) the face's first
+        // vertex's shading for the whole face.
+        let p0 = [t[0].v[V_WORLD], t[0].v[V_WORLD + 1], t[0].v[V_WORLD + 2]];
+        let p1 = [t[1].v[V_WORLD], t[1].v[V_WORLD + 1], t[1].v[V_WORLD + 2]];
+        let p2 = [t[2].v[V_WORLD], t[2].v[V_WORLD + 1], t[2].v[V_WORLD + 2]];
+        let n = cross3(sub3(p1, p0), sub3(p2, p0));
+        if dot3(n, n) <= 1e-12 {
+            return;
+        }
+        let vcol = [t[0].v[V_VCOL], t[0].v[V_VCOL + 1], t[0].v[V_VCOL + 2]];
+        let l = self.light(p0, n, vcol);
+        for v in t.iter_mut() {
+            v.v[V_LIGHT..V_LIGHT + 3].copy_from_slice(&l);
+        }
+        if self.layer2_blend >= 5 {
+            for v in t.iter_mut() {
+                let p = [v.v[V_WORLD], v.v[V_WORLD + 1], v.v[V_WORLD + 2]];
+                let s = self.sphere_uv(n, p);
+                v.v[V_SPHERE] = s[0];
+                v.v[V_SPHERE + 1] = s[1];
+            }
+        }
+    }
+
+    fn describe(&self, f: &Frag) -> String {
+        let tex = sample(&self.diffuse_tex, f.v[V_UV], f.v[V_UV + 1], f, V_UV, V_UV + 1);
+        let (lm_uv, d) = if self.has_texcoord2 > 0 { ([f.v[V_UV2], f.v[V_UV2 + 1]], V_UV2) } else { ([f.v[V_UV], f.v[V_UV + 1]], V_UV) };
+        let lm = sample(&self.lightmap_tex, lm_uv[0], lm_uv[1], f, d, d + 1);
+        format!(
+            "uv2 {:.3},{:.3} has_uv2 {} direct {} lm {:?} intensity {:.2} | main: has_texture {} tex {:?} ({}) uv {:.3},{:.3} light {:.3},{:.3},{:.3} vcol? {} lightmap {} ({}) l2 {} opacity {:.2} diffuse {:?} ambient {:?} emissive {:?} lights {} global_amb {:?} unlit {} fog {} skin {} flat {}",
+            lm_uv[0], lm_uv[1], self.has_texcoord2, self.texcoord2_direct, lm, self.lightmap_intensity,
+            self.has_texture, tex, self.diffuse_tex.as_ref().map(|t| format!("{:?} complete {}", t.size(), t.complete)).unwrap_or("none".into()),
+            f.v[V_UV], f.v[V_UV + 1], f.v[V_LIGHT], f.v[V_LIGHT + 1], f.v[V_LIGHT + 2], self.has_vertex_color,
+            self.has_lightmap, self.lightmap_tex.as_ref().map(|t| format!("{:?}", t.size())).unwrap_or("none".into()), self.layer2_blend,
+            self.opacity, self.diffuse, self.ambient, self.emissive, self.num_lights, self.global_ambient, self.texture_unlit, self.fog_enabled, self.skinning, self.flat_shading
+        )
+    }
+
+    fn fragment(&self, f: &Frag) -> Option<[f32; 4]> {
+        let uv = [f.v[V_UV], f.v[V_UV + 1]];
+        let light = [f.v[V_LIGHT], f.v[V_LIGHT + 1], f.v[V_LIGHT + 2]];
+        let fog = f.v[V_FOG];
+        let second_uv = |f: &Frag| -> ([f32; 2], usize) {
+            if self.has_texcoord2 > 0 {
+                ([f.v[V_UV2], f.v[V_UV2 + 1]], V_UV2)
+            } else {
+                (uv, V_UV)
+            }
+        };
+        if self.has_texture > 0 {
+            let tex = sample(&self.diffuse_tex, uv[0], uv[1], f, V_UV, V_UV + 1);
+            if self.alpha_threshold > 0.0 && tex[3] < self.alpha_threshold {
+                return None;
+            }
+            let mut c = if self.texture_unlit > 0 { [tex[0], tex[1], tex[2]] } else { mulc3([tex[0], tex[1], tex[2]], light) };
+            if self.has_lightmap > 0 {
+                let (lm_uv, d) = second_uv(f);
+                let lm = sample(&self.lightmap_tex, lm_uv[0], lm_uv[1], f, d, d + 1);
+                if self.has_lightmap == 1 {
+                    c = mulc3(c, mix3([1.0; 3], [lm[0], lm[1], lm[2]], self.lightmap_intensity));
+                } else if self.has_lightmap == 2 {
+                    c = add3(c, scale3([lm[0], lm[1], lm[2]], self.lightmap_intensity));
+                }
+            }
+            if self.layer2_blend >= 5 {
+                let r4 = sample(&self.layer2_tex, f.v[V_SPHERE], f.v[V_SPHERE + 1], f, V_SPHERE, V_SPHERE + 1);
+                let r = [r4[0], r4[1], r4[2]];
+                c = match self.layer2_blend {
+                    6 => [(c[0] + r[0]).min(1.0), (c[1] + r[1]).min(1.0), (c[2] + r[2]).min(1.0)],
+                    7 => mulc3(c, r),
+                    8 => r,
+                    _ => mix3(c, r, self.layer2_intensity),
+                };
+            } else if self.layer2_blend > 0 {
+                let (l2_uv, d) = second_uv(f);
+                let l2 = sample(&self.layer2_tex, l2_uv[0], l2_uv[1], f, d, d + 1);
+                if self.layer2_blend == 1 {
+                    c = mulc3(c, mix3([1.0; 3], [l2[0], l2[1], l2[2]], self.layer2_intensity));
+                } else if self.layer2_blend == 2 {
+                    c = add3(c, scale3([l2[0], l2[1], l2[2]], self.layer2_intensity));
+                }
+            }
+            let c = self.apply_fog(c, fog);
+            return Some([c[0], c[1], c[2], self.opacity * tex[3]]);
+        }
+
+        let mut c = light;
+        if self.has_lightmap > 0 {
+            let (lm_uv, d) = second_uv(f);
+            let lm = sample(&self.lightmap_tex, lm_uv[0], lm_uv[1], f, d, d + 1);
+            if self.has_lightmap == 1 {
+                c = mulc3(c, mix3([1.0; 3], [lm[0], lm[1], lm[2]], self.lightmap_intensity));
+            } else if self.has_lightmap == 2 {
+                c = add3(c, scale3([lm[0], lm[1], lm[2]], self.lightmap_intensity));
+            }
+        }
+        let mut refl_alpha = 1.0;
+        if self.layer2_blend >= 5 {
+            let r4 = sample(&self.layer2_tex, f.v[V_SPHERE], f.v[V_SPHERE + 1], f, V_SPHERE, V_SPHERE + 1);
+            let r = [r4[0], r4[1], r4[2]];
+            c = match self.layer2_blend {
+                6 => [(c[0] + r[0]).min(1.0), (c[1] + r[1]).min(1.0), (c[2] + r[2]).min(1.0)],
+                7 => {
+                    refl_alpha = r4[3];
+                    mulc3(c, r)
+                }
+                8 => r,
+                _ => mix3(c, r, self.layer2_intensity),
+            };
+        }
+        let c = self.apply_fog(c, fog);
+        Some([c[0], c[1], c[2], self.opacity * self.diffuse[3] * refl_alpha])
+    }
+}
