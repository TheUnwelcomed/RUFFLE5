+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the part of WebGL2 that DirPlayer's Shockwave 3D renderer
+//! (`webgl2/scene3d.rs`, `mesh3d.rs`, `context.rs`) calls, drawn in software, so those files
+//! compile and run off the web unchanged apart from their imports (`super::gl`).
+//!
+//! The names and signatures are web_sys' (`WebGl2RenderingContext::uniform1i`, ...), the
+//! behaviour is the OpenGL ES 3.0 / WebGL2 specification's for the calls and state used there:
+//! buffers, vertex arrays, 2D textures with mipmaps, framebuffers with a colour texture and a
+//! depth renderbuffer, depth test, culling, scissor, blending, colour mask, polygon offset,
+//! clears, blits and `copyTexSubImage2D`. GLSL is not compiled: a linked program is recognised
+//! by its source and run by the Rust port of that program in `programs.rs`.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use super::state::State;
+use super::trace::{self, J};
+
+/// `wasm_bindgen::JsValue` as far as these files use it: an error value made from text.
+#[derive(Clone, Debug, PartialEq)]
+pub enum JsValue {
+    Undefined,
+    Bool(bool),
+    Str(String),
+}
+
+impl JsValue {
+    pub const UNDEFINED: JsValue = JsValue::Undefined;
+    pub fn from_str(s: &str) -> JsValue {
+        JsValue::Str(s.to_string())
+    }
+    pub fn from_bool(b: bool) -> JsValue {
+        JsValue::Bool(b)
+    }
+    pub fn as_bool(&self) -> Option<bool> {
+        match self {
+            JsValue::Bool(b) => Some(*b),
+            _ => None,
+        }
+    }
+    pub fn as_string(&self) -> Option<String> {
+        match self {
+            JsValue::Str(s) => Some(s.clone()),
+            _ => None,
+        }
+    }
+}
+
+impl From<&str> for JsValue {
+    fn from(s: &str) -> JsValue {
+        JsValue::Str(s.to_string())
+    }
+}
+
+impl From<String> for JsValue {
+    fn from(s: String) -> JsValue {
+        JsValue::Str(s)
+    }
+}
+
+impl From<bool> for JsValue {
+    fn from(b: bool) -> JsValue {
+        JsValue::Bool(b)
+    }
+}
+
+/// What `bufferData` uploads: the bytes of a typed array.
+pub trait BufferSource {
+    fn bytes(&self) -> &[u8];
+}
+
+/// `js_sys::Float32Array::view`: here a copy of the slice (the browser's is a view into wasm
+/// memory, read once by `bufferData`; the copy is read the same once).
+#[derive(Clone, Debug)]
+pub struct Float32Array {
+    data: Vec<u8>,
+}
+
+impl Float32Array {
+    pub fn view(values: &[f32]) -> Float32Array {
+        let mut data = Vec::with_capacity(values.len() * 4);
+        for v in values {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Float32Array { data }
+    }
+}
+
+impl BufferSource for Float32Array {
+    fn bytes(&self) -> &[u8] {
+        &self.data
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Uint32Array {
+    data: Vec<u8>,
+}
+
+impl Uint32Array {
+    pub fn view(values: &[u32]) -> Uint32Array {
+        let mut data = Vec::with_capacity(values.len() * 4);
+        for v in values {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Uint32Array { data }
+    }
+}
+
+impl BufferSource for Uint32Array {
+    fn bytes(&self) -> &[u8] {
+        &self.data
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Uint16Array {
+    data: Vec<u8>,
+}
+
+impl Uint16Array {
+    pub fn view(values: &[u16]) -> Uint16Array {
+        let mut data = Vec::with_capacity(values.len() * 2);
+        for v in values {
+            data.extend_from_slice(&v.to_le_bytes());
+        }
+        Uint16Array { data }
+    }
+}
+
+impl BufferSource for Uint16Array {
+    fn bytes(&self) -> &[u8] {
+        &self.data
+    }
+}
+
+macro_rules! handle {
+    ($name:ident) => {
+        /// A WebGL object: its number in the context that made it.
+        #[derive(Clone, Debug, PartialEq, Eq, Hash)]
+        pub struct $name(pub(crate) u32);
+    };
+}
+
+handle!(WebGlBuffer);
+handle!(WebGlTexture);
+handle!(WebGlFramebuffer);
+handle!(WebGlRenderbuffer);
+handle!(WebGlVertexArrayObject);
+handle!(WebGlShader);
+handle!(WebGlProgram);
+
+/// A uniform of a program: its name without an array suffix and the element it starts at.
+#[derive(Clone, Debug, PartialEq)]
+pub struct WebGlUniformLocation {
+    pub(crate) program: u32,
+    pub(crate) name: Rc<str>,
+    pub(crate) index: usize,
+    /// The name as given to getUniformLocation (for the call trace).
+    pub(crate) full: Rc<str>,
+}
+
+/// The browser's API object; every copy draws into the same software context.
+#[derive(Clone)]
+pub struct WebGl2RenderingContext {
+    pub(crate) st: Rc<RefCell<State>>,
+    /// Calls on this context go into the call trace (trace.rs) while one is being recorded.
+    pub(crate) tr: bool,
+}
+
+/// One call into the trace, when this context is traced and a trace is being recorded.
+macro_rules! tr {
+    ($self:ident, $f:expr $(, $a:expr)* $(,)?) => {
+        if $self.tr && trace::ON.load(std::sync::atomic::Ordering::Relaxed) {
+            trace::rec($f, &[$($a),*]);
+        }
+    };
+}
+
+/// Whether a call trace is being recorded (for notes that cost something to make).
+pub fn tracing() -> bool {
+    trace::ON.load(std::sync::atomic::Ordering::Relaxed)
+}
+/// A line of the renderer's own in the call trace (which model, which texture name).
+pub fn note(s: &str) {
+    trace::rec("note", &[J::S(s)]);
+}
+pub fn texture_id(t: &WebGlTexture) -> u32 {
+    t.0
+}
+
+fn h(o: Option<u32>) -> J<'static> {
+    match o {
+        Some(v) => J::U(v),
+        None => J::Null,
+    }
+}
+
+impl std::fmt::Debug for WebGl2RenderingContext {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("WebGl2RenderingContext(software)")
+    }
+}
+
+pub mod web_sys {
+    pub use super::{
+        WebGl2RenderingContext, WebGlBuffer, WebGlFramebuffer, WebGlProgram, WebGlRenderbuffer,
+        WebGlShader, WebGlTexture, WebGlUniformLocation, WebGlVertexArrayObject,
+    };
+}
+
+pub mod js_sys {
+    pub use super::{Float32Array, Uint16Array, Uint32Array};
+}
