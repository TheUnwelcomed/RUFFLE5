+++ b/vm-rust/src/player/host_date.rs
@@ -0,0 +1,348 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the clock and calendar DirPlayer took from the browser —
+//! `Date.now()`, `new Date(ms)` read and set in local time, `toLocaleDateString` /
+//! `toLocaleTimeString` — behind one type.
+//!
+//! On the web it is js_sys, called exactly as before. Elsewhere a browser call panics ("cannot
+//! call wasm-bindgen imported functions on non-wasm targets"): there the same arithmetic as
+//! JavaScript's Date (ECMA-262 §21.4.1: time values, Day/TimeWithinDay, MakeTime, MakeDay,
+//! MakeDate, TimeClip, LocalTime and UTC), over chrono's local time zone (the one `the date` and
+//! `the time` already use); the strings are what an en-US browser gives for the same options.
+
+/// Milliseconds since 1970-01-01T00:00:00Z, as `Date.now()`.
+#[cfg(target_arch = "wasm32")]
+pub fn now_ms() -> f64 {
+    js_sys::Date::now()
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn now_ms() -> f64 {
+    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
+        Ok(d) => d.as_millis() as f64,
+        Err(e) => -(e.duration().as_millis() as f64),
+    }
+}
+
+/// A date as JavaScript holds one: a time value (ms since the epoch, UTC; NaN when invalid), read
+/// and changed in local time. The methods are js_sys::Date's, with its argument and result types.
+#[cfg(target_arch = "wasm32")]
+pub struct LocalDate(js_sys::Date);
+
+#[cfg(target_arch = "wasm32")]
+impl LocalDate {
+    pub fn now() -> Self {
+        LocalDate(js_sys::Date::new_0())
+    }
+    pub fn from_ms(ms: f64) -> Self {
+        LocalDate(js_sys::Date::new(&wasm_bindgen::JsValue::from_f64(ms)))
+    }
+    pub fn get_time(&self) -> f64 {
+        self.0.get_time()
+    }
+    pub fn get_full_year(&self) -> u32 {
+        self.0.get_full_year()
+    }
+    pub fn get_month(&self) -> u32 {
+        self.0.get_month()
+    }
+    pub fn get_date(&self) -> u32 {
+        self.0.get_date()
+    }
+    pub fn get_day(&self) -> u32 {
+        self.0.get_day()
+    }
+    pub fn get_hours(&self) -> u32 {
+        self.0.get_hours()
+    }
+    pub fn get_minutes(&self) -> u32 {
+        self.0.get_minutes()
+    }
+    pub fn get_seconds(&self) -> u32 {
+        self.0.get_seconds()
+    }
+    pub fn get_milliseconds(&self) -> u32 {
+        self.0.get_milliseconds()
+    }
+    pub fn set_full_year(&mut self, v: u32) -> f64 {
+        self.0.set_full_year(v)
+    }
+    pub fn set_month(&mut self, v: u32) -> f64 {
+        self.0.set_month(v)
+    }
+    pub fn set_date(&mut self, v: u32) -> f64 {
+        self.0.set_date(v)
+    }
+    pub fn set_hours(&mut self, v: u32) -> f64 {
+        self.0.set_hours(v)
+    }
+    pub fn set_minutes(&mut self, v: u32) -> f64 {
+        self.0.set_minutes(v)
+    }
+    pub fn set_seconds(&mut self, v: u32) -> f64 {
+        self.0.set_seconds(v)
+    }
+    pub fn set_milliseconds(&mut self, v: u32) -> f64 {
+        self.0.set_milliseconds(v)
+    }
+    /// `toLocaleDateString("default", {day: "2-digit", month: "2-digit", year: "numeric"})`.
+    pub fn locale_date(&self) -> String {
+        let o = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&o, &"day".into(), &"2-digit".into());
+        let _ = js_sys::Reflect::set(&o, &"month".into(), &"2-digit".into());
+        let _ = js_sys::Reflect::set(&o, &"year".into(), &"numeric".into());
+        self.0.to_locale_date_string("default", &o).as_string().unwrap_or_default()
+    }
+    /// `toLocaleTimeString("default", {hour: "2-digit", minute: "2-digit"})`.
+    pub fn locale_short_time(&self) -> String {
+        let o = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&o, &"hour".into(), &"2-digit".into());
+        let _ = js_sys::Reflect::set(&o, &"minute".into(), &"2-digit".into());
+        self.0.to_locale_time_string_with_options("default", &o).as_string().unwrap_or_default()
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub struct LocalDate {
+    t: f64,
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod calc {
+    //! ECMA-262 §21.4.1, on time values held as f64 (NaN: an invalid date).
+    pub const MS_PER_DAY: f64 = 86_400_000.0;
+
+    pub fn day(t: f64) -> f64 {
+        (t / MS_PER_DAY).floor()
+    }
+    pub fn time_within_day(t: f64) -> f64 {
+        t.rem_euclid(MS_PER_DAY)
+    }
+    /// Days since 1970-01-01 of a proleptic Gregorian date (H. Hinnant's days_from_civil).
+    pub fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
+        let y = if m <= 2 { y - 1 } else { y };
+        let era = y.div_euclid(400);
+        let yoe = y - era * 400;
+        let mp = (m + 9) % 12;
+        let doy = (153 * mp + 2) / 5 + d - 1;
+        let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+        era * 146_097 + doe - 719_468
+    }
+    /// (year, month 1-12, day 1-31) of days since 1970-01-01 (civil_from_days).
+    pub fn civil_from_days(z: i64) -> (i64, i64, i64) {
+        let z = z + 719_468;
+        let era = z.div_euclid(146_097);
+        let doe = z - era * 146_097;
+        let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+        let mp = (5 * doy + 2) / 153;
+        let d = doy - (153 * mp + 2) / 5 + 1;
+        let m = if mp < 10 { mp + 3 } else { mp - 9 };
+        (yoe + era * 400 + if m <= 2 { 1 } else { 0 }, m, d)
+    }
+    /// (year, month 0-11, date 1-31, weekday 0-6 from Sunday) of a time value.
+    pub fn ymdw(t: f64) -> (f64, f64, f64, f64) {
+        let d = day(t);
+        let (y, m, dd) = civil_from_days(d as i64);
+        (y as f64, (m - 1) as f64, dd as f64, (d + 4.0).rem_euclid(7.0))
+    }
+    /// (hours, minutes, seconds, ms) of a time value.
+    pub fn hmsm(t: f64) -> (f64, f64, f64, f64) {
+        let w = time_within_day(t);
+        ((w / 3_600_000.0).floor(), (w / 60_000.0).floor() % 60.0, (w / 1000.0).floor() % 60.0, w % 1000.0)
+    }
+    pub fn make_time(h: f64, m: f64, s: f64, ms: f64) -> f64 {
+        if !(h.is_finite() && m.is_finite() && s.is_finite() && ms.is_finite()) {
+            return f64::NAN;
+        }
+        h.trunc() * 3_600_000.0 + m.trunc() * 60_000.0 + s.trunc() * 1000.0 + ms.trunc()
+    }
+    pub fn make_day(year: f64, month: f64, date: f64) -> f64 {
+        if !(year.is_finite() && month.is_finite() && date.is_finite()) {
+            return f64::NAN;
+        }
+        let (y, m, dt) = (year.trunc(), month.trunc(), date.trunc());
+        let ym = y + (m / 12.0).floor();
+        if ym.abs() > 400_000.0 {
+            return f64::NAN; // far outside the time value range: TimeClip makes it NaN anyway
+        }
+        let mn = m.rem_euclid(12.0);
+        days_from_civil(ym as i64, mn as i64 + 1, 1) as f64 + dt - 1.0
+    }
+    pub fn make_date(day: f64, time: f64) -> f64 {
+        if !(day.is_finite() && time.is_finite()) {
+            return f64::NAN;
+        }
+        let tv = day * MS_PER_DAY + time;
+        if tv.is_finite() { tv } else { f64::NAN }
+    }
+    pub fn time_clip(t: f64) -> f64 {
+        if !t.is_finite() || t.abs() > 8.64e15 {
+            return f64::NAN;
+        }
+        t.trunc() + 0.0
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+impl LocalDate {
+    /// Local time minus UTC at the instant `t` (a UTC time value), in ms.
+    fn offset_at_utc(t: f64) -> f64 {
+        use chrono::{Offset, TimeZone};
+        let Some(utc) = chrono::DateTime::from_timestamp_millis(t as i64) else {
+            return 0.0;
+        };
+        chrono::Local.offset_from_utc_datetime(&utc.naive_utc()).fix().local_minus_utc() as f64 * 1000.0
+    }
+    /// ECMA-262 LocalTime(t).
+    fn local(t: f64) -> f64 {
+        t + Self::offset_at_utc(t)
+    }
+    /// ECMA-262 UTC(t) of a local time value: a repeated local time (clocks going back) is the
+    /// earlier instant, a skipped one (clocks going forward) uses the offset before the change.
+    fn utc(t: f64) -> f64 {
+        use chrono::{LocalResult, Offset, TimeZone};
+        if !t.is_finite() {
+            return f64::NAN;
+        }
+        let Some(naive) = chrono::DateTime::from_timestamp_millis(t as i64).map(|d| d.naive_utc()) else {
+            return f64::NAN;
+        };
+        let off = match chrono::Local.offset_from_local_datetime(&naive) {
+            LocalResult::Single(o) => o.fix().local_minus_utc(),
+            LocalResult::Ambiguous(a, b) => a.fix().local_minus_utc().max(b.fix().local_minus_utc()),
+            LocalResult::None => Self::offset_at_utc(t - calc::MS_PER_DAY) as i32 / 1000,
+        };
+        t - off as f64 * 1000.0
+    }
+
+    pub fn now() -> Self {
+        LocalDate { t: now_ms() }
+    }
+    pub fn from_ms(ms: f64) -> Self {
+        LocalDate { t: calc::time_clip(ms) }
+    }
+    pub fn get_time(&self) -> f64 {
+        self.t
+    }
+    fn parts(&self) -> Option<((f64, f64, f64, f64), (f64, f64, f64, f64))> {
+        if self.t.is_nan() {
+            return None;
+        }
+        let l = Self::local(self.t);
+        Some((calc::ymdw(l), calc::hmsm(l)))
+    }
+    // As js_sys hands JavaScript's numbers to Rust: NaN becomes 0.
+    pub fn get_full_year(&self) -> u32 {
+        self.parts().map_or(0, |p| p.0 .0 as u32)
+    }
+    pub fn get_month(&self) -> u32 {
+        self.parts().map_or(0, |p| p.0 .1 as u32)
+    }
+    pub fn get_date(&self) -> u32 {
+        self.parts().map_or(0, |p| p.0 .2 as u32)
+    }
+    pub fn get_day(&self) -> u32 {
+        self.parts().map_or(0, |p| p.0 .3 as u32)
+    }
+    pub fn get_hours(&self) -> u32 {
+        self.parts().map_or(0, |p| p.1 .0 as u32)
+    }
+    pub fn get_minutes(&self) -> u32 {
+        self.parts().map_or(0, |p| p.1 .1 as u32)
+    }
+    pub fn get_seconds(&self) -> u32 {
+        self.parts().map_or(0, |p| p.1 .2 as u32)
+    }
+    pub fn get_milliseconds(&self) -> u32 {
+        self.parts().map_or(0, |p| p.1 .3 as u32)
+    }
+    /// A setter: the new local date and time from the old ones, back to a time value.
+    fn set(&mut self, f: impl FnOnce((f64, f64, f64), (f64, f64, f64, f64)) -> (f64, f64)) -> f64 {
+        if self.t.is_nan() {
+            return f64::NAN;
+        }
+        let l = Self::local(self.t);
+        let (y, mo, d, _) = calc::ymdw(l);
+        let (day, time) = f((y, mo, d), calc::hmsm(l));
+        self.t = calc::time_clip(Self::utc(calc::make_date(day, time)));
+        self.t
+    }
+    pub fn set_full_year(&mut self, v: u32) -> f64 {
+        // setFullYear on an invalid date starts from +0 (1970-01-01 00:00 local)
+        if self.t.is_nan() {
+            self.t = Self::utc(0.0);
+        }
+        self.set(|(_, mo, d), (h, mi, s, ms)| (calc::make_day(v as f64, mo, d), calc::make_time(h, mi, s, ms)))
+    }
+    pub fn set_month(&mut self, v: u32) -> f64 {
+        self.set(|(y, _, d), (h, mi, s, ms)| (calc::make_day(y, v as f64, d), calc::make_time(h, mi, s, ms)))
+    }
+    pub fn set_date(&mut self, v: u32) -> f64 {
+        self.set(|(y, mo, _), (h, mi, s, ms)| (calc::make_day(y, mo, v as f64), calc::make_time(h, mi, s, ms)))
+    }
+    pub fn set_hours(&mut self, v: u32) -> f64 {
+        self.set(|(y, mo, d), (_, mi, s, ms)| (calc::make_day(y, mo, d), calc::make_time(v as f64, mi, s, ms)))
+    }
+    pub fn set_minutes(&mut self, v: u32) -> f64 {
+        self.set(|(y, mo, d), (h, _, s, ms)| (calc::make_day(y, mo, d), calc::make_time(h, v as f64, s, ms)))
+    }
+    pub fn set_seconds(&mut self, v: u32) -> f64 {
+        self.set(|(y, mo, d), (h, mi, _, ms)| (calc::make_day(y, mo, d), calc::make_time(h, mi, v as f64, ms)))
+    }
+    pub fn set_milliseconds(&mut self, v: u32) -> f64 {
+        self.set(|(y, mo, d), (h, mi, s, _)| (calc::make_day(y, mo, d), calc::make_time(h, mi, s, v as f64)))
+    }
+    /// What an en-US browser gives for `toLocaleDateString(.., {day: "2-digit", month:
+    /// "2-digit", year: "numeric"})`: MM/DD/YYYY ("Invalid Date" for an invalid one).
+    pub fn locale_date(&self) -> String {
+        match self.parts() {
+            Some(((y, mo, d, _), _)) => format!("{:02}/{:02}/{}", mo as i64 + 1, d as i64, y as i64),
+            None => "Invalid Date".into(),
+        }
+    }
+    /// What an en-US browser gives for `toLocaleTimeString(.., {hour: "2-digit", minute:
+    /// "2-digit"})`: hh:mm AM/PM, 12-hour.
+    pub fn locale_short_time(&self) -> String {
+        match self.parts() {
+            Some((_, (h, mi, _, _))) => {
+                let h = h as i64;
+                let h12 = if h % 12 == 0 { 12 } else { h % 12 };
+                format!("{h12:02}:{:02} {}", mi as i64, if h < 12 { "AM" } else { "PM" })
+            }
+            None => "Invalid Date".into(),
+        }
+    }
+}
+
+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::calc::*;
+
+    #[test]
+    fn civil_days_round_trip() {
+        assert_eq!(days_from_civil(1970, 1, 1), 0);
+        assert_eq!(days_from_civil(2000, 3, 1), 11_017);
+        assert_eq!(civil_from_days(-1), (1969, 12, 31));
+        for z in [-719_468i64, -1, 0, 59, 10_957, 20_750, 2_932_896] {
+            let (y, m, d) = civil_from_days(z);
+            assert_eq!(days_from_civil(y, m, d), z);
+        }
+    }
+
+    #[test]
+    fn javascript_rules() {
+        // Date.UTC(2026, 9, 25, 5, 29, 7, 123) = 1792906147123
+        let t = make_date(make_day(2026.0, 9.0, 25.0), make_time(5.0, 29.0, 7.0, 123.0));
+        assert_eq!(t, 1_792_906_147_123.0);
+        assert_eq!(ymdw(t), (2026.0, 9.0, 25.0, 0.0)); // a Sunday
+        assert_eq!(hmsm(t), (5.0, 29.0, 7.0, 123.0));
+        // months and days past their range carry over, as setMonth(12) / setDate(0) do
+        assert_eq!(make_day(2026.0, 12.0, 1.0), make_day(2027.0, 0.0, 1.0));
+        assert_eq!(make_day(2026.0, 2.0, 0.0), make_day(2026.0, 1.0, 28.0));
+        assert_eq!(make_day(2024.0, -1.0, 31.0), make_day(2023.0, 11.0, 31.0));
+        // before 1970
+        assert_eq!(ymdw(-1.0), (1969.0, 11.0, 31.0, 3.0));
+        assert_eq!(hmsm(-1.0), (23.0, 59.0, 59.0, 999.0));
+        assert!(time_clip(8.64e15 + 1.0).is_nan());
+        assert_eq!(time_clip(-8.64e15), -8.64e15);
+    }
+}
