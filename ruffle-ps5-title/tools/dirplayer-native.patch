+//! PS5_RUFFLE_DIRPLAYER_NATIVE (debugging): replays a call trace written by trace.rs into a new
+//! software context, so the software renderer can be run again on exactly the calls a game made
+//! and compared, draw by draw, with a browser's WebGL2 replaying the same trace.
+
+use std::collections::HashMap;
+
+use serde_json::Value;
+
+use super::gl::{
+    WebGl2RenderingContext as GL, WebGlBuffer, WebGlFramebuffer, WebGlProgram, WebGlRenderbuffer, WebGlShader, WebGlTexture,
+    WebGlUniformLocation, WebGlVertexArrayObject,
+};
+
+pub struct Replay {
+    pub width: u32,
+    pub height: u32,
+    /// The result texture, rows as GL keeps them (row 0 = y 0).
+    pub pixels: Vec<u8>,
+    /// Per pixel of the result texture: the index of the last draw of the traced frame that
+    /// changed it, or -1.
+    pub owner: Vec<i32>,
+    /// Draws of the traced frame that ran.
+    pub draws: usize,
+    pub frame: u64,
+}
+
+fn u(a: &[Value], i: usize) -> u32 {
+    a.get(i).and_then(|v| v.as_u64()).unwrap_or(0) as u32
+}
+fn i(a: &[Value], k: usize) -> i32 {
+    a.get(k).and_then(|v| v.as_i64()).unwrap_or(0) as i32
+}
+fn f(a: &[Value], k: usize) -> f32 {
+    a.get(k).and_then(|v| v.as_f64()).unwrap_or(0.0) as f32
+}
+fn b(a: &[Value], k: usize) -> bool {
+    a.get(k).and_then(|v| v.as_bool()).unwrap_or(false)
+}
+fn s(a: &[Value], k: usize) -> String {
+    a.get(k).and_then(|v| v.as_str()).unwrap_or("").to_string()
+}
+fn fs(a: &[Value], k: usize) -> Vec<f32> {
+    a.get(k).and_then(|v| v.as_array()).map(|v| v.iter().map(|x| x.as_f64().unwrap_or(0.0) as f32).collect()).unwrap_or_default()
+}
+fn bytes(a: &[Value], k: usize) -> Option<Vec<u8>> {
+    use base64::Engine;
+    let o = a.get(k)?.as_object()?;
+    base64::engine::general_purpose::STANDARD.decode(o.get("b64")?.as_str()?).ok()
+}
+fn opt(a: &[Value], k: usize) -> Option<u32> {
+    a.get(k).and_then(|v| v.as_u64()).map(|v| v as u32)
+}
+
+/// Replays `path`. `stop_after`: in the traced frame, no draw after that many draws runs.
+pub fn replay(path: &str, stop_after: Option<usize>) -> Result<Replay, String> {
+    super::raster::depth_bits_init();
+    let text = std::fs::read_to_string(path).map_err(|e| format!("{path}: {e}"))?;
+    let lines: Vec<&str> = text.lines().filter(|l| !l.is_empty()).collect();
+    // The traced frame and its result texture come last.
+    let mut target = (0u64, 0u32, 0u32, 0u32);
+    for l in lines.iter().rev() {
+        if l.starts_with("[\"result\"") {
+            let v: Vec<Value> = serde_json::from_str(l).map_err(|e| e.to_string())?;
+            target.1 = u(&v, 1);
+            target.2 = u(&v, 2);
+            target.3 = u(&v, 3);
+        }
+        if l.starts_with("[\"frame\"") {
+            let v: Vec<Value> = serde_json::from_str(l).map_err(|e| e.to_string())?;
+            target.0 = u(&v, 1) as u64;
+            break;
+        }
+    }
+    let (target_frame, result_tex, rw, rh) = target;
+    let mut gl: Option<GL> = None;
+    let mut buf: HashMap<u32, WebGlBuffer> = HashMap::new();
+    let mut tex: HashMap<u32, WebGlTexture> = HashMap::new();
+    let mut fb: HashMap<u32, WebGlFramebuffer> = HashMap::new();
+    let mut rb: HashMap<u32, WebGlRenderbuffer> = HashMap::new();
+    let mut vao: HashMap<u32, WebGlVertexArrayObject> = HashMap::new();
+    let mut sh: HashMap<u32, WebGlShader> = HashMap::new();
+    let mut prog: HashMap<u32, WebGlProgram> = HashMap::new();
+    let mut loc: HashMap<(u32, String), Option<WebGlUniformLocation>> = HashMap::new();
+    let mut frame = 0u64;
+    let mut draws = 0usize;
+    let n = (rw as usize) * (rh as usize);
+    let mut owner = vec![-1i32; n];
+
+    for line in &lines {
+        let a: Vec<Value> = serde_json::from_str(line).map_err(|e| format!("{e}: {}", &line[..line.len().min(80)]))?;
+        let name = a.first().and_then(|v| v.as_str()).unwrap_or("");
+        if name == "context" {
+            gl = Some(GL::new_soft(u(&a, 1).max(1), u(&a, 2).max(1)));
+            buf.clear();
+            tex.clear();
+            fb.clear();
+            rb.clear();
+            vao.clear();
+            sh.clear();
+            prog.clear();
+            loc.clear();
+            continue;
+        }
+        if name == "frame" {
+            frame = u(&a, 1) as u64;
+            continue;
+        }
+        let Some(g) = gl.as_ref() else { continue };
+        let mut get_loc = |p: u32, nm: String| -> Option<WebGlUniformLocation> {
+            loc.entry((p, nm.clone())).or_insert_with(|| prog.get(&p).and_then(|pr| g.get_uniform_location(pr, &nm))).clone()
+        };
+        match name {
+            "result" => break,
+            "createBuffer" => {
+                if let Some(o) = g.create_buffer() {
+                    buf.insert(u(&a, 1), o);
+                }
+            }
+            "deleteBuffer" => {
+                g.delete_buffer(buf.get(&u(&a, 1)));
+                buf.remove(&u(&a, 1));
+            }
+            "createTexture" => {
+                if let Some(o) = g.create_texture() {
+                    tex.insert(u(&a, 1), o);
+                }
+            }
+            "deleteTexture" => {
+                g.delete_texture(tex.get(&u(&a, 1)));
+                tex.remove(&u(&a, 1));
+            }
+            "createFramebuffer" => {
+                if let Some(o) = g.create_framebuffer() {
+                    fb.insert(u(&a, 1), o);
+                }
+            }
+            "deleteFramebuffer" => {
+                g.delete_framebuffer(fb.get(&u(&a, 1)));
+                fb.remove(&u(&a, 1));
+            }
+            "createRenderbuffer" => {
+                if let Some(o) = g.create_renderbuffer() {
+                    rb.insert(u(&a, 1), o);
+                }
+            }
+            "deleteRenderbuffer" => {
+                g.delete_renderbuffer(rb.get(&u(&a, 1)));
+                rb.remove(&u(&a, 1));
+            }
+            "createVertexArray" => {
+                if let Some(o) = g.create_vertex_array() {
+                    vao.insert(u(&a, 1), o);
+                }
+            }
+            "deleteVertexArray" => {
+                g.delete_vertex_array(vao.get(&u(&a, 1)));
+                vao.remove(&u(&a, 1));
+            }
+            "createShader" => {
+                if let Some(o) = g.create_shader(u(&a, 1)) {
+                    sh.insert(u(&a, 2), o);
+                }
+            }
+            "deleteShader" => {
+                g.delete_shader(sh.get(&u(&a, 1)));
+                sh.remove(&u(&a, 1));
+            }
+            "shaderSource" => {
+                if let Some(o) = sh.get(&u(&a, 1)) {
+                    g.shader_source(o, &s(&a, 2));
+                }
+            }
+            "compileShader" => {
+                if let Some(o) = sh.get(&u(&a, 1)) {
+                    g.compile_shader(o);
+                }
+            }
+            "createProgram" => {
+                if let Some(o) = g.create_program() {
+                    prog.insert(u(&a, 1), o);
+                }
+            }
+            "deleteProgram" => {
+                g.delete_program(prog.get(&u(&a, 1)));
+                prog.remove(&u(&a, 1));
+            }
+            "attachShader" => {
+                if let (Some(p), Some(x)) = (prog.get(&u(&a, 1)), sh.get(&u(&a, 2))) {
+                    g.attach_shader(p, x);
+                }
+            }
+            "linkProgram" => {
+                let p = u(&a, 1);
+                if let Some(o) = prog.get(&p) {
+                    g.link_program(o);
+                }
+                loc.retain(|k, _| k.0 != p);
+            }
+            "useProgram" => g.use_program(opt(&a, 1).and_then(|p| prog.get(&p))),
+            "uniform1i" => g.uniform1i(get_loc(u(&a, 1), s(&a, 2)).as_ref(), i(&a, 3)),
+            "uniform1iv" => {
+                let v: Vec<i32> = fs(&a, 3).iter().map(|x| *x as i32).collect();
+                g.uniform1iv_with_i32_array(get_loc(u(&a, 1), s(&a, 2)).as_ref(), &v)
+            }
+            "uniform1f" => g.uniform1f(get_loc(u(&a, 1), s(&a, 2)).as_ref(), f(&a, 3)),
+            "uniform2f" => g.uniform2f(get_loc(u(&a, 1), s(&a, 2)).as_ref(), f(&a, 3), f(&a, 4)),
+            "uniform3f" => g.uniform3f(get_loc(u(&a, 1), s(&a, 2)).as_ref(), f(&a, 3), f(&a, 4), f(&a, 5)),
+            "uniform4f" => g.uniform4f(get_loc(u(&a, 1), s(&a, 2)).as_ref(), f(&a, 3), f(&a, 4), f(&a, 5), f(&a, 6)),
+            "uniform1fv" => g.uniform1fv_with_f32_array(get_loc(u(&a, 1), s(&a, 2)).as_ref(), &fs(&a, 3)),
+            "uniform3fv" => g.uniform3fv_with_f32_array(get_loc(u(&a, 1), s(&a, 2)).as_ref(), &fs(&a, 3)),
+            "uniform4fv" => g.uniform4fv_with_f32_array(get_loc(u(&a, 1), s(&a, 2)).as_ref(), &fs(&a, 3)),
+            "uniformMatrix4fv" => g.uniform_matrix4fv_with_f32_array(get_loc(u(&a, 1), s(&a, 2)).as_ref(), b(&a, 3), &fs(&a, 4)),
+            "bindBuffer" => g.bind_buffer(u(&a, 1), opt(&a, 2).and_then(|x| buf.get(&x))),
+            "bufferData" => g.buffer_data_with_u8_array(u(&a, 1), &bytes(&a, 2).unwrap_or_default(), u(&a, 3)),
+            "bindVertexArray" => g.bind_vertex_array(opt(&a, 1).and_then(|x| vao.get(&x))),
+            "enableVertexAttribArray" => g.enable_vertex_attrib_array(u(&a, 1)),
+            "disableVertexAttribArray" => g.disable_vertex_attrib_array(u(&a, 1)),
+            "vertexAttribPointer" => g.vertex_attrib_pointer_with_i32(u(&a, 1), i(&a, 2), u(&a, 3), b(&a, 4), i(&a, 5), i(&a, 6)),
+            "activeTexture" => g.active_texture(u(&a, 1)),
+            "bindTexture" => g.bind_texture(u(&a, 1), opt(&a, 2).and_then(|x| tex.get(&x))),
+            "texParameteri" => g.tex_parameteri(u(&a, 1), u(&a, 2), i(&a, 3)),
+            "pixelStorei" => g.pixel_storei(u(&a, 1), i(&a, 2)),
+            "texImage2D" => {
+                let px = bytes(&a, 9);
+                let _ = g.tex_image_2d_with_i32_and_i32_and_i32_and_format_and_type_and_opt_u8_array(
+                    u(&a, 1),
+                    i(&a, 2),
+                    i(&a, 3),
+                    i(&a, 4),
+                    i(&a, 5),
+                    i(&a, 6),
+                    u(&a, 7),
+                    u(&a, 8),
+                    px.as_deref(),
+                );
+            }
+            "generateMipmap" => g.generate_mipmap(u(&a, 1)),
+            "copyTexSubImage2D" => g.copy_tex_sub_image_2d(u(&a, 1), i(&a, 2), i(&a, 3), i(&a, 4), i(&a, 5), i(&a, 6), i(&a, 7), i(&a, 8)),
+            "bindFramebuffer" => g.bind_framebuffer(u(&a, 1), opt(&a, 2).and_then(|x| fb.get(&x))),
+            "framebufferTexture2D" => g.framebuffer_texture_2d(u(&a, 1), u(&a, 2), u(&a, 3), opt(&a, 4).and_then(|x| tex.get(&x)), i(&a, 5)),
+            "bindRenderbuffer" => g.bind_renderbuffer(u(&a, 1), opt(&a, 2).and_then(|x| rb.get(&x))),
+            "renderbufferStorage" => g.renderbuffer_storage(u(&a, 1), u(&a, 2), i(&a, 3), i(&a, 4)),
+            "framebufferRenderbuffer" => g.framebuffer_renderbuffer(u(&a, 1), u(&a, 2), u(&a, 3), opt(&a, 4).and_then(|x| rb.get(&x))),
+            "blitFramebuffer" => g.blit_framebuffer(i(&a, 1), i(&a, 2), i(&a, 3), i(&a, 4), i(&a, 5), i(&a, 6), i(&a, 7), i(&a, 8), u(&a, 9), u(&a, 10)),
+            "enable" => g.enable(u(&a, 1)),
+            "disable" => g.disable(u(&a, 1)),
+            "viewport" => g.viewport(i(&a, 1), i(&a, 2), i(&a, 3), i(&a, 4)),
+            "scissor" => g.scissor(i(&a, 1), i(&a, 2), i(&a, 3), i(&a, 4)),
+            "clearColor" => g.clear_color(f(&a, 1), f(&a, 2), f(&a, 3), f(&a, 4)),
+            "clearDepth" => g.clear_depth(f(&a, 1)),
+            "clear" => g.clear(u(&a, 1)),
+            "depthFunc" => g.depth_func(u(&a, 1)),
+            "depthMask" => g.depth_mask(b(&a, 1)),
+            "colorMask" => g.color_mask(b(&a, 1), b(&a, 2), b(&a, 3), b(&a, 4)),
+            "cullFace" => g.cull_face(u(&a, 1)),
+            "frontFace" => g.front_face(u(&a, 1)),
+            "polygonOffset" => g.polygon_offset(f(&a, 1), f(&a, 2)),
+            "blendFunc" => g.blend_func(u(&a, 1), u(&a, 2)),
+            "blendFuncSeparate" => g.blend_func_separate(u(&a, 1), u(&a, 2), u(&a, 3), u(&a, 4)),
+            "blendEquation" => g.blend_equation(u(&a, 1)),
+            "blendEquationSeparate" => g.blend_equation_separate(u(&a, 1), u(&a, 2)),
+            "drawArrays" | "drawElements" => {
+                let in_target = frame == target_frame;
+                if in_target && stop_after.is_some_and(|k| draws >= k) {
+                    draws += 1;
+                    continue;
+                }
+                let snapshot = |g: &GL| -> Option<std::sync::Arc<Vec<u8>>> {
+                    let (w, h, px) = g.soft_texture_pixels(tex.get(&result_tex)?)?;
+                    ((w, h) == (rw, rh)).then_some(px)
+                };
+                let before = if in_target { snapshot(g) } else { None };
+                if name == "drawArrays" {
+                    g.draw_arrays(u(&a, 1), i(&a, 2), i(&a, 3));
+                } else {
+                    g.draw_elements_with_i32(u(&a, 1), i(&a, 2), u(&a, 3), i(&a, 4));
+                }
+                if in_target {
+                    if let (Some(p), Some(q)) = (before, snapshot(g)) {
+                        for k in 0..n {
+                            if p[k * 4..k * 4 + 4] != q[k * 4..k * 4 + 4] {
+                                owner[k] = draws as i32;
+                            }
+                        }
+                    }
+                    draws += 1;
+                }
+            }
+            _ => {}
+        }
+    }
+    let g = gl.ok_or("no context in the trace")?;
+    let t = tex.get(&result_tex).ok_or("result texture not in the trace")?;
+    let (w, h, px) = g.soft_texture_pixels(t).ok_or("result texture has no image")?;
+    Ok(Replay { width: w, height: h, pixels: px.as_ref().clone(), owner, draws, frame: target_frame })
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/state.rs b/vm-rust/src/rendering_gpu/softgl/state.rs
new file mode 100644
index 00000000..be9a7471
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/state.rs
@@ -0,0 +1,851 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the software WebGL2 context's objects and state, and what each
+//! call does to them. Drawing itself is `raster.rs`; the programs are `programs.rs`.
+
+use std::collections::HashMap;
+use std::rc::Rc;
+use std::sync::Arc;
+
+use super::gl::{JsValue, WebGl2RenderingContext as GL, WebGlUniformLocation};
+use super::programs::{self, ProgramKind};
+use super::raster::{self, AttribSource, BlendState, Primitive, RasterState, Target};
+use super::texture::SamplerTex;
+
+pub const MAX_ATTRIBS: usize = 16;
+pub const MAX_UNITS: usize = 8;
+
+#[derive(Clone, Copy, Default)]
+pub struct Attrib {
+    pub enabled: bool,
+    pub buffer: Option<u32>,
+    pub size: i32,
+    pub kind: u32,
+    pub normalized: bool,
+    pub stride: i32,
+    pub offset: i32,
+}
+
+#[derive(Default)]
+pub struct VertexArray {
+    pub attribs: [Attrib; MAX_ATTRIBS],
+    pub element_buffer: Option<u32>,
+}
+
+pub struct Texture {
+    /// Level `i` is `sizes[i]`, RGBA8, rows bottom-up (row 0 is t = 0), as GL keeps them.
+    pub levels: Vec<Arc<Vec<u8>>>,
+    pub sizes: Vec<(u32, u32)>,
+    pub min_filter: u32,
+    pub mag_filter: u32,
+    pub wrap_s: u32,
+    pub wrap_t: u32,
+    pub target: u32,
+}
+
+impl Texture {
+    fn new() -> Texture {
+        Texture {
+            levels: Vec::new(),
+            sizes: Vec::new(),
+            // The GL defaults.
+            min_filter: GL::NEAREST_MIPMAP_LINEAR,
+            mag_filter: GL::LINEAR,
+            wrap_s: GL::REPEAT,
+            wrap_t: GL::REPEAT,
+            target: 0,
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct Renderbuffer {
+    pub width: u32,
+    pub height: u32,
+    pub depth: Vec<f32>,
+}
+
+#[derive(Default, Clone, Copy)]
+pub struct Framebuffer {
+    pub color: Option<u32>,
+    pub color_level: i32,
+    pub depth: Option<u32>,
+}
+
+pub struct ShaderObj {
+    pub kind: u32,
+    pub source: String,
+    pub compiled: bool,
+}
+
+pub struct ProgramObj {
+    pub shaders: Vec<u32>,
+    pub kind: Option<ProgramKind>,
+    pub linked: bool,
+    pub log: String,
+    pub uniforms: HashMap<Rc<str>, Vec<f32>>,
+}
+
+pub struct State {
+    next_id: u32,
+    pub buffers: HashMap<u32, Vec<u8>>,
+    pub textures: HashMap<u32, Texture>,
+    pub renderbuffers: HashMap<u32, Renderbuffer>,
+    pub framebuffers: HashMap<u32, Framebuffer>,
+    pub vaos: HashMap<u32, VertexArray>,
+    pub shaders: HashMap<u32, ShaderObj>,
+    pub programs: HashMap<u32, ProgramObj>,
+
+    // The default framebuffer (`bindFramebuffer(.., null)`).
+    pub default_size: (u32, u32),
+    pub default_color: Arc<Vec<u8>>,
+    pub default_depth: Vec<f32>,
+
+    // Bindings.
+    pub array_buffer: Option<u32>,
+    /// 0 is the default vertex array.
+    pub vao: u32,
+    pub active_unit: usize,
+    pub units_2d: [Option<u32>; MAX_UNITS],
+    pub units_cube: [Option<u32>; MAX_UNITS],
+    pub draw_fb: Option<u32>,
+    pub read_fb: Option<u32>,
+    pub renderbuffer: Option<u32>,
+    pub program: Option<u32>,
+
+    // Fixed-function state, with the GL defaults.
+    pub viewport: [i32; 4],
+    pub scissor: [i32; 4],
+    pub scissor_test: bool,
+    pub depth_test: bool,
+    pub depth_func: u32,
+    pub depth_mask: bool,
+    pub blend: bool,
+    pub blend_func: [u32; 4],
+    pub blend_equation: [u32; 2],
+    pub cull: bool,
+    pub cull_mode: u32,
+    pub front_face: u32,
+    pub color_mask: [bool; 4],
+    pub clear_color: [f32; 4],
+    pub clear_depth: f32,
+    pub polygon_offset_fill: bool,
+    pub polygon_offset: [f32; 2],
+
+    stats_triangles: u64,
+    stats_pixels: u64,
+    unknown_programs: Vec<String>,
+    /// Draws set up but not yet drawn: their pixels are written together, across threads, when
+    /// anything could see or change the draw framebuffer (`flush`).
+    pending: Vec<raster::DrawCmd>,
+}
+
+fn split_uniform_name(name: &str) -> (String, usize) {
+    if let Some(open) = name.find('[') {
+        let base = &name[..open];
+        let idx = name[open + 1..].trim_end_matches(']').parse().unwrap_or(0);
+        (base.to_string(), idx)
+    } else {
+        (name.to_string(), 0)
+    }
+}
+
+impl State {
+    pub fn new(width: u32, height: u32) -> State {
+        let mut vaos = HashMap::new();
+        vaos.insert(0, VertexArray::default());
+        State {
+            next_id: 1,
+            buffers: HashMap::new(),
+            textures: HashMap::new(),
+            renderbuffers: HashMap::new(),
+            framebuffers: HashMap::new(),
+            vaos,
+            shaders: HashMap::new(),
+            programs: HashMap::new(),
+            default_size: (width, height),
+            default_color: Arc::new(vec![0; (width * height * 4) as usize]),
+            default_depth: vec![1.0; (width * height) as usize],
+            array_buffer: None,
+            vao: 0,
+            active_unit: 0,
+            units_2d: [None; MAX_UNITS],
+            units_cube: [None; MAX_UNITS],
+            draw_fb: None,
+            read_fb: None,
+            renderbuffer: None,
+            program: None,
+            viewport: [0, 0, width as i32, height as i32],
+            scissor: [0, 0, width as i32, height as i32],
+            scissor_test: false,
+            depth_test: false,
+            depth_func: GL::LESS,
+            depth_mask: true,
+            blend: false,
+            blend_func: [GL::ONE, GL::ZERO, GL::ONE, GL::ZERO],
+            blend_equation: [GL::FUNC_ADD, GL::FUNC_ADD],
+            cull: false,
+            cull_mode: GL::BACK,
+            front_face: GL::CCW,
+            color_mask: [true; 4],
+            clear_color: [0.0; 4],
+            clear_depth: 1.0,
+            polygon_offset_fill: false,
+            polygon_offset: [0.0, 0.0],
+            stats_triangles: 0,
+            stats_pixels: 0,
+            unknown_programs: Vec::new(),
+            pending: Vec::new(),
+        }
+    }
+
+    fn id(&mut self) -> u32 {
+        let id = self.next_id;
+        self.next_id += 1;
+        id
+    }
+
+    // ---- objects ----
+    pub fn create_buffer(&mut self) -> u32 {
+        let id = self.id();
+        self.buffers.insert(id, Vec::new());
+        id
+    }
+    pub fn delete_buffer(&mut self, id: u32) {
+        self.buffers.remove(&id);
+        if self.array_buffer == Some(id) {
+            self.array_buffer = None;
+        }
+    }
+    pub fn create_texture(&mut self) -> u32 {
+        let id = self.id();
+        self.textures.insert(id, Texture::new());
+        id
+    }
+    pub fn delete_texture(&mut self, id: u32) {
+        self.flush();
+        self.textures.remove(&id);
+        for u in self.units_2d.iter_mut().chain(self.units_cube.iter_mut()) {
+            if *u == Some(id) {
+                *u = None;
+            }
+        }
+    }
+    pub fn create_framebuffer(&mut self) -> u32 {
+        let id = self.id();
+        self.framebuffers.insert(id, Framebuffer::default());
+        id
+    }
+    pub fn delete_framebuffer(&mut self, id: u32) {
+        self.flush();
+        self.framebuffers.remove(&id);
+        if self.draw_fb == Some(id) {
+            self.draw_fb = None;
+        }
+        if self.read_fb == Some(id) {
+            self.read_fb = None;
+        }
+    }
+    pub fn create_renderbuffer(&mut self) -> u32 {
+        let id = self.id();
+        self.renderbuffers.insert(id, Renderbuffer::default());
+        id
+    }
+    pub fn delete_renderbuffer(&mut self, id: u32) {
+        self.flush();
+        self.renderbuffers.remove(&id);
+    }
+    pub fn create_vertex_array(&mut self) -> u32 {
+        let id = self.id();
+        self.vaos.insert(id, VertexArray::default());
+        id
+    }
+    pub fn delete_vertex_array(&mut self, id: u32) {
+        if id != 0 {
+            self.vaos.remove(&id);
+            if self.vao == id {
+                self.vao = 0;
+            }
+        }
+    }
+    pub fn create_shader(&mut self, kind: u32) -> u32 {
+        let id = self.id();
+        self.shaders.insert(id, ShaderObj { kind, source: String::new(), compiled: false });
+        id
+    }
+    pub fn delete_shader(&mut self, id: u32) {
+        self.shaders.remove(&id);
+    }
+    pub fn shader_source(&mut self, id: u32, source: &str) {
+        if let Some(s) = self.shaders.get_mut(&id) {
+            s.source = source.to_string();
+        }
+    }
+    pub fn compile_shader(&mut self, id: u32) {
+        if let Some(s) = self.shaders.get_mut(&id) {
+            // Nothing is compiled: the program is recognised when it is linked.
+            s.compiled = !s.source.is_empty();
+        }
+    }
+    pub fn shader_parameter(&self, id: u32, pname: u32) -> JsValue {
+        match (self.shaders.get(&id), pname) {
+            (Some(s), GL::COMPILE_STATUS) => JsValue::Bool(s.compiled),
+            _ => JsValue::Undefined,
+        }
+    }
+    pub fn shader_log(&self, _id: u32) -> String {
+        String::new()
+    }
+    pub fn create_program(&mut self) -> u32 {
+        let id = self.id();
+        self.programs.insert(
+            id,
+            ProgramObj { shaders: Vec::new(), kind: None, linked: false, log: String::new(), uniforms: HashMap::new() },
+        );
+        id
+    }
+    pub fn delete_program(&mut self, id: u32) {
+        self.programs.remove(&id);
+        if self.program == Some(id) {
+            self.program = None;
+        }
+    }
+    pub fn attach_shader(&mut self, p: u32, s: u32) {
+        if let Some(prog) = self.programs.get_mut(&p) {
+            prog.shaders.push(s);
+        }
+    }
+    pub fn link_program(&mut self, p: u32) {
+        let mut vs = String::new();
+        let mut fs = String::new();
+        if let Some(prog) = self.programs.get(&p) {
+            for s in &prog.shaders {
+                if let Some(sh) = self.shaders.get(s) {
+                    if sh.kind == GL::VERTEX_SHADER {
+                        vs = sh.source.clone();
+                    } else {
+                        fs = sh.source.clone();
+                    }
+                }
+            }
+        }
+        let (kind, note) = programs::recognise(&vs, &fs);
+        if let Some(note) = note {
+            self.unknown_programs.push(note);
+        }
+        if let Some(prog) = self.programs.get_mut(&p) {
+            prog.kind = kind;
+            prog.linked = kind.is_some();
+            prog.log = if kind.is_some() {
+                String::new()
+            } else {
+                "no software port of this program".to_string()
+            };
+        }
+    }
+    pub fn program_parameter(&self, id: u32, pname: u32) -> JsValue {
+        match (self.programs.get(&id), pname) {
+            (Some(p), GL::LINK_STATUS) => JsValue::Bool(p.linked),
+            _ => JsValue::Undefined,
+        }
+    }
+    pub fn program_log(&self, id: u32) -> String {
+        self.programs.get(&id).map(|p| p.log.clone()).unwrap_or_default()
+    }
+    pub fn use_program(&mut self, p: Option<u32>) {
+        self.program = p;
+    }
+    pub fn uniform_location(&self, p: u32, name: &str) -> Option<WebGlUniformLocation> {
+        let prog = self.programs.get(&p)?;
+        if !prog.linked {
+            return None;
+        }
+        let (base, index) = split_uniform_name(name);
+        Some(WebGlUniformLocation { program: p, name: Rc::from(base.as_str()), index, full: Rc::from(name) })
+    }
+    /// `uniform*` on the program in use. As in WebGL, a location of another program is an
+    /// error (INVALID_OPERATION) and changes nothing.
+    pub fn set_uniform(&mut self, l: Option<&WebGlUniformLocation>, values: &[f32]) {
+        let Some(l) = l else { return };
+        if self.program != Some(l.program) {
+            return;
+        }
+        let Some(prog) = self.programs.get_mut(&l.program) else { return };
+        let start = l.index * programs::element_size(&l.name);
+        let slot = prog.uniforms.entry(l.name.clone()).or_default();
+        if slot.len() < start + values.len() {
+            slot.resize(start + values.len(), 0.0);
+        }
+        slot[start..start + values.len()].copy_from_slice(values);
+    }
+
+    // ---- buffers ----
+    pub fn bind_buffer(&mut self, target: u32, b: Option<u32>) {
+        match target {
+            GL::ARRAY_BUFFER => self.array_buffer = b,
+            GL::ELEMENT_ARRAY_BUFFER => {
+                if let Some(vao) = self.vaos.get_mut(&self.vao) {
+                    vao.element_buffer = b;
+                }
+            }
+            _ => {}
+        }
+    }
+    pub fn buffer_data(&mut self, target: u32, data: &[u8]) {
+        let id = match target {
+            GL::ARRAY_BUFFER => self.array_buffer,
+            GL::ELEMENT_ARRAY_BUFFER => self.vaos.get(&self.vao).and_then(|v| v.element_buffer),
+            _ => None,
+        };
+        if let Some(buf) = id.and_then(|id| self.buffers.get_mut(&id)) {
+            buf.clear();
+            buf.extend_from_slice(data);
+        }
+    }
+    pub fn bind_vertex_array(&mut self, v: Option<u32>) {
+        self.vao = v.filter(|v| self.vaos.contains_key(v)).unwrap_or(0);
+    }
+    pub fn set_attrib_enabled(&mut self, index: u32, on: bool) {
+        if let Some(vao) = self.vaos.get_mut(&self.vao) {
+            if let Some(a) = vao.attribs.get_mut(index as usize) {
+                a.enabled = on;
+            }
+        }
+    }
+    pub fn attrib_pointer(&mut self, index: u32, size: i32, kind: u32, normalized: bool, stride: i32, offset: i32) {
+        let buffer = self.array_buffer;
+        if let Some(vao) = self.vaos.get_mut(&self.vao) {
+            if let Some(a) = vao.attribs.get_mut(index as usize) {
+                a.buffer = buffer;
+                a.size = size;
+                a.kind = kind;
+                a.normalized = normalized;
+                a.stride = stride;
+                a.offset = offset;
+            }
+        }
+    }
+
+    // ---- textures ----
+    pub fn active_texture(&mut self, unit: u32) {
+        self.active_unit = (unit.saturating_sub(GL::TEXTURE0) as usize).min(MAX_UNITS - 1);
+    }
+    pub fn bind_texture(&mut self, target: u32, t: Option<u32>) {
+        let u = self.active_unit;
+        match target {
+            GL::TEXTURE_2D => self.units_2d[u] = t,
+            GL::TEXTURE_CUBE_MAP => self.units_cube[u] = t,
+            _ => {}
+        }
+        if let Some(tex) = t.and_then(|t| self.textures.get_mut(&t)) {
+            if tex.target == 0 {
+                tex.target = target;
+            }
+        }
+    }
+    fn bound_texture(&self, target: u32) -> Option<u32> {
+        match target {
+            GL::TEXTURE_2D => self.units_2d[self.active_unit],
+            GL::TEXTURE_CUBE_MAP
+            | GL::TEXTURE_CUBE_MAP_POSITIVE_X
+            | GL::TEXTURE_CUBE_MAP_NEGATIVE_X
+            | GL::TEXTURE_CUBE_MAP_POSITIVE_Y
+            | GL::TEXTURE_CUBE_MAP_NEGATIVE_Y
+            | GL::TEXTURE_CUBE_MAP_POSITIVE_Z
+            | GL::TEXTURE_CUBE_MAP_NEGATIVE_Z => self.units_cube[self.active_unit],
+            _ => None,
+        }
+    }
+    pub fn tex_parameter(&mut self, target: u32, pname: u32, value: i32) {
+        let Some(id) = self.bound_texture(target) else { return };
+        let Some(tex) = self.textures.get_mut(&id) else { return };
+        let v = value as u32;
+        match pname {
+            GL::TEXTURE_MIN_FILTER => tex.min_filter = v,
+            GL::TEXTURE_MAG_FILTER => tex.mag_filter = v,
+            GL::TEXTURE_WRAP_S => tex.wrap_s = v,
+            GL::TEXTURE_WRAP_T => tex.wrap_t = v,
+            _ => {}
+        }
+    }
+    pub fn pixel_store(&mut self, _pname: u32, _value: i32) {
+        // UNPACK_PREMULTIPLY_ALPHA_WEBGL 0 is the default and the only value the renderer
+        // sets; tightly packed RGBA rows need no alignment.
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn tex_image_2d(&mut self, target: u32, level: i32, width: i32, height: i32, format: u32, kind: u32, pixels: Option<&[u8]>) -> Result<(), JsValue> {
+        self.flush();
+        if target != GL::TEXTURE_2D {
+            // Cube map faces: kept by nothing (no program here samples a cube map).
+            return Ok(());
+        }
+        if format != GL::RGBA || kind != GL::UNSIGNED_BYTE || width < 0 || height < 0 || level < 0 {
+            return Err(JsValue::from_str("texImage2D: only RGBA / UNSIGNED_BYTE"));
+        }
+        let Some(id) = self.bound_texture(target) else {
+            return Err(JsValue::from_str("texImage2D: no texture bound"));
+        };
+        let Some(tex) = self.textures.get_mut(&id) else { return Ok(()) };
+        let (w, h) = (width as u32, height as u32);
+        let n = (w as usize) * (h as usize) * 4;
+        let data = match pixels {
+            Some(p) if p.len() >= n => p[..n].to_vec(),
+            Some(p) => {
+                let mut d = p.to_vec();
+                d.resize(n, 0);
+                d
+            }
+            None => vec![0; n],
+        };
+        let level = level as usize;
+        if level == 0 {
+            // A new base image: the mip levels made for the old one no longer fit it.
+            tex.levels.clear();
+            tex.sizes.clear();
+        }
+        if tex.levels.len() < level + 1 {
+            tex.levels.resize(level + 1, Arc::new(Vec::new()));
+            tex.sizes.resize(level + 1, (0, 0));
+        }
+        tex.levels[level] = Arc::new(data);
+        tex.sizes[level] = (w, h);
+        Ok(())
+    }
+    pub fn generate_mipmap(&mut self, target: u32) {
+        self.flush();
+        if target != GL::TEXTURE_2D {
+            return;
+        }
+        let Some(id) = self.bound_texture(target) else { return };
+        let Some(tex) = self.textures.get_mut(&id) else { return };
+        if tex.levels.is_empty() {
+            return;
+        }
+        let (mut w, mut h) = tex.sizes[0];
+        let mut levels = vec![tex.levels[0].clone()];
+        let mut sizes = vec![(w, h)];
+        while w > 1 || h > 1 {
+            let (nw, nh) = ((w / 2).max(1), (h / 2).max(1));
+            let next = super::texture::downsample(levels.last().unwrap(), w, h, nw, nh);
+            levels.push(Arc::new(next));
+            sizes.push((nw, nh));
+            w = nw;
+            h = nh;
+        }
+        tex.levels = levels;
+        tex.sizes = sizes;
+    }
+
+    // ---- framebuffers ----
+    pub fn bind_framebuffer(&mut self, target: u32, f: Option<u32>) {
+        self.flush();
+        let f = f.filter(|f| self.framebuffers.contains_key(f));
+        match target {
+            GL::FRAMEBUFFER => {
+                self.draw_fb = f;
+                self.read_fb = f;
+            }
+            GL::DRAW_FRAMEBUFFER => self.draw_fb = f,
+            GL::READ_FRAMEBUFFER => self.read_fb = f,
+            _ => {}
+        }
+    }
+    fn fb_for(&self, target: u32) -> Option<u32> {
+        match target {
+            GL::READ_FRAMEBUFFER => self.read_fb,
+            _ => self.draw_fb,
+        }
+    }
+    pub fn framebuffer_texture(&mut self, target: u32, attachment: u32, t: Option<u32>, level: i32) {
+        self.flush();
+        let Some(fb) = self.fb_for(target).and_then(|f| self.framebuffers.get_mut(&f)) else { return };
+        if attachment == GL::COLOR_ATTACHMENT0 {
+            fb.color = t;
+            fb.color_level = level;
+        }
+    }
+    pub fn bind_renderbuffer(&mut self, r: Option<u32>) {
+        self.renderbuffer = r;
+    }
+    pub fn renderbuffer_storage(&mut self, _format: u32, width: i32, height: i32) {
+        self.flush();
+        let Some(rb) = self.renderbuffer.and_then(|r| self.renderbuffers.get_mut(&r)) else { return };
+        rb.width = width.max(0) as u32;
+        rb.height = height.max(0) as u32;
+        rb.depth = vec![1.0; (rb.width * rb.height) as usize];
+    }
+    pub fn framebuffer_renderbuffer(&mut self, target: u32, attachment: u32, r: Option<u32>) {
+        self.flush();
+        let Some(fb) = self.fb_for(target).and_then(|f| self.framebuffers.get_mut(&f)) else { return };
+        if attachment == GL::DEPTH_ATTACHMENT || attachment == GL::DEPTH_STENCIL_ATTACHMENT {
+            fb.depth = r;
+        }
+    }
+
+    /// The colour buffer of framebuffer `fb` (None: the default one): its texture (None for the
+    /// default framebuffer) and size.
+    fn color_of(&self, fb: Option<u32>) -> Option<(Option<u32>, u32, u32)> {
+        match fb {
+            None => Some((None, self.default_size.0, self.default_size.1)),
+            Some(f) => {
+                let fb = self.framebuffers.get(&f)?;
+                let t = fb.color?;
+                let tex = self.textures.get(&t)?;
+                let (w, h) = *tex.sizes.get(fb.color_level as usize)?;
+                Some((Some(t), w, h))
+            }
+        }
+    }
+
+    fn color_pixels(&self, fb: Option<u32>) -> Option<(Arc<Vec<u8>>, u32, u32)> {
+        let (t, w, h) = self.color_of(fb)?;
+        match t {
+            None => Some((self.default_color.clone(), w, h)),
+            Some(t) => {
+                let level = self.framebuffers.get(&fb?)?.color_level as usize;
+                let tex = self.textures.get(&t)?;
+                Some((tex.levels.get(level)?.clone(), w, h))
+            }
+        }
+    }
+
+    pub fn texture_pixels(&mut self, t: u32) -> Option<(u32, u32, Arc<Vec<u8>>)> {
+        self.flush();
+        let tex = self.textures.get(&t)?;
+        let (w, h) = *tex.sizes.first()?;
+        Some((w, h, tex.levels.first()?.clone()))
+    }
+
+    pub fn read_pixels(&mut self, x: i32, y: i32, width: i32, height: i32, out: &mut [u8]) {
+        self.flush();
+        let Some((data, w, h)) = self.color_pixels(self.read_fb) else { return };
+        for row in 0..height.max(0) {
+            for col in 0..width.max(0) {
+                let (sx, sy) = (x + col, y + row);
+                let o = ((row * width + col) * 4) as usize;
+                if o + 4 > out.len() {
+                    return;
+                }
+                if sx >= 0 && sy >= 0 && (sx as u32) < w && (sy as u32) < h {
+                    let i = ((sy as u32 * w + sx as u32) * 4) as usize;
+                    out[o..o + 4].copy_from_slice(&data[i..i + 4]);
+                }
+            }
+        }
+    }
+
+    /// Runs `f` on the draw framebuffer's colour and depth buffers.
+    fn with_draw_target<R>(&mut self, f: impl FnOnce(Target<'_>) -> R) -> Option<R> {
+        let target = draw_target(
+            self.draw_fb,
+            &self.framebuffers,
+            &mut self.textures,
+            &mut self.renderbuffers,
+            &mut self.default_color,
+            &mut self.default_depth,
+            self.default_size,
+        )?;
+        Some(f(target))
+    }
+
+    pub fn clear(&mut self, mask: u32) {
+        self.flush();
+        let rect = if self.scissor_test { Some(self.scissor) } else { None };
+        let cc = self.clear_color;
+        let cm = self.color_mask;
+        let cd = self.clear_depth;
+        let clear_color = mask & GL::COLOR_BUFFER_BIT != 0;
+        let clear_depth = mask & GL::DEPTH_BUFFER_BIT != 0 && self.depth_mask;
+        self.with_draw_target(|t| raster::clear(t, rect, if clear_color { Some((cc, cm)) } else { None }, if clear_depth { Some(cd) } else { None }));
+    }
+
+    pub fn blit_framebuffer(&mut self, src: [i32; 4], dst: [i32; 4], mask: u32, _filter: u32) {
+        self.flush();
+        if mask & GL::COLOR_BUFFER_BIT == 0 {
+            return;
+        }
+        let Some((data, sw, sh)) = self.color_pixels(self.read_fb) else { return };
+        self.with_draw_target(|t| raster::blit(t, &data, sw as usize, sh as usize, src, dst));
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn copy_tex_sub_image_2d(&mut self, target: u32, level: i32, xoff: i32, yoff: i32, x: i32, y: i32, width: i32, height: i32) {
+        self.flush();
+        if target != GL::TEXTURE_2D {
+            return;
+        }
+        let Some((src, sw, sh)) = self.color_pixels(self.read_fb) else { return };
+        let Some(id) = self.bound_texture(target) else { return };
+        let Some(tex) = self.textures.get_mut(&id) else { return };
+        let level = level.max(0) as usize;
+        let Some(&(tw, th)) = tex.sizes.get(level) else { return };
+        let dst = Arc::make_mut(&mut tex.levels[level]);
+        for row in 0..height.max(0) {
+            for col in 0..width.max(0) {
+                let (sx, sy, dx, dy) = (x + col, y + row, xoff + col, yoff + row);
+                if sx < 0 || sy < 0 || dx < 0 || dy < 0 || sx as u32 >= sw || sy as u32 >= sh || dx as u32 >= tw || dy as u32 >= th {
+                    continue;
+                }
+                let si = ((sy as u32 * sw + sx as u32) * 4) as usize;
+                let di = ((dy as u32 * tw + dx as u32) * 4) as usize;
+                dst[di..di + 4].copy_from_slice(&src[si..si + 4]);
+            }
+        }
+    }
+
+    pub fn set_cap(&mut self, cap: u32, on: bool) {
+        match cap {
+            GL::BLEND => self.blend = on,
+            GL::DEPTH_TEST => self.depth_test = on,
+            GL::CULL_FACE => self.cull = on,
+            GL::SCISSOR_TEST => self.scissor_test = on,
+            GL::POLYGON_OFFSET_FILL => self.polygon_offset_fill = on,
+            _ => {}
+        }
+    }
+
+    fn raster_state(&self) -> RasterState {
+        RasterState {
+            viewport: self.viewport,
+            scissor: if self.scissor_test { Some(self.scissor) } else { None },
+            depth_test: self.depth_test,
+            depth_func: self.depth_func,
+            depth_write: self.depth_mask,
+            cull: if self.cull { Some(self.cull_mode) } else { None },
+            front_ccw: self.front_face == GL::CCW,
+            blend: if self.blend {
+                Some(BlendState { func: self.blend_func, equation: self.blend_equation })
+            } else {
+                None
+            },
+            color_mask: self.color_mask,
+            polygon_offset: if self.polygon_offset_fill { Some(self.polygon_offset) } else { None },
+        }
+    }
+
+    /// `drawArrays` (`indices` None) and `drawElements` (`indices` = (type, byte offset)).
+    pub fn draw(&mut self, mode: u32, first: usize, count: usize, indices: Option<(u32, usize)>) {
+        let t0 = std::time::Instant::now();
+        self.draw_inner(mode, first, count, indices);
+        super::TIME_SETUP_NS.fetch_add(t0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+    }
+
+    fn draw_inner(&mut self, mode: u32, first: usize, count: usize, indices: Option<(u32, usize)>) {
+        let Some(pid) = self.program else { return };
+        let Some(prog) = self.programs.get(&pid) else { return };
+        let Some(kind) = prog.kind else { return };
+        let prim = match mode {
+            GL::TRIANGLES => Primitive::Triangles,
+            GL::TRIANGLE_STRIP => Primitive::TriangleStrip,
+            GL::TRIANGLE_FAN => Primitive::TriangleFan,
+            GL::LINES => Primitive::Lines,
+            GL::LINE_STRIP => Primitive::LineStrip,
+            GL::POINTS => Primitive::Points,
+            _ => return,
+        };
+        // The textures each unit holds at the moment of the draw (shared, not copied: a texture
+        // the draw also renders into is copied when it is written, so the draw reads it as it was).
+        let mut samplers: Vec<Option<SamplerTex>> = Vec::with_capacity(MAX_UNITS);
+        for u in 0..MAX_UNITS {
+            samplers.push(self.units_2d[u].and_then(|t| self.textures.get(&t)).map(SamplerTex::from_texture));
+        }
+        let Some(program) = programs::build(kind, &prog.uniforms, samplers) else { return };
+        let rs = self.raster_state();
+
+        let State {
+            buffers, vaos, vao, draw_fb, framebuffers, textures, renderbuffers, default_color, default_depth, default_size, ..
+        } = self;
+        let Some(vao) = vaos.get(vao) else { return };
+        let mut attribs: Vec<Option<AttribSource<'_>>> = Vec::with_capacity(MAX_ATTRIBS);
+        for a in &vao.attribs {
+            let src = if a.enabled {
+                a.buffer.and_then(|b| buffers.get(&b)).map(|data| AttribSource {
+                    data: data.as_slice(),
+                    size: a.size.clamp(1, 4) as usize,
+                    kind: a.kind,
+                    stride: if a.stride > 0 { a.stride as usize } else { a.size.clamp(1, 4) as usize * 4 },
+                    offset: a.offset.max(0) as usize,
+                })
+            } else {
+                None
+            };
+            attribs.push(src);
+        }
+        let index_list: Option<Vec<u32>> = match indices {
+            Some((kind, offset)) => match vao.element_buffer.and_then(|b| buffers.get(&b)) {
+                Some(buf) => Some(raster::read_indices(buf, kind, offset, count)),
+                None => return,
+            },
+            None => None,
+        };
+        let size = match *draw_fb {
+            None => (default_size.0 as usize, default_size.1 as usize),
+            Some(fb_id) => {
+                let Some(fb) = framebuffers.get(&fb_id) else { return };
+                let Some(t) = fb.color else { return };
+                let Some(&(w, h)) = textures.get(&t).and_then(|tex| tex.sizes.get(fb.color_level.max(0) as usize)) else { return };
+                (w as usize, h as usize)
+            }
+        };
+        let _ = (renderbuffers, default_color, default_depth);
+        let Some(cmd) = raster::setup(program, &attribs, prim, first, count, index_list.as_deref(), size, &rs) else { return };
+        self.stats_triangles += cmd.tris;
+        self.pending.push(cmd);
+    }
+
+    /// Writes the pixels of the pending draws into the draw framebuffer.
+    pub fn flush(&mut self) {
+        if self.pending.is_empty() {
+            return;
+        }
+        let cmds = std::mem::take(&mut self.pending);
+        let State { draw_fb, framebuffers, textures, renderbuffers, default_color, default_depth, default_size, .. } = self;
+        if let Some(target) = draw_target(*draw_fb, framebuffers, textures, renderbuffers, default_color, default_depth, *default_size) {
+            let t0 = std::time::Instant::now();
+            self.stats_pixels += raster::execute(&cmds, target);
+            super::TIME_EXEC_NS.fetch_add(t0.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+
+    pub fn take_stats(&mut self) -> (u64, u64) {
+        self.flush();
+        let s = (self.stats_triangles, self.stats_pixels);
+        self.stats_triangles = 0;
+        self.stats_pixels = 0;
+        s
+    }
+
+    pub fn take_unknown_programs(&mut self) -> Vec<String> {
+        std::mem::take(&mut self.unknown_programs)
+    }
+}
+
+/// The draw framebuffer's colour buffer (written copy-on-write: a draw that also samples it
+/// reads it as it was) and its depth buffer, when that is the colour buffer's size.
+fn draw_target<'a>(
+    draw_fb: Option<u32>,
+    framebuffers: &HashMap<u32, Framebuffer>,
+    textures: &'a mut HashMap<u32, Texture>,
+    renderbuffers: &'a mut HashMap<u32, Renderbuffer>,
+    default_color: &'a mut Arc<Vec<u8>>,
+    default_depth: &'a mut Vec<f32>,
+    default_size: (u32, u32),
+) -> Option<Target<'a>> {
+    match draw_fb {
+        None => {
+            let (w, h) = default_size;
+            Some(Target { color: Arc::make_mut(default_color), width: w as usize, height: h as usize, depth: Some(default_depth.as_mut_slice()) })
+        }
+        Some(fb_id) => {
+            let fb = *framebuffers.get(&fb_id)?;
+            let t = fb.color?;
+            let level = fb.color_level.max(0) as usize;
+            let tex = textures.get_mut(&t)?;
+            let (w, h) = *tex.sizes.get(level)?;
+            let color = Arc::make_mut(tex.levels.get_mut(level)?);
+            let depth = match fb.depth.and_then(|d| renderbuffers.get_mut(&d)) {
+                Some(rb) if rb.width == w && rb.height == h => Some(rb.depth.as_mut_slice()),
+                _ => None,
+            };
+            Some(Target { color, width: w as usize, height: h as usize, depth })
+        }
+    }
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/texture.rs b/vm-rust/src/rendering_gpu/softgl/texture.rs
new file mode 100644
index 00000000..38f16854
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/texture.rs
@@ -0,0 +1,272 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: 2D texture sampling as OpenGL ES 3.0 §3.8.10–3.8.11 defines it
+//! for the filters and wrap modes the 3D renderer sets: the level of detail from the texture
+//! coordinates' screen derivatives, NEAREST / LINEAR within a level, the four mipmap filters
+//! between levels, REPEAT / CLAMP_TO_EDGE / MIRRORED_REPEAT; and generateMipmap's 2x2 box filter.
+
+use std::sync::Arc;
+
+use super::gl::WebGl2RenderingContext as GL;
+use super::state::Texture;
+
+/// Samples of incomplete textures (debugging: GL gives them (0, 0, 0, 1)).
+pub static INCOMPLETE_SAMPLES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// One mipmap level: its size and RGBA8 texels, rows bottom-up.
+#[derive(Clone)]
+pub struct Level {
+    pub w: i32,
+    pub h: i32,
+    wf: f32,
+    hf: f32,
+    pub data: Arc<Vec<u8>>,
+}
+
+#[derive(Clone)]
+pub struct SamplerTex {
+    pub levels: Vec<Level>,
+    pub min_filter: u32,
+    pub mag_filter: u32,
+    pub wrap_s: u32,
+    pub wrap_t: u32,
+    /// GL's texture completeness: an incomplete texture samples as (0, 0, 0, 1). A complete
+    /// texture's levels each hold at least w * h * 4 bytes (`texel` relies on it).
+    pub complete: bool,
+}
+
+fn is_mipmap_filter(f: u32) -> bool {
+    matches!(f, GL::NEAREST_MIPMAP_NEAREST | GL::LINEAR_MIPMAP_NEAREST | GL::NEAREST_MIPMAP_LINEAR | GL::LINEAR_MIPMAP_LINEAR)
+}
+
+/// floor(x) as an integer, without a libm call (x86-64 before SSE4.1 has no rounding instruction).
+/// Saturates outside the i32 range (the wrap modes then put it somewhere in the texture).
+#[inline(always)]
+fn ifloor(x: f32) -> i32 {
+    let i = x as i32;
+    i - ((x < i as f32) as i32)
+}
+
+/// log2(x) for normal x > 0, to within 2e-5: the exponent, and a degree-5 polynomial in the
+/// mantissa (a least-squares fit of log2 on [1, 2) at Chebyshev nodes; measured maximum error
+/// 1.44e-5). §3.8.10 lets an implementation approximate the level-of-detail computation.
+#[inline(always)]
+fn fast_log2(x: f32) -> f32 {
+    let bits = x.to_bits();
+    let e = ((bits >> 23) & 0xff) as i32 - 127;
+    let m = f32::from_bits((bits & 0x007f_ffff) | 0x3f80_0000); // in [1, 2)
+    let p = ((((0.043_928_63 * m - 0.409_475_6) * m + 1.610_177_5) * m - 3.520_218_8) * m + 5.069_756_3) * m - 2.794_153_7;
+    e as f32 + p
+}
+
+impl SamplerTex {
+    pub fn from_texture(t: &Texture) -> SamplerTex {
+        let levels: Vec<Level> = t
+            .sizes
+            .iter()
+            .zip(t.levels.iter())
+            .map(|(&(w, h), d)| Level { w: w as i32, h: h as i32, wf: w as f32, hf: h as f32, data: d.clone() })
+            .collect();
+        let fits = |l: &Level| l.w > 0 && l.h > 0 && l.data.len() >= (l.w as usize) * (l.h as usize) * 4;
+        let mut complete = levels.first().is_some_and(fits);
+        if complete && is_mipmap_filter(t.min_filter) {
+            // Every level down to 1x1, each half the one above (rounded down, at least 1).
+            let (mut w, mut h) = (levels[0].w, levels[0].h);
+            let mut i = 0;
+            loop {
+                match levels.get(i) {
+                    Some(l) if l.w == w && l.h == h && fits(l) => {}
+                    _ => {
+                        complete = false;
+                        break;
+                    }
+                }
+                if w == 1 && h == 1 {
+                    break;
+                }
+                w = (w / 2).max(1);
+                h = (h / 2).max(1);
+                i += 1;
+            }
+        }
+        SamplerTex { levels, min_filter: t.min_filter, mag_filter: t.mag_filter, wrap_s: t.wrap_s, wrap_t: t.wrap_t, complete }
+    }
+
+    pub fn size(&self) -> (u32, u32) {
+        self.levels.first().map(|l| (l.w as u32, l.h as u32)).unwrap_or((0, 0))
+    }
+
+    /// λ (log2 of the scale factor ρ) for texture coordinates whose derivatives along the
+    /// window's x and y are (dudx, dvdx) and (dudy, dvdy).
+    #[inline]
+    pub fn lambda(&self, dudx: f32, dvdx: f32, dudy: f32, dvdy: f32) -> f32 {
+        let Some(l0) = self.levels.first() else { return 0.0 };
+        let (w, h) = (l0.wf, l0.hf);
+        let rx = (dudx * w) * (dudx * w) + (dvdx * h) * (dvdx * h);
+        let ry = (dudy * w) * (dudy * w) + (dvdy * h) * (dvdy * h);
+        let rho2 = rx.max(ry);
+        if rho2 <= 0.0 || !rho2.is_finite() {
+            return if rho2.is_finite() { -16.0 } else { 16.0 };
+        }
+        0.5 * fast_log2(rho2)
+    }
+
+    /// The colour at (u, v) with level of detail λ.
+    pub fn sample(&self, u: f32, v: f32, lambda: f32) -> [f32; 4] {
+        if !self.complete {
+            INCOMPLETE_SAMPLES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            return [0.0, 0.0, 0.0, 1.0];
+        }
+        let u = if u.is_finite() { u } else { 0.0 };
+        let v = if v.is_finite() { v } else { 0.0 };
+        // §3.8.11: c = 0.5 when magnifying with LINEAR and minifying with a NEAREST mipmap
+        // filter; otherwise 0.
+        let c = if self.mag_filter == GL::LINEAR && matches!(self.min_filter, GL::NEAREST_MIPMAP_NEAREST | GL::NEAREST_MIPMAP_LINEAR) { 0.5 } else { 0.0 };
+        if lambda <= c {
+            return self.sample_level(0, u, v, self.mag_filter == GL::LINEAR);
+        }
+        let q = self.levels.len() - 1;
+        match self.min_filter {
+            GL::NEAREST => self.sample_level(0, u, v, false),
+            GL::LINEAR => self.sample_level(0, u, v, true),
+            GL::NEAREST_MIPMAP_NEAREST | GL::LINEAR_MIPMAP_NEAREST => {
+                let d = if lambda <= 0.5 { 0 } else { ((lambda + 0.5).ceil() - 1.0) as usize };
+                self.sample_level(d.min(q), u, v, self.min_filter == GL::LINEAR_MIPMAP_NEAREST)
+            }
+            _ => {
+                // NEAREST_MIPMAP_LINEAR / LINEAR_MIPMAP_LINEAR
+                let linear = self.min_filter == GL::LINEAR_MIPMAP_LINEAR;
+                if lambda >= q as f32 {
+                    return self.sample_level(q, u, v, linear);
+                }
+                let d1 = lambda as usize; // λ > 0 here: truncation is floor
+                let f = lambda - d1 as f32;
+                let a = self.sample_level(d1.min(q), u, v, linear);
+                if f <= 0.0 || d1 >= q {
+                    return a;
+                }
+                let b = self.sample_level((d1 + 1).min(q), u, v, linear);
+                [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f, a[3] + (b[3] - a[3]) * f]
+            }
+        }
+    }
+
+    #[inline]
+    fn sample_level(&self, level: usize, u: f32, v: f32, linear: bool) -> [f32; 4] {
+        let l = &self.levels[level];
+        let s = u * l.wf;
+        let t = v * l.hf;
+        if !linear {
+            let x = wrap(ifloor(s), l.w, self.wrap_s);
+            let y = wrap(ifloor(t), l.h, self.wrap_t);
+            return texel(l, y * l.w + x);
+        }
+        let (s, t) = (s - 0.5, t - 0.5);
+        let (i0, j0) = (ifloor(s), ifloor(t));
+        let (a, b) = (s - i0 as f32, t - j0 as f32);
+        let x0 = wrap(i0, l.w, self.wrap_s);
+        let x1 = wrap(i0.wrapping_add(1), l.w, self.wrap_s);
+        let r0 = wrap(j0, l.h, self.wrap_t) * l.w;
+        let r1 = wrap(j0.wrapping_add(1), l.h, self.wrap_t) * l.w;
+        bilerp(l, [r0 + x0, r0 + x1, r1 + x0, r1 + x1], a, b)
+    }
+}
+
+/// The bilinear blend of texels i[0] (x0, y0), i[1] (x1, y0), i[2] (x0, y1), i[3] (x1, y1) with
+/// weights a (along x) and b (along y): per channel, top = p00 + (p10 - p00) a, bottom likewise,
+/// top + (bottom - top) b, on the texels as 0..1 floats.
+#[cfg(not(target_arch = "x86_64"))]
+#[inline(always)]
+fn bilerp(l: &Level, i: [i32; 4], a: f32, b: f32) -> [f32; 4] {
+    let (p00, p10, p01, p11) = (texel(l, i[0]), texel(l, i[1]), texel(l, i[2]), texel(l, i[3]));
+    let mut out = [0.0f32; 4];
+    for k in 0..4 {
+        let top = p00[k] + (p10[k] - p00[k]) * a;
+        let bot = p01[k] + (p11[k] - p01[k]) * a;
+        out[k] = top + (bot - top) * b;
+    }
+    out
+}
+
+/// The same with the four channels in one SSE2 register (x86-64's baseline): the same
+/// operations in the same order per channel, so the same results bit for bit.
+#[cfg(target_arch = "x86_64")]
+#[inline(always)]
+fn bilerp(l: &Level, i: [i32; 4], a: f32, b: f32) -> [f32; 4] {
+    use std::arch::x86_64::*;
+    // SAFETY: SSE2 is part of x86-64. Each texel index is in its level (see `texel`), so the
+    // 4-byte reads are inside the level's data.
+    unsafe {
+        let base = l.data.as_ptr();
+        let k = _mm_set1_ps(1.0 / 255.0);
+        let z = _mm_setzero_si128();
+        let load = |idx: i32| -> __m128 {
+            debug_assert!((idx as usize) * 4 + 4 <= l.data.len());
+            let px = (base.add(idx as usize * 4) as *const i32).read_unaligned();
+            let v = _mm_unpacklo_epi16(_mm_unpacklo_epi8(_mm_cvtsi32_si128(px), z), z);
+            _mm_mul_ps(_mm_cvtepi32_ps(v), k)
+        };
+        let (p00, p10, p01, p11) = (load(i[0]), load(i[1]), load(i[2]), load(i[3]));
+        let va = _mm_set1_ps(a);
+        let vb = _mm_set1_ps(b);
+        let top = _mm_add_ps(p00, _mm_mul_ps(_mm_sub_ps(p10, p00), va));
+        let bot = _mm_add_ps(p01, _mm_mul_ps(_mm_sub_ps(p11, p01), va));
+        let out = _mm_add_ps(top, _mm_mul_ps(_mm_sub_ps(bot, top), vb));
+        let mut r = [0.0f32; 4];
+        _mm_storeu_ps(r.as_mut_ptr(), out);
+        r
+    }
+}
+
+/// Texel `i` (row * w + x, both wrapped into the level) as 0..1 floats.
+#[inline(always)]
+fn texel(l: &Level, i: i32) -> [f32; 4] {
+    let o = (i as usize) * 4;
+    debug_assert!(o + 4 <= l.data.len());
+    // SAFETY: `wrap` puts x in 0..w and y in 0..h, so o + 4 <= w * h * 4, and a complete
+    // texture's level holds at least that many bytes (SamplerTex::complete; nothing samples an
+    // incomplete one).
+    let p = unsafe { l.data.get_unchecked(o..o + 4) };
+    const K: f32 = 1.0 / 255.0;
+    [p[0] as f32 * K, p[1] as f32 * K, p[2] as f32 * K, p[3] as f32 * K]
+}
+
+#[inline(always)]
+fn wrap(i: i32, size: i32, mode: u32) -> i32 {
+    match mode {
+        GL::CLAMP_TO_EDGE => i.clamp(0, size - 1),
+        GL::MIRRORED_REPEAT => {
+            let period = size * 2;
+            let m = i.rem_euclid(period);
+            if m < size { m } else { period - 1 - m }
+        }
+        _ => {
+            if size & (size - 1) == 0 {
+                i & (size - 1)
+            } else {
+                i.rem_euclid(size)
+            }
+        }
+    }
+}
+
+/// One mipmap level from the one above: each texel the average of the 2x2 block it covers
+/// (the 1-texel edge of an odd size is averaged in with its neighbour).
+pub fn downsample(src: &[u8], w: u32, h: u32, nw: u32, nh: u32) -> Vec<u8> {
+    let mut out = vec![0u8; (nw * nh * 4) as usize];
+    let (w, h) = (w as usize, h as usize);
+    for y in 0..nh as usize {
+        let y0 = (y * 2).min(h - 1);
+        let y1 = (y * 2 + 1).min(h - 1);
+        for x in 0..nw as usize {
+            let x0 = (x * 2).min(w - 1);
+            let x1 = (x * 2 + 1).min(w - 1);
+            for k in 0..4 {
+                let sum = src[(y0 * w + x0) * 4 + k] as u32
+                    + src[(y0 * w + x1) * 4 + k] as u32
+                    + src[(y1 * w + x0) * 4 + k] as u32
+                    + src[(y1 * w + x1) * 4 + k] as u32;
+                out[(y * nw as usize + x) * 4 + k] = ((sum + 2) / 4) as u8;
+            }
+        }
+    }
+    out
+}
diff --git a/vm-rust/src/rendering_gpu/softgl/trace.rs b/vm-rust/src/rendering_gpu/softgl/trace.rs
new file mode 100644
index 00000000..1013f0c3
--- /dev/null
+++ b/vm-rust/src/rendering_gpu/softgl/trace.rs
@@ -0,0 +1,168 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: a record of every WebGL call the 3D renderer makes into the
+//! software context, so the same calls can be replayed in a browser's WebGL2 (with the original
+//! GLSL) and the two pictures compared. Off unless DIRPLAYER_SOFTGL_TRACE=<sprite frame>:<file>
+//! is set: then the calls from the context's creation to the end of that 3D sprite frame are
+//! written to <file>, one JSON array per line, and the software result beside it (<file>.rgba).
+
+use std::cell::RefCell;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub static ON: AtomicBool = AtomicBool::new(false);
+
+pub enum J<'a> {
+    U(u32),
+    I(i32),
+    F(f32),
+    B(bool),
+    S(&'a str),
+    Null,
+    Bytes(&'a [u8]),
+    Fs(&'a [f32]),
+}
+
+struct Tracer {
+    target_frame: u64,
+    path: String,
+    frame: u64,
+    lines: Vec<String>,
+    done: bool,
+}
+
+thread_local! {
+    static T: RefCell<Option<Tracer>> = const { RefCell::new(None) };
+}
+
+/// Reads DIRPLAYER_SOFTGL_TRACE once.
+pub fn init() {
+    T.with(|t| {
+        let mut t = t.borrow_mut();
+        if t.is_some() {
+            return;
+        }
+        if let Ok(v) = std::env::var("DIRPLAYER_SOFTGL_TRACE") {
+            if let Some((n, path)) = v.split_once(':') {
+                if let Ok(n) = n.trim().parse::<u64>() {
+                    *t = Some(Tracer { target_frame: n, path: path.to_string(), frame: 0, lines: Vec::new(), done: false });
+                    ON.store(true, Ordering::Relaxed);
+                }
+            }
+        }
+    });
+}
+
+fn num(f: f32) -> String {
+    if f.is_finite() {
+        // Shortest round-trip form.
+        format!("{f:?}")
+    } else {
+        "null".to_string()
+    }
+}
+
+fn esc(s: &str) -> String {
+    let mut o = String::with_capacity(s.len() + 2);
+    o.push('"');
+    for c in s.chars() {
+        match c {
+            '"' => o.push_str("\\\""),
+            '\\' => o.push_str("\\\\"),
+            '\n' => o.push_str("\\n"),
+            '\r' => o.push_str("\\r"),
+            '\t' => o.push_str("\\t"),
+            c if (c as u32) < 0x20 => o.push_str(&format!("\\u{:04x}", c as u32)),
+            c => o.push(c),
+        }
+    }
+    o.push('"');
+    o
+}
+
+pub fn rec(f: &str, args: &[J]) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    T.with(|t| {
+        let mut t = t.borrow_mut();
+        let Some(t) = t.as_mut() else { return };
+        if t.done {
+            return;
+        }
+        let mut line = String::with_capacity(64);
+        line.push('[');
+        line.push_str(&esc(f));
+        for a in args {
+            line.push(',');
+            match a {
+                J::U(v) => line.push_str(&v.to_string()),
+                J::I(v) => line.push_str(&v.to_string()),
+                J::F(v) => line.push_str(&num(*v)),
+                J::B(v) => line.push_str(if *v { "true" } else { "false" }),
+                J::S(s) => line.push_str(&esc(s)),
+                J::Null => line.push_str("null"),
+                J::Bytes(b) => {
+                    use base64::Engine;
+                    line.push_str("{\"b64\":\"");
+                    line.push_str(&base64::engine::general_purpose::STANDARD.encode(b));
+                    line.push_str("\"}");
+                }
+                J::Fs(v) => {
+                    line.push('[');
+                    for (k, x) in v.iter().enumerate() {
+                        if k > 0 {
+                            line.push(',');
+                        }
+                        line.push_str(&num(*x));
+                    }
+                    line.push(']');
+                }
+            }
+        }
+        line.push(']');
+        t.lines.push(line);
+    });
+}
+
+/// A 3D sprite frame begins; true when it is the one being traced.
+pub fn frame_begin() -> bool {
+    if !ON.load(Ordering::Relaxed) {
+        return false;
+    }
+    T.with(|t| {
+        let mut t = t.borrow_mut();
+        let Some(t) = t.as_mut() else { return false };
+        if t.done {
+            return false;
+        }
+        t.frame += 1;
+        t.lines.push(format!("[\"frame\",{}]", t.frame));
+        t.frame == t.target_frame
+    })
+}
+
+/// The traced frame ended: the trace and the software picture of `texture` (w x h RGBA, rows
+/// bottom-up) are written out.
+pub fn frame_end(texture: u32, width: u32, height: u32, pixels: &[u8]) {
+    if !ON.load(Ordering::Relaxed) {
+        return;
+    }
+    T.with(|t| {
+        let mut t = t.borrow_mut();
+        let Some(t) = t.as_mut() else { return };
+        if t.done || t.frame != t.target_frame {
+            return;
+        }
+        t.lines.push(format!("[\"result\",{texture},{width},{height}]"));
+        if let Ok(mut f) = std::fs::File::create(&t.path) {
+            for l in &t.lines {
+                let _ = f.write_all(l.as_bytes());
+                let _ = f.write_all(b"\n");
+            }
+        }
+        let _ = std::fs::write(format!("{}.rgba", t.path), pixels);
+        log::info!("softgl trace: {} calls, frame {} -> {}", t.lines.len(), t.frame, t.path);
+        t.done = true;
+        t.lines = Vec::new();
+        ON.store(false, Ordering::Relaxed);
+    });
+}
