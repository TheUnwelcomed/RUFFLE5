+    /// A step in which the ball touches nothing reports no contact: the previous
+    /// step's contact must not linger (it did, and 3D Golf's ball then never left
+    /// the script's OnGround state).
+    #[test]
+    fn a_free_flight_step_reports_no_contact() {
+        init_symbol_table();
+        let mut state = HavokPhysicsState::default();
+        state.scale = 0.01;
+        state.gravity = [0.0, 0.0, -981.0];
+        let mut rb = HavokRigidBody::new_movable(Symbol::from_str("golf_ball_1"), 1.0, true);
+        rb.position = [0.0, 0.0, 1000.0];
+        rb.linear_velocity = [5000.0, 0.0, 3000.0];
+        rb.active = true;
