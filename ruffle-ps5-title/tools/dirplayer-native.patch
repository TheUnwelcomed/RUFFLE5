+//! PS5_RUFFLE_DIRPLAYER_NATIVE (1.000.036): Flash cast members off the web.
+//!
+//! On the web, DirPlayer's front end gives each Flash sprite a Ruffle player in the page
+//! (src/services/flashPlayerManager.ts) and the VM reaches it through the `dirplayer_*`
+//! JavaScript functions: the externs in datum_handlers/sprite.rs, datum_handlers/flash_object.rs,
+//! handlers/manager.rs, score.rs and player/mod.rs, and `JsApi::dispatch_flash_member_*`. Off the
+//! web the program DirPlayer is embedded in plays them. It installs a [`FlashHost`] with
+//! [`set_host`], and those calls come to it through [`bridge`], each meaning what
+//! flashPlayerManager.ts makes it mean (see the trait's methods).
+//!
+//! The other way: what a Flash movie says to Lingo — `getURL("event:…")`, `getURL("lingo:…")`,
+//! `fscommand(command, args)` — the host hands to [`post`], and `native::run_flash_calls` runs it
+//! (at the start of each native frame, and after each input event), as flashPlayerManager.ts
+//! hands it to `dispatch_flash_event` / `dispatch_flash_lingo`. The host draws each Flash sprite
+//! and gives its picture to `crate::update_flash_frame`, as flashPlayerManager.ts does each
+//! animation frame.
+//!
+//! Without a host the calls answer as the stubs before 1.000.036 did: nothing is there.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+
+use crate::director::lingo::datum::Datum;
+use crate::player::{DatumRef, DirPlayer};
+
+/// A value crossing between Lingo and a Flash movie: what the JavaScript values the web bridge
+/// passes stand for.
+#[derive(Debug, Clone, PartialEq)]
+pub enum FlashValue {
+    Undefined,
+    Null,
+    Bool(bool),
+    Number(f64),
+    String(String),
+    /// An ActionScript object: the path it is reached by in its movie. As an answer, what the web
+    /// bridge marks `__dirplayer_stored_path`; as an argument, a Lingo Flash object handle
+    /// (`"__ruffle_path:…"`).
+    Object(String),
+    /// An ActionScript array.
+    List(Vec<FlashValue>),
+}
+
+/// The JavaScript value tests the bridge's callers make (`is_null`, `as_string`, …): a value answers
+/// only as what it is (a number is no string).
+impl FlashValue {
+    pub fn is_null(&self) -> bool {
+        matches!(self, FlashValue::Null)
+    }
+    pub fn is_undefined(&self) -> bool {
+        matches!(self, FlashValue::Undefined)
+    }
+    pub fn is_string(&self) -> bool {
+        matches!(self, FlashValue::String(_))
+    }
+    pub fn is_object(&self) -> bool {
+        matches!(self, FlashValue::Object(_) | FlashValue::List(_))
+    }
+    pub fn as_string(&self) -> Option<String> {
+        match self {
+            FlashValue::String(s) => Some(s.clone()),
+            _ => None,
+        }
+    }
+    pub fn as_f64(&self) -> Option<f64> {
+        match self {
+            FlashValue::Number(n) => Some(*n),
+            _ => None,
+        }
+    }
+    pub fn as_bool(&self) -> Option<bool> {
+        match self {
+            FlashValue::Bool(b) => Some(*b),
+            _ => None,
+        }
+    }
+
+    /// The value as Flash's `String()` writes it — what Director's getVariable returns by
+    /// default (returnAsString TRUE): "true" / "false", a whole number without a point, else the
+    /// shortest decimal. None for an object, a list, null and undefined.
+    pub fn flash_string(&self) -> Option<String> {
+        match self {
+            FlashValue::String(s) => Some(s.clone()),
+            FlashValue::Bool(b) => Some(if *b { "true".into() } else { "false".into() }),
+            FlashValue::Number(n) => Some(if n.is_nan() {
+                "NaN".into()
+            } else if n.fract() == 0.0 && n.abs() < 1e15 {
+                format!("{}", *n as i64)
+            } else {
+                format!("{n}")
+            }),
+            _ => None,
+        }
+    }
+
+    /// The value as Director's getVariable returns it with returnAsString FALSE: a Boolean as
+    /// 1 / 0, a whole number as an integer, another number as a float, a string as itself. None
+    /// for an object, a list, null and undefined (an object handle then).
+    pub fn lingo_value(&self) -> Option<crate::director::lingo::datum::Datum> {
+        use crate::director::lingo::datum::Datum;
+        match self {
+            FlashValue::String(s) => Some(Datum::String(s.clone())),
+            FlashValue::Bool(b) => Some(Datum::Int(if *b { 1 } else { 0 })),
+            FlashValue::Number(n) => Some(if n.fract() == 0.0 && n.abs() < i32::MAX as f64 { Datum::Int(*n as i32) } else { Datum::Float(*n) }),
+            _ => None,
+        }
+    }
+}
+
+/// A mouse event for a Flash sprite (`dirplayer_ruffleDispatchMouse`'s "move", "down", "up"), and
+/// `Leave` when the mouse leaves the sprite (natively: `native::flash_mouse_move`).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MouseKind {
+    Move,
+    Down,
+    Up,
+    Leave,
+}
+
+/// What the program DirPlayer is embedded in does with Flash sprites. `sprite` is the key the web
+/// bridge uses: the channel number, a synthetic negative one for a Flash member drawn as a
+/// Shockwave 3D texture, or `nested_flash_key` for a sprite of a nested `#movie`; a picture is given
+/// back under the same key (`crate::update_flash_frame`). The methods name the web functions they
+/// stand for (flashPlayerManager.ts).
+pub trait FlashHost {
+    /// `createFlashInstance` (JsApi `onFlashMemberLoaded`): the sprite shows this Flash member
+    /// now: a player of its own for it, replacing the sprite's last one. `width` x `height` is the
+    /// sprite's size; `asserted_frame` (or -1) the frame a script set for the sprite.
+    /// Lingo calls for the sprite that came before (queued) are made once it plays.
+    #[allow(clippy::too_many_arguments)]
+    fn load(&mut self, sprite: i32, cast_lib: i32, cast_member: i32, swf: &[u8], width: u32, height: u32, paused_at_start: bool, asserted_frame: i32);
+    /// `destroyFlashInstance` (`onFlashMemberUnloaded`): the sprite shows no Flash member now.
+    fn unload(&mut self, sprite: i32);
+    /// `destroyAllFlashInstances` (`onFlashResetAll`): a movie went, with all its Flash sprites.
+    fn reset(&mut self);
+    /// `setFlashSize`: the sprite's size on the stage changed.
+    fn set_size(&mut self, sprite: i32, width: i32, height: i32);
+    /// `dirplayer_isFlashInstanceReady`: the sprite has a player that runs its movie.
+    fn is_ready(&mut self, sprite: i32) -> bool;
+    /// `goToFrame` (`sprite.gotoFrame(x)`): to a frame number or label, playing on.
+    fn goto_frame(&mut self, sprite: i32, frame_or_label: &str);
+    /// `goToFrameAndStop` (`sprite.frame = x`): to a frame number or label — stopped there for a
+    /// member that is `pausedAtStart`, playing on otherwise.
+    fn goto_frame_and_stop(&mut self, sprite: i32, frame_or_label: &str);
+    /// `stopFlash`: the root timeline stops (the player goes on).
+    fn stop(&mut self, sprite: i32);
+    /// `playFlash`: the root timeline plays on.
+    fn play(&mut self, sprite: i32);
+    /// `rewindFlash`: to frame 1, stopped.
+    fn rewind(&mut self, sprite: i32);
+    /// `callFrame`: a frame's actions run.
+    fn call_frame(&mut self, sprite: i32, frame: i32);
+    /// `isPlaying` (`sprite.playing`).
+    fn is_playing(&mut self, sprite: i32) -> bool;
+    /// `getFrameCount`.
+    fn frame_count(&mut self, sprite: i32) -> i32;
+    /// `getCurrentFrame`.
+    fn current_frame(&mut self, sprite: i32) -> i32;
+    /// `getVariable`: Null when the sprite has no player yet; else a primitive as it is (the
+    /// caller writes it as Flash's String() does when `returnAsString` asks for text), an object
+    /// as `Object(path)`, Undefined when there is nothing at the path.
+    fn get_variable(&mut self, sprite: i32, path: &str) -> FlashValue;
+    /// `setVariable`: the variable becomes the string (queued until the sprite plays).
+    fn set_variable(&mut self, sprite: i32, path: &str, value: &str) -> bool;
+    /// `callFunction` and a Flash object handle's methods: the function at `path` (the object's
+    /// path, a dot, its name), with the object as `this` (queued until the sprite plays, answering
+    /// Null).
+    fn call_function(&mut self, sprite: i32, path: &str, args: &[FlashValue]) -> FlashValue;
+    /// `newObject(sprite, class, args)`: `new class(args)` in the sprite's movie, kept at `store_at`.
+    /// (Natively only: the web build hands out a handle to a path nothing is at.)
+    fn new_object(&mut self, sprite: i32, class: &str, args: &[FlashValue], store_at: &str) -> bool;
+    /// `hitTest`: what is under a sprite-local point: 0 `#background`, 1 `#normal`, 2 `#button`,
+    /// 3 `#editText`.
+    fn hit_test(&mut self, sprite: i32, x: f64, y: f64) -> i32;
+    /// `dispatchMouseEvent`: a mouse event at a sprite-local point, `sprite_w` x `sprite_h` the
+    /// sprite's size. True when the sprite has a player.
+    fn mouse(&mut self, sprite: i32, kind: MouseKind, x: i32, y: i32, sprite_w: i32, sprite_h: i32) -> bool;
+}
+
+/// What a Flash movie said to Lingo, for [`post`].
+#[derive(Debug, Clone, PartialEq)]
+pub enum FlashCall {
+    /// `getURL("event:…")` (the text after `event:`), or `fscommand(command, args)` as "command
+    /// args": `dispatch_flash_event` — the handler named first, for the sprites showing the member.
+    Event { cast_lib: i32, cast_member: i32, body: String },
+    /// `getURL("lingo:…")` (the text after `lingo:`): `dispatch_flash_lingo` — run as Lingo.
+    Lingo(String),
+}
+
+thread_local! {
+    static HOST: RefCell<Option<Box<dyn FlashHost>>> = const { RefCell::new(None) };
+    static CALLS: RefCell<VecDeque<FlashCall>> = const { RefCell::new(VecDeque::new()) };
+}
+
+/// Installs the host (None: Flash sprites play nothing); answers the one it replaces. Everything
+/// DirPlayer does runs on one thread, and so does this.
+pub fn set_host(host: Option<Box<dyn FlashHost>>) -> Option<Box<dyn FlashHost>> {
+    HOST.with(|h| std::mem::replace(&mut *h.borrow_mut(), host))
+}
+
+pub fn has_host() -> bool {
+    HOST.with(|h| h.try_borrow().map(|h| h.is_some()).unwrap_or(true))
+}
+
+/// `f` on the host; None when there is none (or it is the one calling).
+pub fn with_host<R>(f: impl FnOnce(&mut dyn FlashHost) -> R) -> Option<R> {
+    HOST.with(|h| match h.try_borrow_mut() {
+        Ok(mut h) => h.as_mut().map(|h| f(h.as_mut())),
+        Err(_) => {
+            log::warn!("Flash: the host called back into the Flash bridge; that call does nothing");
+            None
+        }
+    })
+}
+
+/// What a Flash movie said to Lingo: run by `native::run_flash_calls`, in the order posted.
+pub fn post(call: FlashCall) {
+    CALLS.with(|c| c.borrow_mut().push_back(call));
+}
+
+/// The calls posted and not run yet, taken (`native::run_flash_calls` runs them; a host's tests
+/// can look at them).
+pub fn take_calls() -> Vec<FlashCall> {
+    CALLS.with(|c| c.borrow_mut().drain(..).collect())
+}
+
+pub(crate) fn clear_calls() {
+    CALLS.with(|c| c.borrow_mut().clear());
+}
+
+/// A Lingo value as an argument for a Flash function: what `convert_lingo_datum_to_json_inner`
+/// (datum_handlers/flash_object.rs) makes of it for the web bridge (VOID is 0, as Adobe's Flash
+/// Asset Xtra passes it; a symbol is "#name"; a Flash object handle is the object at its path).
+pub fn flash_arg(player: &DirPlayer, datum: &Datum) -> FlashValue {
+    match datum {
+        Datum::Int(i) => FlashValue::Number(*i as f64),
+        Datum::Float(f) => FlashValue::Number(*f),
+        Datum::String(s) => FlashValue::String(s.clone()),
+        Datum::Symbol(s) => FlashValue::String(format!("#{s}")),
+        Datum::Void => FlashValue::Number(0.0),
+        Datum::FlashObjectRef(r) => FlashValue::Object(r.path.clone()),
+        Datum::List(_, items, _) => FlashValue::List(items.iter().map(|i| flash_arg(player, player.get_datum(i))).collect()),
+        _ => FlashValue::Null,
+    }
+}
+
+pub fn flash_args(player: &DirPlayer, args: &[DatumRef]) -> Vec<FlashValue> {
+    args.iter().map(|a| flash_arg(player, player.get_datum(a))).collect()
+}
+
+/// The web bridge's argument list (a JSON array, flashPlayerManager.ts `callFunction`): a null
+/// argument is undefined, `"__ruffle_path:p"` (or `{"__ruffle_path": p}`) the object at `p`.
+pub fn parse_args(json: &str) -> Result<Vec<FlashValue>, String> {
+    if json.trim().is_empty() {
+        return Ok(Vec::new());
+    }
+    let value: serde_json::Value = serde_json::from_str(json).map_err(|e| format!("arguments {json:?}: {e}"))?;
+    let serde_json::Value::Array(items) = value else {
+        return Err(format!("arguments {json:?}: not a list"));
+    };
+    Ok(items
+        .iter()
+        .map(|v| match v {
+            serde_json::Value::Null => FlashValue::Undefined,
+            v => from_json(v),
+        })
+        .collect())
+}
+
+fn from_json(v: &serde_json::Value) -> FlashValue {
+    match v {
+        serde_json::Value::Null => FlashValue::Null,
+        serde_json::Value::Bool(b) => FlashValue::Bool(*b),
+        serde_json::Value::Number(n) => FlashValue::Number(n.as_f64().unwrap_or(0.0)),
+        serde_json::Value::String(s) => match s.strip_prefix("__ruffle_path:") {
+            Some(path) => FlashValue::Object(path.to_string()),
+            None => FlashValue::String(s.clone()),
+        },
+        serde_json::Value::Array(items) => FlashValue::List(items.iter().map(from_json).collect()),
+        serde_json::Value::Object(map) => match (map.len(), map.get("__ruffle_path")) {
+            (1, Some(serde_json::Value::String(path))) => FlashValue::Object(path.clone()),
+            _ => FlashValue::Null,
+        },
+    }
+}
+
+/// The calls the bridge's callers make, with the signatures of the web externs (a `Result` where
+/// the extern has `catch`: Err only when there is no host, as before 1.000.036).
+pub mod bridge {
+    use super::*;
+
+    const NO_HOST: FlashValue = FlashValue::Undefined;
+
+    pub fn get_variable(sprite: i32, path: &str) -> Result<FlashValue, FlashValue> {
+        with_host(|h| h.get_variable(sprite, path)).ok_or(NO_HOST)
+    }
+
+    pub fn set_variable(sprite: i32, path: &str, value: &str) -> Result<FlashValue, FlashValue> {
+        with_host(|h| FlashValue::Bool(h.set_variable(sprite, path, value))).ok_or(NO_HOST)
+    }
+
+    /// As `callFunction`: arguments that are not a JSON list make the call answer null.
+    pub fn call_function(sprite: i32, path: &str, args_json: &str) -> Result<FlashValue, FlashValue> {
+        if !has_host() {
+            return Err(NO_HOST);
+        }
+        match parse_args(args_json) {
+            Ok(args) => with_host(|h| h.call_function(sprite, path, &args)).ok_or(NO_HOST),
+            Err(e) => {
+                log::warn!("Flash callFunction {path}: {e}");
+                Ok(FlashValue::Null)
+            }
+        }
+    }
+
+    pub fn goto_frame(sprite: i32, frame_or_label: &str) {
+        with_host(|h| h.goto_frame(sprite, frame_or_label));
+    }
+
+    pub fn goto_frame_and_stop(sprite: i32, frame_or_label: &str) {
+        with_host(|h| h.goto_frame_and_stop(sprite, frame_or_label));
+    }
+
+    pub fn stop(sprite: i32) {
+        with_host(|h| h.stop(sprite));
+    }
+
+    pub fn play(sprite: i32) {
+        with_host(|h| h.play(sprite));
+    }
+
+    pub fn rewind(sprite: i32) {
+        with_host(|h| h.rewind(sprite));
+    }
+
+    pub fn call_frame(sprite: i32, frame: i32) {
+        with_host(|h| h.call_frame(sprite, frame));
+    }
+
+    pub fn is_playing(sprite: i32) -> bool {
+        with_host(|h| h.is_playing(sprite)).unwrap_or(false)
+    }
+
+    pub fn frame_count(sprite: i32) -> i32 {
+        with_host(|h| h.frame_count(sprite)).unwrap_or(0)
+    }
+
+    pub fn current_frame(sprite: i32) -> i32 {
+        with_host(|h| h.current_frame(sprite)).unwrap_or(0)
+    }
+
+    pub fn hit_test(sprite: i32, x: f64, y: f64) -> i32 {
+        with_host(|h| h.hit_test(sprite, x, y)).unwrap_or(0)
+    }
+
+    pub fn is_ready(sprite: i32) -> Result<FlashValue, FlashValue> {
+        with_host(|h| FlashValue::Bool(h.is_ready(sprite))).ok_or(NO_HOST)
+    }
+
+    pub fn set_size(sprite: i32, width: i32, height: i32) {
+        with_host(|h| h.set_size(sprite, width, height));
+    }
+
+    pub fn dispatch_mouse(sprite: i32, kind: &str, x: i32, y: i32, sprite_w: i32, sprite_h: i32) -> Result<FlashValue, FlashValue> {
+        let kind = match kind {
+            "down" => MouseKind::Down,
+            "up" => MouseKind::Up,
+            "move" => MouseKind::Move,
+            _ => return Ok(FlashValue::Bool(false)),
+        };
+        with_host(|h| FlashValue::Bool(h.mouse(sprite, kind, x, y, sprite_w, sprite_h))).ok_or(NO_HOST)
+    }
+
+    /// The property numbers `getFlashProperty` knows (flashPlayerManager.ts `getFlashProperty`).
+    fn property_to_get(n: i32) -> Option<&'static str> {
+        const NAMES: [&str; 22] = [
+            "_x", "_y", "_xscale", "_yscale", "_currentframe", "_totalframes", "_alpha", "_visible", "_width", "_height", "_rotation", "_target",
+            "_framesloaded", "_name", "_droptarget", "_url", "_highquality", "_focusrect", "_soundbuftime", "_quality", "_xmouse", "_ymouse",
+        ];
+        usize::try_from(n).ok().and_then(|n| NAMES.get(n).copied())
+    }
+
+    /// The ones `setFlashProperty` sets.
+    fn property_to_set(n: i32) -> Option<&'static str> {
+        match n {
+            0 => Some("_x"),
+            1 => Some("_y"),
+            2 => Some("_xscale"),
+            3 => Some("_yscale"),
+            6 => Some("_alpha"),
+            7 => Some("_visible"),
+            10 => Some("_rotation"),
+            13 => Some("_name"),
+            16 => Some("_highquality"),
+            18 => Some("_soundbuftime"),
+            _ => None,
+        }
+    }
+
+    fn property_path(target: &str, name: &str) -> String {
+        if target.is_empty() {
+            format!("/:{name}")
+        } else {
+            format!("{target}:{name}")
+        }
+    }
+
+    /// `getFlashProperty`: the property's value as a string, null when there is none.
+    pub fn get_flash_property(sprite: i32, target: &str, prop: i32) -> Result<FlashValue, FlashValue> {
+        let Some(name) = property_to_get(prop) else {
+            return Ok(FlashValue::Null);
+        };
+        let value = with_host(|h| h.get_variable(sprite, &property_path(target, name))).ok_or(NO_HOST)?;
+        Ok(match value {
+            FlashValue::Undefined | FlashValue::Null => FlashValue::Null,
+            FlashValue::Object(_) | FlashValue::List(_) => FlashValue::String("[object Object]".into()),
+            v => v,
+        })
+    }
+
+    pub fn set_flash_property(sprite: i32, target: &str, prop: i32, value: &str) {
+        if let Some(name) = property_to_set(prop) {
+            with_host(|h| h.set_variable(sprite, &property_path(target, name), value));
+        }
+    }
+}
