+/// PS5_RUFFLE_DIRPLAYER_NATIVE: the system font from DirPlayer's own `public/charmap-system.png`,
+/// which the web front end has the VM fetch (`SetSystemFontPath`, below). Off the web nothing sent
+/// that, so the player had no system font: text in a font the movie does not carry found none,
+/// and `locToCharPos`, `pointToChar` and others unwrap it. The same bitmap and font as the web
+/// path makes from the same image (an RGB PNG: every pixel opaque, as the canvas reads it back).
+#[cfg(not(target_arch = "wasm32"))]
+pub fn native_load_system_font(player: &mut crate::player::DirPlayer) -> Result<(), String> {
+    static PNG: &[u8] = include_bytes!("../../../../public/charmap-system.png");
+    let img = image::load_from_memory_with_format(PNG, image::ImageFormat::Png)
+        .map_err(|e| format!("charmap-system.png: {e}"))?
+        .to_rgba8();
+    let bitmap = Bitmap {
+        width: img.width() as u16,
+        height: img.height() as u16,
+        data: img.into_raw(),
+        bit_depth: 32,
+        original_bit_depth: 32,
+        palette_ref: PaletteRef::BuiltIn(get_system_default_palette()),
+        matte: None,
+        use_alpha: false,
+        trim_white_space: false,
+        was_trimmed: false,
+        version: 0,
+    };
+    let grid_columns = 18;
+    let grid_rows = 7;
+    let grid_cell_width = bitmap.width / grid_columns;
+    let grid_cell_height = bitmap.height / grid_rows;
+    let bitmap_ref = player.bitmap_manager.add_bitmap(bitmap);
+    let font = BitmapFont {
+        bitmap_ref,
+        char_width: 5,
+        char_height: 7,
+        grid_columns: grid_columns as u8,
+        grid_rows: grid_rows as u8,
+        grid_cell_width,
+        grid_cell_height,
+        first_char_num: 32,
+        char_offset_x: 1,
+        char_offset_y: 1,
+        font_name: "System".to_string(),
+        font_size: 12,
+        font_style: 0,
+        char_widths: None,
+        pfr_native_size: 0,
+    };
+    let rc_font = Rc::new(font.clone());
+    let font_ref = player.font_manager.font_counter;
+    player.font_manager.font_counter += 1;
+    player.font_manager.fonts.insert(font_ref, Rc::clone(&rc_font));
+    player.font_manager.system_font = Some(rc_font);
+    player.font_manager.font_cache.insert("system".to_string(), font.into());
+    Ok(())
+}
+
 pub async fn player_load_system_font(path: &str) {
     let window = web_sys::window().unwrap();
     let result = JsFuture::from(window.fetch_with_str(path)).await;
