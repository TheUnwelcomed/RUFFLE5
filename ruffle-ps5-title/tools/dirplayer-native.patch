+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the software rasteriser: vertex fetch, primitive assembly,
+//! clipping to the view volume in homogeneous coordinates, viewport transform, face culling,
+//! triangle / line / point rasterisation with perspective-correct varyings, polygon offset,
+//! scissor, depth test, blending and colour mask — the OpenGL ES 3.0 pipeline (§2.13–§4.1) for
+//! what the 3D renderer uses. Window coordinates are GL's: row 0 is y = 0.
+
+use super::gl::WebGl2RenderingContext as GL;
+use super::programs::BuiltProgram;
+
+/// Varyings a vertex carries (a program interpolates the first `interp()` of them).
+pub const MAXV: usize = 16;
+/// Vertex attribute locations a program reads.
+pub const NATTR: usize = 8;
+
+pub struct AttribSource<'a> {
+    pub data: &'a [u8],
+    pub size: usize,
+    pub kind: u32,
+    pub stride: usize,
+    pub offset: usize,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Primitive {
+    Triangles,
+    TriangleStrip,
+    TriangleFan,
+    Lines,
+    LineStrip,
+    Points,
+}
+
+#[derive(Clone, Copy)]
+pub struct BlendState {
+    /// srcRGB, dstRGB, srcAlpha, dstAlpha
+    pub func: [u32; 4],
+    /// RGB, alpha
+    pub equation: [u32; 2],
+}
+
+#[derive(Clone, Copy)]
+pub struct RasterState {
+    pub viewport: [i32; 4],
+    pub scissor: Option<[i32; 4]>,
+    pub depth_test: bool,
+    pub depth_func: u32,
+    pub depth_write: bool,
+    /// Some(FRONT | BACK | FRONT_AND_BACK) when CULL_FACE is on.
+    pub cull: Option<u32>,
+    pub front_ccw: bool,
+    pub blend: Option<BlendState>,
+    pub color_mask: [bool; 4],
+    /// Some([factor, units]) when POLYGON_OFFSET_FILL is on.
+    pub polygon_offset: Option<[f32; 2]>,
+}
+
+pub struct Target<'a> {
+    /// RGBA8, rows bottom-up.
+    pub color: &'a mut Vec<u8>,
+    pub width: usize,
+    pub height: usize,
+    pub depth: Option<&'a mut [f32]>,
+}
+
+#[derive(Clone, Copy)]
+pub struct VOut {
+    /// Clip coordinates (gl_Position).
+    pub pos: [f32; 4],
+    pub v: [f32; MAXV],
+}
+
+impl Default for VOut {
+    fn default() -> Self {
+        VOut { pos: [0.0, 0.0, 0.0, 1.0], v: [0.0; MAXV] }
+    }
+}
+
+/// The fragment being shaded: its interpolated varyings and how they change across the window.
+pub struct Frag<'a> {
+    pub v: [f32; MAXV],
+    pub q: f32,
+    /// 1 / q (0 when q is 0), computed once for the varyings and their derivatives.
+    iq: f32,
+    grads: Option<&'a Grads>,
+    pub front: bool,
+}
+
+impl Frag<'_> {
+    /// d(varying i)/dx and /dy at this fragment (0 for lines and points).
+    #[inline]
+    pub fn deriv(&self, i: usize) -> (f32, f32) {
+        match self.grads {
+            Some(g) if self.q != 0.0 => {
+                let inv = self.iq;
+                ((g.ax[i] - self.v[i] * g.qx) * inv, (g.ay[i] - self.v[i] * g.qy) * inv)
+            }
+            _ => (0.0, 0.0),
+        }
+    }
+}
+
+/// What a program does: its vertex shader, a hook on each assembled triangle (before
+/// clipping), and its fragment shader (None: discard).
+pub trait Program {
+    fn interp(&self) -> usize;
+    fn vertex(&self, a: &[[f32; 4]; NATTR]) -> VOut;
+    fn triangle(&self, _t: &mut [VOut; 3]) {}
+    fn fragment(&self, f: &Frag) -> Option<[f32; 4]>;
+    fn point_size(&self) -> f32 {
+        1.0
+    }
+    /// True when every fragment of the draw would be discarded.
+    fn draws_nothing(&self) -> bool {
+        false
+    }
+    /// Debugging (DIRPLAYER_SOFTGL_PICK=x,y): what this program computed for a fragment.
+    fn describe(&self, _f: &Frag) -> String {
+        String::new()
+    }
+}
+
+/// DIRPLAYER_SOFTGL_PICK=x,y: every fragment written at that pixel (window coordinates) is
+/// described here, for finding out why a surface comes out as it does.
+pub static PICK: std::sync::Mutex<Option<(i32, i32, Vec<String>)>> = std::sync::Mutex::new(None);
+
+pub static PICK_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn pick_init() {
+    if let Ok(v) = std::env::var("DIRPLAYER_SOFTGL_PICK") {
+        if v == "black" {
+            if let Ok(mut p) = PICK.lock() {
+                if p.is_none() {
+                    *p = Some((-1, -1, Vec::new()));
+                    PICK_ON.store(true, std::sync::atomic::Ordering::Relaxed);
+                }
+            }
+            return;
+        }
+        let mut it = v.split(',').filter_map(|t| t.trim().parse::<i32>().ok());
+        if let (Some(x), Some(y)) = (it.next(), it.next()) {
+            if let Ok(mut p) = PICK.lock() {
+                if p.is_none() {
+                    *p = Some((x, y, Vec::new()));
+                    PICK_ON.store(true, std::sync::atomic::Ordering::Relaxed);
+                }
+            }
+        }
+    }
+}
+
+pub fn pick_take() -> Vec<String> {
+    PICK.lock().ok().and_then(|mut p| p.as_mut().map(|(_, _, v)| std::mem::take(v))).unwrap_or_default()
+}
+
+#[inline]
+fn pick_note<P: Program>(p: &P, f: &Frag, px: i32, py: i32, z: f32, color: [f32; 4]) {
+    if let Ok(mut g) = PICK.try_lock() {
+        if let Some((x, y, v)) = g.as_mut() {
+            let black = *x == -1 && color[0] <= 0.0 && color[1] <= 0.0 && color[2] <= 0.0 && color[3] > 0.0;
+            if ((*x == px && *y == py) || black) && v.len() < 64 {
+                v.push(format!("at {px},{py} z {z:.6} rgba {:.3} {:.3} {:.3} {:.3} | {}", color[0], color[1], color[2], color[3], p.describe(f)));
+            }
+        }
+    }
+}
+
+pub fn read_indices(buf: &[u8], kind: u32, offset: usize, count: usize) -> Vec<u32> {
+    let size = match kind {
+        GL::UNSIGNED_INT => 4,
+        GL::UNSIGNED_SHORT => 2,
+        _ => 1,
+    };
+    let mut out = Vec::with_capacity(count);
+    for k in 0..count {
+        let o = offset + k * size;
+        if o + size > buf.len() {
+            break;
+        }
+        out.push(match size {
+            4 => u32::from_le_bytes([buf[o], buf[o + 1], buf[o + 2], buf[o + 3]]),
+            2 => u16::from_le_bytes([buf[o], buf[o + 1]]) as u32,
+            _ => buf[o] as u32,
+        });
+    }
+    out
+}
+
+#[inline]
+fn fetch(attribs: &[Option<AttribSource>], index: u32) -> [[f32; 4]; NATTR] {
+    let mut a = [[0.0, 0.0, 0.0, 1.0]; NATTR];
+    for (loc, src) in attribs.iter().enumerate().take(NATTR) {
+        let Some(src) = src else { continue };
+        if src.kind != GL::FLOAT {
+            continue;
+        }
+        let base = src.offset + index as usize * src.stride;
+        for c in 0..src.size {
+            let o = base + c * 4;
+            if o + 4 <= src.data.len() {
+                a[loc][c] = f32::from_le_bytes([src.data[o], src.data[o + 1], src.data[o + 2], src.data[o + 3]]);
+            } else {
+                a[loc][c] = 0.0;
+            }
+        }
+    }
+    a
+}
+
+pub fn clear(t: Target, rect: Option<[i32; 4]>, color: Option<([f32; 4], [bool; 4])>, depth: Option<f32>) {
+    let (w, h) = (t.width as i32, t.height as i32);
+    let (x0, y0, x1, y1) = match rect {
+        Some([x, y, rw, rh]) => (x.max(0), y.max(0), (x + rw).min(w), (y + rh).min(h)),
+        None => (0, 0, w, h),
+    };
+    if x0 >= x1 || y0 >= y1 {
+        return;
+    }
+    if let Some((c, mask)) = color {
+        let px = [to_u8(c[0]), to_u8(c[1]), to_u8(c[2]), to_u8(c[3])];
+        for y in y0..y1 {
+            let row = (y as usize) * t.width;
+            for x in x0..x1 {
+                let o = (row + x as usize) * 4;
+                for k in 0..4 {
+                    if mask[k] {
+                        t.color[o + k] = px[k];
+                    }
+                }
+            }
+        }
+    }
+    if let (Some(d), Some(buf)) = (depth.map(depth_q), t.depth) {
+        for y in y0..y1 {
+            let row = (y as usize) * t.width;
+            for x in x0..x1 {
+                buf[row + x as usize] = d;
+            }
+        }
+    }
+}
+
+/// blitFramebuffer of the colour buffer, NEAREST.
+pub fn blit(t: Target, src: &[u8], sw: usize, sh: usize, s: [i32; 4], d: [i32; 4]) {
+    let (dw, dh) = (d[2] - d[0], d[3] - d[1]);
+    let (sw_r, sh_r) = (s[2] - s[0], s[3] - s[1]);
+    if dw == 0 || dh == 0 {
+        return;
+    }
+    let (xa, xb) = (d[0].min(d[2]).max(0), d[0].max(d[2]).min(t.width as i32));
+    let (ya, yb) = (d[1].min(d[3]).max(0), d[1].max(d[3]).min(t.height as i32));
+    for y in ya..yb {
+        let fy = (y as f32 + 0.5 - d[1] as f32) / dh as f32;
+        let sy = (s[1] as f32 + fy * sh_r as f32).floor() as i32;
+        if sy < 0 || sy as usize >= sh {
+            continue;
+        }
+        for x in xa..xb {
+            let fx = (x as f32 + 0.5 - d[0] as f32) / dw as f32;
+            let sx = (s[0] as f32 + fx * sw_r as f32).floor() as i32;
+            if sx < 0 || sx as usize >= sw {
+                continue;
+            }
+            let so = (sy as usize * sw + sx as usize) * 4;
+            let o = (y as usize * t.width + x as usize) * 4;
+            t.color[o..o + 4].copy_from_slice(&src[so..so + 4]);
+        }
+    }
+}
+
+#[inline]
+fn to_u8(c: f32) -> u8 {
+    if c.is_nan() {
+        return 0;
+    }
+    (c.clamp(0.0, 1.0) * 255.0 + 0.5) as u8
+}
+
+/// A draw call made ready for its pixels: its program (with the uniforms and textures of the
+/// moment it was issued), its fixed-function state, and its primitives clipped, in window
+/// coordinates and set up. `execute` writes the pixels of a run of these, in order, across
+/// threads by row bands — each pixel still sees the draws in the order they were issued.
+pub struct DrawCmd {
+    pub program: BuiltProgram,
+    pub rs: RasterState,
+    prims: Vec<Setup>,
+    /// Triangles that reached rasterisation.
+    pub tris: u64,
+}
+
+enum Setup {
+    Tri(TriSetup),
+    Line(LineSetup),
+    Point(PointSetup),
+}
+
+/// One draw call's vertex shading, primitive assembly, clipping, culling and triangle setup, for a
+/// colour buffer of `fb` (width, height). None when it can draw nothing.
+#[allow(clippy::too_many_arguments)]
+pub fn setup(
+    program: BuiltProgram,
+    attribs: &[Option<AttribSource>],
+    prim: Primitive,
+    first: usize,
+    count: usize,
+    indices: Option<&[u32]>,
+    fb: (usize, usize),
+    rs: &RasterState,
+) -> Option<DrawCmd> {
+    let (prims, tris) = match &program {
+        BuiltProgram::Main(p) => setup_with(p, attribs, prim, first, count, indices, fb, rs),
+        BuiltProgram::Particle(p) => setup_with(p, attribs, prim, first, count, indices, fb, rs),
+        BuiltProgram::Post(p) => setup_with(p, attribs, prim, first, count, indices, fb, rs),
+        BuiltProgram::Outline(p) => setup_with(p, attribs, prim, first, count, indices, fb, rs),
+    }?;
+    if prims.is_empty() {
+        return None;
+    }
+    Some(DrawCmd { program, rs: *rs, prims, tris })
+}
+
+#[allow(clippy::too_many_arguments)]
+fn setup_with<P: Program>(
+    p: &P,
+    attribs: &[Option<AttribSource>],
+    prim: Primitive,
+    first: usize,
+    count: usize,
+    indices: Option<&[u32]>,
+    fb: (usize, usize),
+    rs: &RasterState,
+) -> Option<(Vec<Setup>, u64)> {
+    if p.draws_nothing() || count == 0 {
+        return None;
+    }
+    let n = indices.map(|i| i.len()).unwrap_or(count);
+    let index_at = |k: usize| -> u32 { indices.map(|i| i[k]).unwrap_or((first + k) as u32) };
+    // Each vertex is shaded once, however many primitives share it.
+    let (lo, hi) = match indices {
+        Some(ix) if !ix.is_empty() => (*ix.iter().min().unwrap(), *ix.iter().max().unwrap()),
+        Some(_) => return None,
+        None => (first as u32, (first + count - 1) as u32),
+    };
+    let span = (hi - lo) as usize + 1;
+    if span > 16_000_000 {
+        return None;
+    }
+    let mut cache: Vec<Option<VOut>> = vec![None; span];
+    let mut vert = |k: usize| -> VOut {
+        let idx = index_at(k);
+        let slot = (idx - lo) as usize;
+        if let Some(v) = cache[slot] {
+            return v;
+        }
+        let v = p.vertex(&fetch(attribs, idx));
+        cache[slot] = Some(v);
+        v
+    };
+
+    let fb = (fb.0 as i32, fb.1 as i32);
+    let vp = rs.viewport;
+    // The pixels a fragment may land on: the viewport, the scissor box, the buffer.
+    let mut clip = [vp[0].max(0), vp[1].max(0), (vp[0] + vp[2]).min(fb.0), (vp[1] + vp[3]).min(fb.1)];
+    if let Some(s) = rs.scissor {
+        clip = [clip[0].max(s[0]), clip[1].max(s[1]), clip[2].min(s[0] + s[2]), clip[3].min(s[1] + s[3])];
+    }
+    if clip[0] >= clip[2] || clip[1] >= clip[3] {
+        return None;
+    }
+    let mut ctx = Ctx { rs, clip, prims: Vec::new(), tris: 0 };
+
+    match prim {
+        Primitive::Triangles | Primitive::TriangleStrip | Primitive::TriangleFan => {
+            let ntri = match prim {
+                Primitive::Triangles => n / 3,
+                _ => n.saturating_sub(2),
+            };
+            ctx.prims.reserve(ntri);
+            for t in 0..ntri {
+                let (a, b, c) = match prim {
+                    Primitive::Triangles => (3 * t, 3 * t + 1, 3 * t + 2),
+                    Primitive::TriangleStrip => {
+                        if t % 2 == 0 {
+                            (t, t + 1, t + 2)
+                        } else {
+                            (t + 1, t, t + 2)
+                        }
+                    }
+                    _ => (0, t + 1, t + 2),
+                };
+                let mut tri = [vert(a), vert(b), vert(c)];
+                p.triangle(&mut tri);
+                clip_and_setup_triangle(p, &tri, &mut ctx);
+            }
+        }
+        Primitive::Lines | Primitive::LineStrip => {
+            let nl = if prim == Primitive::Lines { n / 2 } else { n.saturating_sub(1) };
+            for l in 0..nl {
+                let (a, b) = if prim == Primitive::Lines { (2 * l, 2 * l + 1) } else { (l, l + 1) };
+                let line = [vert(a), vert(b)];
+                clip_and_setup_line(p, &line, &mut ctx);
+            }
+        }
+        Primitive::Points => {
+            for k in 0..n {
+                let v = vert(k);
+                setup_point(p, &v, &mut ctx);
+            }
+        }
+    }
+    Some((ctx.prims, ctx.tris))
+}
+
+struct Ctx<'a> {
+    rs: &'a RasterState,
+    /// x0, y0, x1, y1 (exclusive)
+    clip: [i32; 4],
+    prims: Vec<Setup>,
+    tris: u64,
+}
+
+/// A vertex in window coordinates: x, y, depth z in [0, 1], q = 1/w, and its varyings * q.
+#[derive(Clone, Copy)]
+struct Win {
+    x: f32,
+    y: f32,
+    z: f32,
+    q: f32,
+    vq: [f32; MAXV],
+}
+
+fn to_window(v: &VOut, vp: &[i32; 4], nv: usize) -> Win {
+    let q = 1.0 / v.pos[3];
+    let xn = v.pos[0] * q;
+    let yn = v.pos[1] * q;
+    let zn = v.pos[2] * q;
+    let mut vq = [0.0; MAXV];
+    for i in 0..nv {
+        vq[i] = v.v[i] * q;
+    }
+    Win {
+        x: (xn * 0.5 + 0.5) * vp[2] as f32 + vp[0] as f32,
+        y: (yn * 0.5 + 0.5) * vp[3] as f32 + vp[1] as f32,
+        z: (zn * 0.5 + 0.5).clamp(0.0, 1.0),
+        q,
+        vq,
+    }
+}
+
+/// The six clip planes' signed distances: inside is >= 0.
+#[inline]
+fn plane_dist(p: &[f32; 4], plane: usize) -> f32 {
+    match plane {
+        0 => p[3] + p[0],
+        1 => p[3] - p[0],
+        2 => p[3] + p[1],
+        3 => p[3] - p[1],
+        4 => p[3] + p[2],
+        _ => p[3] - p[2],
+    }
+}
+
+fn lerp_vout(a: &VOut, b: &VOut, t: f32) -> VOut {
+    let mut o = VOut::default();
+    for k in 0..4 {
+        o.pos[k] = a.pos[k] + (b.pos[k] - a.pos[k]) * t;
+    }
+    for k in 0..MAXV {
+        o.v[k] = a.v[k] + (b.v[k] - a.v[k]) * t;
+    }
+    o
+}
+
+fn clip_and_setup_triangle<P: Program>(p: &P, tri: &[VOut; 3], ctx: &mut Ctx) {
+    // Outcodes: trivially inside, or wholly outside one plane.
+    let mut all_in = true;
+    for plane in 0..6 {
+        let d0 = plane_dist(&tri[0].pos, plane);
+        let d1 = plane_dist(&tri[1].pos, plane);
+        let d2 = plane_dist(&tri[2].pos, plane);
+        if d0 < 0.0 && d1 < 0.0 && d2 < 0.0 {
+            return;
+        }
+        if d0 < 0.0 || d1 < 0.0 || d2 < 0.0 {
+            all_in = false;
+        }
+        if !(d0.is_finite() && d1.is_finite() && d2.is_finite()) {
+            return;
+        }
+    }
+    let nv = p.interp();
+    let vp = ctx.rs.viewport;
+    if all_in {
+        let w = [to_window(&tri[0], &vp, nv), to_window(&tri[1], &vp, nv), to_window(&tri[2], &vp, nv)];
+        setup_triangle(nv, &w, ctx);
+        return;
+    }
+    // Sutherland–Hodgman against each plane in turn.
+    let mut poly: Vec<VOut> = tri.to_vec();
+    let mut next: Vec<VOut> = Vec::with_capacity(9);
+    for plane in 0..6 {
+        if poly.is_empty() {
+            return;
+        }
+        next.clear();
+        for i in 0..poly.len() {
+            let a = &poly[i];
+            let b = &poly[(i + 1) % poly.len()];
+            let da = plane_dist(&a.pos, plane);
+            let db = plane_dist(&b.pos, plane);
+            if da >= 0.0 {
+                next.push(*a);
+            }
+            if (da >= 0.0) != (db >= 0.0) {
+                let t = da / (da - db);
+                next.push(lerp_vout(a, b, t));
+            }
+        }
+        std::mem::swap(&mut poly, &mut next);
+    }
+    if poly.len() < 3 {
+        return;
+    }
+    let win: Vec<Win> = poly.iter().map(|v| to_window(v, &vp, nv)).collect();
+    for i in 1..win.len() - 1 {
+        setup_triangle(nv, &[win[0], win[i], win[i + 1]], ctx);
+    }
+}
+
+pub struct Grads {
+    pub ax: [f32; MAXV],
+    pub ay: [f32; MAXV],
+    pub qx: f32,
+    pub qy: f32,
+}
+
+/// Debugging (DIRPLAYER_SOFTGL_DEPTH_BITS=n): depth values rounded to an n-bit fixed-point
+/// buffer, as a GL depth renderbuffer of that size stores them. 0: kept as f32.
+pub static DEPTH_STEPS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+pub fn depth_bits_init() {
+    if let Some(n) = std::env::var("DIRPLAYER_SOFTGL_DEPTH_BITS").ok().and_then(|v| v.parse::<u32>().ok()) {
+        if (1..=24).contains(&n) {
+            DEPTH_STEPS.store((1u32 << n) - 1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+}
+
+#[inline]
+fn depth_q(z: f32) -> f32 {
+    let n = DEPTH_STEPS.load(std::sync::atomic::Ordering::Relaxed);
+    if n == 0 {
+        z
+    } else {
+        ((z as f64 * n as f64).round() / n as f64) as f32
+    }
+}
+
+#[inline]
+fn depth_pass(func: u32, z: f32, d: f32) -> bool {
+    match func {
+        GL::NEVER => false,
+        GL::LESS => z < d,
+        GL::EQUAL => z == d,
+        GL::LEQUAL => z <= d,
+        GL::GREATER => z > d,
+        GL::NOTEQUAL => z != d,
+        GL::GEQUAL => z >= d,
+        _ => true,
+    }
+}
+
+#[inline]
+fn factor(f: u32, s: [f32; 4], d: [f32; 4], k: usize) -> f32 {
+    match f {
+        GL::ZERO => 0.0,
+        GL::ONE => 1.0,
+        GL::SRC_COLOR => s[k],
+        GL::ONE_MINUS_SRC_COLOR => 1.0 - s[k],
+        GL::SRC_ALPHA => s[3],
+        GL::ONE_MINUS_SRC_ALPHA => 1.0 - s[3],
+        GL::DST_ALPHA => d[3],
+        GL::ONE_MINUS_DST_ALPHA => 1.0 - d[3],
+        GL::DST_COLOR => d[k],
+        GL::ONE_MINUS_DST_COLOR => 1.0 - d[k],
+        GL::SRC_ALPHA_SATURATE => {
+            if k == 3 {
+                1.0
+            } else {
+                s[3].min(1.0 - d[3])
+            }
+        }
+        _ => 0.0,
+    }
+}
+
+#[inline]
+fn write_pixel(px: &mut [u8], src: [f32; 4], rs: &RasterState) {
+    let s = [src[0].clamp(0.0, 1.0), src[1].clamp(0.0, 1.0), src[2].clamp(0.0, 1.0), src[3].clamp(0.0, 1.0)];
+    let out = match rs.blend {
+        None => s,
+        Some(b) => {
+            const K: f32 = 1.0 / 255.0;
+            let d = [px[0] as f32 * K, px[1] as f32 * K, px[2] as f32 * K, px[3] as f32 * K];
+            let mut o = [0.0f32; 4];
+            for k in 0..4 {
+                let (sf, df, eq) = if k < 3 { (b.func[0], b.func[1], b.equation[0]) } else { (b.func[2], b.func[3], b.equation[1]) };
+                o[k] = match eq {
+                    GL::MIN => s[k].min(d[k]),
+                    GL::MAX => s[k].max(d[k]),
+                    GL::FUNC_SUBTRACT => s[k] * factor(sf, s, d, k) - d[k] * factor(df, s, d, k),
+                    GL::FUNC_REVERSE_SUBTRACT => d[k] * factor(df, s, d, k) - s[k] * factor(sf, s, d, k),
+                    _ => s[k] * factor(sf, s, d, k) + d[k] * factor(df, s, d, k),
+                };
+            }
+            o
+        }
+    };
+    for k in 0..4 {
+        if rs.color_mask[k] {
+            px[k] = to_u8(out[k]);
+        }
+    }
+}
+
+/// Edge function E(p) = (B - A) x (p - A) of an edge a→b.
+#[derive(Clone, Copy)]
+struct Edge {
+    dx: f32,
+    dy: f32,
+    ax: f32,
+    ay: f32,
+    /// A sample exactly on the edge belongs to the triangle (the edge is "top-left").
+    incl: bool,
+}
+
+#[inline]
+fn eval(e: &Edge, x: f32, y: f32) -> f32 {
+    e.dx * (y - e.ay) - e.dy * (x - e.ax)
+}
+
+/// A triangle ready to scan: its first vertex (counter-clockwise order), the planes of depth,
+/// 1/w and the varyings, the three edges and the pixels it may cover.
+struct TriSetup {
+    a: Win,
+    g: Grads,
+    zx: f32,
+    zy: f32,
+    z_offset: f32,
+    e: [Edge; 3],
+    /// x0, y0, x1, y1 (exclusive), within the clip rectangle.
+    bbox: [i32; 4],
+    front: bool,
+}
+
+fn setup_triangle(nv: usize, v: &[Win; 3], ctx: &mut Ctx) {
+    let (x0, y0) = (v[0].x, v[0].y);
+    let (x1, y1) = (v[1].x, v[1].y);
+    let (x2, y2) = (v[2].x, v[2].y);
+    let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
+    if area == 0.0 || !area.is_finite() {
+        return;
+    }
+    // Counter-clockwise in window coordinates (y up) is a positive area.
+    let ccw = area > 0.0;
+    let front = ccw == ctx.rs.front_ccw;
+    match ctx.rs.cull {
+        Some(GL::FRONT) if front => return,
+        Some(GL::BACK) if !front => return,
+        Some(GL::FRONT_AND_BACK) => return,
+        _ => {}
+    }
+    // Wind the triangle counter-clockwise so "inside" is all edge functions >= 0.
+    let (a, b, c) = if ccw { (&v[0], &v[1], &v[2]) } else { (&v[0], &v[2], &v[1]) };
+    let area = area.abs();
+    let inv_area = 1.0 / area;
+
+    let minx = (a.x.min(b.x).min(c.x).floor() as i32).max(ctx.clip[0]);
+    let maxx = (a.x.max(b.x).max(c.x).ceil() as i32).min(ctx.clip[2]);
+    let miny = (a.y.min(b.y).min(c.y).floor() as i32).max(ctx.clip[1]);
+    let maxy = (a.y.max(b.y).max(c.y).ceil() as i32).min(ctx.clip[3]);
+    if minx >= maxx || miny >= maxy {
+        return;
+    }
+    ctx.tris += 1;
+
+    // Plane equations: value(x, y) = a0 + gx (x - ax) + gy (y - ay).
+    let grad = |va: f32, vb: f32, vc: f32| -> (f32, f32) {
+        let gx = ((vb - va) * (c.y - a.y) - (vc - va) * (b.y - a.y)) * inv_area;
+        let gy = ((vc - va) * (b.x - a.x) - (vb - va) * (c.x - a.x)) * inv_area;
+        (gx, gy)
+    };
+    let (zx, zy) = grad(a.z, b.z, c.z);
+    let (qx, qy) = grad(a.q, b.q, c.q);
+    let mut g = Grads { ax: [0.0; MAXV], ay: [0.0; MAXV], qx, qy };
+    for i in 0..nv {
+        let (gx, gy) = grad(a.vq[i], b.vq[i], c.vq[i]);
+        g.ax[i] = gx;
+        g.ay[i] = gy;
+    }
+    let z_offset = match ctx.rs.polygon_offset {
+        // m = max |dz/dx|, |dz/dy|; r = the 16-bit depth buffer's resolution (the 3D
+        // renderer's depth renderbuffers are DEPTH_COMPONENT16).
+        Some([factor, units]) => factor * zx.abs().max(zy.abs()) + units * (1.0 / 65535.0),
+        None => 0.0,
+    };
+    let edge = |p0: &Win, p1: &Win| -> Edge {
+        let dx = p1.x - p0.x;
+        let dy = p1.y - p0.y;
+        Edge { dx, dy, ax: p0.x, ay: p0.y, incl: dy < 0.0 || (dy == 0.0 && dx > 0.0) }
+    };
+    // e[0]: weight of a (edge b→c), e[1]: of b (c→a), e[2]: of c (a→b).
+    let e = [edge(b, c), edge(c, a), edge(a, b)];
+    ctx.prims.push(Setup::Tri(TriSetup { a: *a, g, zx, zy, z_offset, e, bbox: [minx, miny, maxx, maxy], front }));
+}
+
+struct LineSetup {
+    wa: Win,
+    wb: Win,
+    clip: [i32; 4],
+}
+
+fn clip_and_setup_line<P: Program>(p: &P, line: &[VOut; 2], ctx: &mut Ctx) {
+    // Liang–Barsky in homogeneous coordinates.
+    let (mut t0, mut t1) = (0.0f32, 1.0f32);
+    for plane in 0..6 {
+        let d0 = plane_dist(&line[0].pos, plane);
+        let d1 = plane_dist(&line[1].pos, plane);
+        if d0 < 0.0 && d1 < 0.0 {
+            return;
+        }
+        if d0 < 0.0 {
+            t0 = t0.max(d0 / (d0 - d1));
+        } else if d1 < 0.0 {
+            t1 = t1.min(d0 / (d0 - d1));
+        }
+        if t0 > t1 {
+            return;
+        }
+    }
+    let a = lerp_vout(&line[0], &line[1], t0);
+    let b = lerp_vout(&line[0], &line[1], t1);
+    let nv = p.interp();
+    let vp = ctx.rs.viewport;
+    let wa = to_window(&a, &vp, nv);
+    let wb = to_window(&b, &vp, nv);
+    ctx.prims.push(Setup::Line(LineSetup { wa, wb, clip: ctx.clip }));
+}
+
+struct PointSetup {
+    w: Win,
+    v: [f32; MAXV],
+    half: f32,
+    /// The pixels the point may cover: x0, y0, x1, y1 (exclusive).
+    rect: [i32; 4],
+}
+
+fn setup_point<P: Program>(p: &P, v: &VOut, ctx: &mut Ctx) {
+    // A point whose centre is outside the view volume is discarded.
+    for plane in 0..6 {
+        if plane_dist(&v.pos, plane) < 0.0 {
+            return;
+        }
+    }
+    let nv = p.interp();
+    let mut w = to_window(v, &ctx.rs.viewport, nv);
+    w.z = depth_q(w.z);
+    let size = p.point_size().max(1.0);
+    let half = size * 0.5;
+    let x0 = ((w.x - half).ceil() as i32 - if ((w.x - half).fract()) < 0.5 { 1 } else { 0 }).max(ctx.clip[0]);
+    let x1 = ((w.x + half).floor() as i32 + 1).min(ctx.clip[2]);
+    let y0 = ((w.y - half).ceil() as i32 - if ((w.y - half).fract()) < 0.5 { 1 } else { 0 }).max(ctx.clip[1]);
+    let y1 = ((w.y + half).floor() as i32 + 1).min(ctx.clip[3]);
+    if x0 >= x1 || y0 >= y1 {
+        return;
+    }
+    ctx.prims.push(Setup::Point(PointSetup { w, v: v.v, half, rect: [x0, y0, x1, y1] }));
+}
+
+/// The rows y0..y1 of a colour buffer (and its depth buffer) that one thread writes.
+struct Band<'a> {
+    y0: i32,
+    y1: i32,
+    width: usize,
+    color: &'a mut [u8],
+    depth: Option<&'a mut [f32]>,
+}
+
+/// The pixels of `cmds`, in order, into `t`. Returns the fragments written.
+pub fn execute(cmds: &[DrawCmd], t: Target) -> u64 {
+    let (w, h) = (t.width, t.height);
+    if cmds.is_empty() || w == 0 || h == 0 || t.color.len() < w * h * 4 {
+        return 0;
+    }
+    let pool = super::pool::get();
+    // Several bands per thread: a thread that finishes its band early takes another.
+    let nb = if pool.threads() > 1 { (pool.threads() * 4).min(h) } else { 1 };
+    let bh = h.div_ceil(nb);
+    let color: &mut [u8] = &mut t.color[..w * h * 4];
+    let mut depth_chunks = t.depth.filter(|d| d.len() >= w * h).map(|d| d[..w * h].chunks_mut(bh * w));
+    let mut bands: Vec<std::sync::Mutex<Band>> = Vec::with_capacity(nb);
+    for (i, c) in color.chunks_mut(bh * w * 4).enumerate() {
+        let y0 = i * bh;
+        let rows = c.len() / (w * 4);
+        let depth = depth_chunks.as_mut().and_then(|it| it.next());
+        bands.push(std::sync::Mutex::new(Band { y0: y0 as i32, y1: (y0 + rows) as i32, width: w, color: c, depth }));
+    }
+    let frags = std::sync::atomic::AtomicU64::new(0);
+    pool.run(bands.len(), &|i| {
+        let mut b = bands[i].lock().unwrap_or_else(|e| e.into_inner());
+        let mut n = 0u64;
+        for cmd in cmds {
+            n += match &cmd.program {
+                BuiltProgram::Main(p) => scan_with(p, cmd, &mut b),
+                BuiltProgram::Particle(p) => scan_with(p, cmd, &mut b),
+                BuiltProgram::Post(p) => scan_with(p, cmd, &mut b),
+                BuiltProgram::Outline(p) => scan_with(p, cmd, &mut b),
+            };
+        }
+        frags.fetch_add(n, std::sync::atomic::Ordering::Relaxed);
+    });
+    frags.into_inner()
+}
+
+fn scan_with<P: Program>(p: &P, cmd: &DrawCmd, b: &mut Band) -> u64 {
+    let mut n = 0;
+    for s in &cmd.prims {
+        n += match s {
+            Setup::Tri(t) => scan_triangle(p, t, &cmd.rs, b),
+            Setup::Line(l) => scan_line(p, l, &cmd.rs, b),
+            Setup::Point(pt) => scan_point(p, pt, &cmd.rs, b),
+        };
+    }
+    n
+}
+
+fn scan_triangle<P: Program>(p: &P, t: &TriSetup, rs: &RasterState, b: &mut Band) -> u64 {
+    let y_start = t.bbox[1].max(b.y0);
+    let y_end = t.bbox[3].min(b.y1);
+    if y_start >= y_end {
+        return 0;
+    }
+    let (minx, maxx) = (t.bbox[0], t.bbox[2]);
+    let a = &t.a;
+    let g = &t.g;
+    let (zx, zy, z_offset) = (t.zx, t.zy, t.z_offset);
+    let (e0, e1, e2) = (&t.e[0], &t.e[1], &t.e[2]);
+    let nv = p.interp();
+    let width = b.width;
+    let depth_test = rs.depth_test && b.depth.is_some();
+    let mut frags = 0u64;
+    for py in y_start..y_end {
+        let cy = py as f32 + 0.5;
+        let cx0 = minx as f32 + 0.5;
+        let mut w0 = eval(e0, cx0, cy);
+        let mut w1 = eval(e1, cx0, cy);
+        let mut w2 = eval(e2, cx0, cy);
+        // d/dx of E = -dy
+        let (s0, s1, s2) = (-e0.dy, -e1.dy, -e2.dy);
+        let row = (py - b.y0) as usize * width;
+        for px in minx..maxx {
+            let inside = (w0 > 0.0 || (w0 == 0.0 && e0.incl)) && (w1 > 0.0 || (w1 == 0.0 && e1.incl)) && (w2 > 0.0 || (w2 == 0.0 && e2.incl));
+            if inside {
+                let cx = px as f32 + 0.5;
+                let (dx, dy) = (cx - a.x, cy - a.y);
+                let z = depth_q((a.z + zx * dx + zy * dy + z_offset).clamp(0.0, 1.0));
+                let idx = row + px as usize;
+                let pass = if depth_test {
+                    let d = b.depth.as_ref().unwrap()[idx];
+                    depth_pass(rs.depth_func, z, d)
+                } else {
+                    true
+                };
+                if pass {
+                    let q = a.q + g.qx * dx + g.qy * dy;
+                    let iq = if q != 0.0 { 1.0 / q } else { 0.0 };
+                    let mut f = Frag { v: [0.0; MAXV], q, iq, grads: Some(g), front: t.front };
+                    if q != 0.0 {
+                        for i in 0..nv {
+                            f.v[i] = (a.vq[i] + g.ax[i] * dx + g.ay[i] * dy) * iq;
+                        }
+                    }
+                    if let Some(color) = p.fragment(&f) {
+                        if depth_test && rs.depth_write {
+                            b.depth.as_mut().unwrap()[idx] = z;
+                        }
+                        write_pixel(&mut b.color[idx * 4..idx * 4 + 4], color, rs);
+                        frags += 1;
+                        if PICK_ON.load(std::sync::atomic::Ordering::Relaxed) {
+                            pick_note(p, &f, px, py, z, color);
+                        }
+                    }
+                }
+            }
+            w0 += s0;
+            w1 += s1;
+            w2 += s2;
+        }
+    }
+    frags
+}
+
+fn scan_line<P: Program>(p: &P, l: &LineSetup, rs: &RasterState, b: &mut Band) -> u64 {
+    let (wa, wb) = (&l.wa, &l.wb);
+    let nv = p.interp();
+    let (dx, dy) = (wb.x - wa.x, wb.y - wa.y);
+    let steps = dx.abs().max(dy.abs()).ceil().max(1.0) as i32;
+    let depth_test = rs.depth_test && b.depth.is_some();
+    let mut frags = 0;
+    for s in 0..=steps {
+        let t = s as f32 / steps as f32;
+        let x = wa.x + dx * t;
+        let y = wa.y + dy * t;
+        let (px, py) = (x.floor() as i32, y.floor() as i32);
+        if px < l.clip[0] || px >= l.clip[2] || py < l.clip[1] || py >= l.clip[3] || py < b.y0 || py >= b.y1 {
+            continue;
+        }
+        let z = depth_q((wa.z + (wb.z - wa.z) * t).clamp(0.0, 1.0));
+        let idx = (py - b.y0) as usize * b.width + px as usize;
+        if depth_test && !depth_pass(rs.depth_func, z, b.depth.as_ref().unwrap()[idx]) {
+            continue;
+        }
+        let q = wa.q + (wb.q - wa.q) * t;
+        let mut f = Frag { v: [0.0; MAXV], q, iq: 0.0, grads: None, front: true };
+        if q != 0.0 {
+            for i in 0..nv {
+                f.v[i] = (wa.vq[i] + (wb.vq[i] - wa.vq[i]) * t) / q;
+            }
+        }
+        if let Some(color) = p.fragment(&f) {
+            if depth_test && rs.depth_write {
+                b.depth.as_mut().unwrap()[idx] = z;
+            }
+            write_pixel(&mut b.color[idx * 4..idx * 4 + 4], color, rs);
+            frags += 1;
+        }
+    }
+    frags
+}
+
+fn scan_point<P: Program>(p: &P, pt: &PointSetup, rs: &RasterState, b: &mut Band) -> u64 {
+    let w = &pt.w;
+    let half = pt.half;
+    let nv = p.interp();
+    let depth_test = rs.depth_test && b.depth.is_some();
+    let mut f = Frag { v: [0.0; MAXV], q: w.q, iq: 0.0, grads: None, front: true };
+    f.v[..nv].copy_from_slice(&pt.v[..nv]);
+    let mut frags = 0;
+    for py in pt.rect[1].max(b.y0)..pt.rect[3].min(b.y1) {
+        let cy = py as f32 + 0.5;
+        if cy < w.y - half || cy >= w.y + half {
+            continue;
+        }
+        for px in pt.rect[0]..pt.rect[2] {
+            let cx = px as f32 + 0.5;
+            if cx < w.x - half || cx >= w.x + half {
+                continue;
+            }
+            let idx = (py - b.y0) as usize * b.width + px as usize;
+            if depth_test && !depth_pass(rs.depth_func, w.z, b.depth.as_ref().unwrap()[idx]) {
+                continue;
+            }
+            if let Some(color) = p.fragment(&f) {
+                if depth_test && rs.depth_write {
+                    b.depth.as_mut().unwrap()[idx] = w.z;
+                }
+                write_pixel(&mut b.color[idx * 4..idx * 4 + 4], color, rs);
+                frags += 1;
+            }
+        }
+    }
+    frags
+}
