+#[cfg(test)]
+mod text_tests {
+    use super::*;
+
+    #[test]
+    fn the_text_form_gives_the_balls() {
+        let text = b"A\r\nBEGIN_WORLD MAX_exported_world \r\n  VERSION 1310 \r\n  WORLD_SCALE 0.01 \r\n  BEGIN_SUBSPACE default_subspace \r\n    GRAVITY 0 0 -9.81 \r\n    TOLERANCE 0.007 \r\n    RESOLVER ComplexFriction \r\n    BEGIN_COLLECTION RBCollection RBCollection01 \r\n      BEGIN_RIGID_BODY golf_ball_1 \r\n        ELLASTICITY 0.6 \r\n        STATIC_FRICTION 0.8 \r\n        DYNAMIC_FRICTION 0.4 \r\n        ROTATION 0 0 0 0 \r\n        TRANSLATION 1 2 3 \r\n        LINEAR_VELOCITY 0 0 0 \r\n        ANGULAR_VELOCITY 0 0 0 \r\n        COLLISIONS_DISABLED FALSE \r\n        ACTIVE TRUE \r\n        DISPLACEMENT 0 0 0 \r\n        BEGIN_PRIMITIVE SphericalPrimitive golf_ball_1 \r\n          MASS 1 \r\n          ROTATION 0 0 0 0 \r\n          TRANSLATION 0 0 0 \r\n          RADIUS 0.054 \r\n          COLLISIONS_DISABLED FALSE \r\n        END_PRIMITIVE \r\n      END_RIGID_BODY \r\n    END_COLLECTION \r\n    BEGIN_ACTION Drag Drag_1 \r\n      LINEAR_DRAG 0.35 \r\n      ANGULAR_DRAG 0.005\r\n    END_ACTION \r\n  END_SUBSPACE \r\nEND_WORLD \r\n";
+        let w = parse_hke(text);
+        assert_eq!(w.world_scale, 0.01);
+        assert_eq!(w.gravity, Some([0.0, 0.0, -9.81]));
+        assert_eq!(w.tolerance, Some(0.007));
+        assert_eq!(w.bodies.len(), 1);
+        let b = &w.bodies[0];
+        assert_eq!(b.name.as_str(), "golf_ball_1");
+        assert_eq!(b.total_mass, 1.0);
+        assert_eq!(b.restitution, Some(0.6));
+        assert_eq!(b.static_friction, Some(0.8));
+        assert_eq!(b.translation, Some([1.0, 2.0, 3.0]));
+        assert_eq!(b.active, Some(true));
+        assert_eq!(b.collisions_disabled, Some(false));
+        assert!(matches!(b.primitives[0].kind, HkePrimitiveKind::Sphere { radius } if (radius - 0.054).abs() < 1e-6));
+        let d = w.drag.as_ref().unwrap();
+        assert_eq!((d.linear_drag, d.angular_drag), (0.35, 0.005));
+        // the binary form is untouched
+        assert!(!is_text_hke(&[0x00, 0x01, 0x02, 0x03, 0x04, b'x', 0]));
+    }
+}
