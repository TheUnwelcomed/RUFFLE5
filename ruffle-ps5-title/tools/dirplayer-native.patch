+
+    /// Renders the stage; returns its RGBA pixels (`width * height * 4` bytes) and size.
+    pub fn render(&mut self) -> (&[u8], u32, u32) {
+        let (w, h) = self.stage_size();
+        let fits = self.stage.as_ref().is_some_and(|b| b.width as u32 == w && b.height as u32 == h);
+        if !fits {
+            self.stage = Some(Bitmap::new(w as u16, h as u16, 32, 32, 0, PaletteRef::BuiltIn(get_system_default_palette())));
+        }
+        let bitmap = self.stage.as_mut().unwrap();
+        reserve_player_mut(|player| {
+            // 1.000.030: what the web renderers do before drawing a frame for 3D: in-place
+            // Transform3d / shader-list changes made by scripts reach the scene; the frame's
+            // "3D has rendered" flag starts clear and is latched after the draw.
+            crate::player::handlers::datum_handlers::shockwave3d_object::sync_persistent_transforms(player);
+            crate::player::handlers::datum_handlers::shockwave3d_object::sync_shader_texture_lists(player);
+            player.w3d_rendered_this_frame = false;
+            render_stage_to_bitmap(player, bitmap, None);
+            player.w3d_any_rendered = player.w3d_rendered_this_frame;
+        });
+        (&bitmap.data[..], w, h)
+    }
+
+    /// A key went down. `key` and `code` as a browser's `KeyboardEvent` has them (`"ArrowLeft"`,
+    /// 37; `"a"`, 65; `" "`, 32; `"Enter"`, 13): the VM maps them to Director's.
+    pub async fn key_down(&mut self, key: &str, code: u16) {
+        reserve_player_mut(|player| player.keyboard_manager.key_down(key.to_string(), code));
+        let _ = run_player_command(PlayerVMCommand::KeyDown(key.to_string(), code)).await;
+        run_flash_calls().await;
+    }
+
+    pub async fn key_up(&mut self, key: &str, code: u16) {
+        reserve_player_mut(|player| player.keyboard_manager.key_up(key, code));
+        let _ = run_player_command(PlayerVMCommand::KeyUp(key.to_string(), code)).await;
+        run_flash_calls().await;
+    }
+
+    /// The mouse moved to `(x, y)` in stage pixels.
+    pub async fn mouse_move(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| player.mouse_loc = (x, y));
+        let _ = run_player_command(PlayerVMCommand::MouseMove((x, y))).await;
+        flash_mouse_move(x, y);
+        run_flash_calls().await;
+    }
+
+    /// A click on a Flash sprite reaches its movie too (commands.rs forwards it to the Flash
+    /// host, as the web build forwards it to the sprite's Ruffle player); what the movie says to
+    /// Lingo then runs at once.
+    pub async fn mouse_down(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| {
+            player.mouse_loc = (x, y);
+            player.movie.mouse_down = true;
+        });
+        let _ = run_player_command(PlayerVMCommand::MouseDown((x, y))).await;
+        run_flash_calls().await;
+    }
+
+    pub async fn mouse_up(&mut self, x: i32, y: i32) {
+        reserve_player_mut(|player| {
+            player.mouse_loc = (x, y);
+            player.movie.mouse_down = false;
+        });
+        let _ = run_player_command(PlayerVMCommand::MouseUp((x, y))).await;
+        run_flash_calls().await;
+    }
+}
+
+impl Drop for NativePlayer {
+    fn drop(&mut self) {
+        crate::player::native_audio::stop_all();
+        // 1.000.036: the Flash members' players go with the movie
+        super::flash_host::set_host(None);
+        super::flash_host::clear_calls();
+        unsafe {
+            // As the test harness does: the VM's globals hold references into the player, so it
+            // is leaked rather than dropped.
+            if let Some(player) = PLAYER_OPT.take() {
+                std::mem::forget(player);
+            }
+            crate::player::PLAYER_TX = None;
+            crate::player::PLAYER_EVENT_TX = None;
+        }
+    }
+}
