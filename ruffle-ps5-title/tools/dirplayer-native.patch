+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use super::calc::*;
+
+    #[test]
+    fn civil_days_round_trip() {
+        assert_eq!(days_from_civil(1970, 1, 1), 0);
+        assert_eq!(days_from_civil(2000, 3, 1), 11_017);
+        assert_eq!(civil_from_days(-1), (1969, 12, 31));
+        for z in [-719_468i64, -1, 0, 59, 10_957, 20_750, 2_932_896] {
+            let (y, m, d) = civil_from_days(z);
+            assert_eq!(days_from_civil(y, m, d), z);
+        }
+    }
+
+    #[test]
+    fn javascript_rules() {
+        // Date.UTC(2026, 9, 25, 5, 29, 7, 123) = 1792906147123
+        let t = make_date(make_day(2026.0, 9.0, 25.0), make_time(5.0, 29.0, 7.0, 123.0));
+        assert_eq!(t, 1_792_906_147_123.0);
+        assert_eq!(ymdw(t), (2026.0, 9.0, 25.0, 0.0)); // a Sunday
+        assert_eq!(hmsm(t), (5.0, 29.0, 7.0, 123.0));
+        // months and days past their range carry over, as setMonth(12) / setDate(0) do
+        assert_eq!(make_day(2026.0, 12.0, 1.0), make_day(2027.0, 0.0, 1.0));
+        assert_eq!(make_day(2026.0, 2.0, 0.0), make_day(2026.0, 1.0, 28.0));
+        assert_eq!(make_day(2024.0, -1.0, 31.0), make_day(2023.0, 11.0, 31.0));
+        // before 1970
+        assert_eq!(ymdw(-1.0), (1969.0, 11.0, 31.0, 3.0));
+        assert_eq!(hmsm(-1.0), (23.0, 59.0, 59.0, 999.0));
+        assert!(time_clip(8.64e15 + 1.0).is_nan());
+        assert_eq!(time_clip(-8.64e15), -8.64e15);
+    }
+}
