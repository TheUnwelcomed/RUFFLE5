+/// PS5_RUFFLE_DIRPLAYER_NATIVE (1.000.028): the casts a movie's cast list (`MCsL`) names, as
+/// (name, file path) — the file path empty for a cast inside the movie — read without a player:
+/// only the file's map, key table, config and cast list. `read_director_file_bytes` also reads the
+/// score, whose behaviours' parameters the running player evaluates (with no player that is
+/// undefined behaviour). A movie before Director 5 has no cast list: an empty list.
+pub fn read_cast_list_bytes(bytes: &Vec<u8>) -> Result<Vec<(String, String)>, String> {
+    let mut reader = binary_reader::BinaryReader::from_vec(bytes);
+    reader.set_endian(binary_reader::Endian::Big);
+    let mut chunk_container = ChunkContainer {
+        cached_chunk_views: HashMap::new(),
+        chunk_info: HashMap::new(),
+        deserialized_chunks: HashMap::new(),
+    };
+    let meta_fourcc = reader.read_u32().map_err(|e| format!("Failed to read file header: {}", e))?;
+    if meta_fourcc == FOURCC("XFIR") {
+        reader.set_endian(binary_reader::Endian::Little);
+    } else if meta_fourcc != FOURCC("RIFX") {
+        return Err("not a Director file".to_owned());
+    }
+    let _ = reader.read_u32().map_err(|e| format!("Failed to read meta length: {}", e))?;
+    let codec = reader.read_u32().map_err(|e| format!("Failed to read codec: {}", e))?;
+    let mut after_burned = false;
+    let mut ils_body_offset: usize = 0;
+    if codec == FOURCC("MV93") || codec == FOURCC("MC95") {
+        read_memory_map(&mut reader, &mut chunk_container.chunk_info)?;
+    } else if codec == FOURCC("FGDM") || codec == FOURCC("FGDC") {
+        after_burned = true;
+        ils_body_offset = read_after_burner_map(&mut reader, &mut chunk_container.cached_chunk_views, &mut chunk_container.chunk_info)?;
+    } else {
+        return Err("Invalid codec".to_owned());
+    }
+    let mut rifx = RIFXReaderContext { after_burned, ils_body_offset, dir_version: 0, lctx_capital_x: false };
+    let _key_table = read_key_table(&mut reader, &mut chunk_container, &mut rifx)?;
+    let config = read_config(&mut reader, &mut chunk_container, &mut rifx)?;
+    rifx.dir_version = human_version(config.director_version);
+    if rifx.dir_version < 500 {
+        return Ok(Vec::new());
+    }
+    Ok(get_cast_list_chunk(&mut reader, &mut chunk_container, &mut rifx)
+        .map(|list| list.entries.into_iter().map(|e| (e.name, e.file_path)).collect())
+        .unwrap_or_default())
+}
