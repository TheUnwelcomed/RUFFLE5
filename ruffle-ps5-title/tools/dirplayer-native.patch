@@ -0,0 +1,348 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: the clock and calendar DirPlayer took from the browser —
+//! `Date.now()`, `new Date(ms)` read and set in local time, `toLocaleDateString` /
+//! `toLocaleTimeString` — behind one type.
+//!
+//! On the web it is js_sys, called exactly as before. Elsewhere a browser call panics ("cannot
+//! call wasm-bindgen imported functions on non-wasm targets"): there the same arithmetic as
+//! JavaScript's Date (ECMA-262 §21.4.1: time values, Day/TimeWithinDay, MakeTime, MakeDay,
+//! MakeDate, TimeClip, LocalTime and UTC), over chrono's local time zone (the one `the date` and
+//! `the time` already use); the strings are what an en-US browser gives for the same options.
+
+/// Milliseconds since 1970-01-01T00:00:00Z, as `Date.now()`.
+#[cfg(target_arch = "wasm32")]
+pub fn now_ms() -> f64 {
+    js_sys::Date::now()
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub fn now_ms() -> f64 {
+    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
+        Ok(d) => d.as_millis() as f64,
+        Err(e) => -(e.duration().as_millis() as f64),
+    }
+}
+
+/// A date as JavaScript holds one: a time value (ms since the epoch, UTC; NaN when invalid), read
+/// and changed in local time. The methods are js_sys::Date's, with its argument and result types.
+#[cfg(target_arch = "wasm32")]
+pub struct LocalDate(js_sys::Date);
+
+#[cfg(target_arch = "wasm32")]
+impl LocalDate {
+    pub fn now() -> Self {
+        LocalDate(js_sys::Date::new_0())
+    }
+    pub fn from_ms(ms: f64) -> Self {
+        LocalDate(js_sys::Date::new(&wasm_bindgen::JsValue::from_f64(ms)))
+    }
+    pub fn get_time(&self) -> f64 {
+        self.0.get_time()
+    }
+    pub fn get_full_year(&self) -> u32 {
+        self.0.get_full_year()
+    }
+    pub fn get_month(&self) -> u32 {
+        self.0.get_month()
+    }
+    pub fn get_date(&self) -> u32 {
+        self.0.get_date()
+    }
+    pub fn get_day(&self) -> u32 {
+        self.0.get_day()
+    }
+    pub fn get_hours(&self) -> u32 {
+        self.0.get_hours()
+    }
+    pub fn get_minutes(&self) -> u32 {
+        self.0.get_minutes()
+    }
+    pub fn get_seconds(&self) -> u32 {
+        self.0.get_seconds()
+    }
+    pub fn get_milliseconds(&self) -> u32 {
+        self.0.get_milliseconds()
+    }
+    pub fn set_full_year(&mut self, v: u32) -> f64 {
+        self.0.set_full_year(v)
+    }
+    pub fn set_month(&mut self, v: u32) -> f64 {
+        self.0.set_month(v)
+    }
+    pub fn set_date(&mut self, v: u32) -> f64 {
+        self.0.set_date(v)
+    }
+    pub fn set_hours(&mut self, v: u32) -> f64 {
+        self.0.set_hours(v)
+    }
+    pub fn set_minutes(&mut self, v: u32) -> f64 {
+        self.0.set_minutes(v)
+    }
