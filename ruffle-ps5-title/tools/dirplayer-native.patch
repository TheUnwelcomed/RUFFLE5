+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod golf_flight_tests {
+    //! A golf ball in free flight, with 3D Golf's (zapak 1178, the Golf Ace
+    //! engine) own numbers: the HKE's unit-mass sphere, worldScale 0.01,
+    //! `dragParameters [0.45, 0.0025]`, gravity (0, 0, -981), 14 substeps,
+    //! and `Shoot`'s impulse `dir * energy * 100 * shootPower`.
+    //!
+    //! Linear drag is F = -k v, which in display units reads the same as in
+    //! metres (both v and F/m scale by 1/worldScale), so the carry has a closed
+    //! form to check against: x(t) = vx0 (1 - e^{-kt}) / k.
+    use crate::player::cast_member::{HavokPhysicsState, HavokRigidBody};
+    use crate::player::symbols::symbol::Symbol;
+    use crate::player::symbols::symbol_table::init_symbol_table;
+    use super::super::havok_physics::{recompute_body_inertia, sphere_inertia, step_native};
+
+    fn carry(shoot_power: f64, inclination: f64, energy: f64, dt: f64) -> (f64, f64) {
+        init_symbol_table();
+        let mut state = HavokPhysicsState::default();
+        state.scale = 0.01;
+        state.gravity = [0.0, 0.0, -981.0];
+        state.drag_params = [0.45, 0.0025];
+        let mut rb = HavokRigidBody::new_movable(Symbol::from_str("golf_ball_1"), 1.0, true);
+        let r = 0.054 / 0.01;
+        let i = sphere_inertia(1.0, r);
+        let unit_i: [f64; 9] = std::array::from_fn(|k| i[k]);
+        recompute_body_inertia(1.0, unit_i, &mut rb.inertia_tensor, &mut rb.inverse_inertia_tensor, &mut rb.inverse_mass);
+        rb.unit_inertia_tensor = unit_i;
+        rb.position = [0.0, 0.0, 1000.0];
+        rb.active = true;
+        state.rigid_bodies.push(rb);
+        let (c, s) = (inclination.cos(), inclination.sin());
+        let v = energy * 100.0 * shoot_power;
+        state.rigid_bodies[0].linear_velocity = [v * c, 0.0, v * s];
+        let mut t = 0.0;
+        loop {
+            step_native(&mut state, dt, 14);
+            t += dt;
+            if state.rigid_bodies[0].position[2] <= 1000.0 || t > 30.0 {
+                break;
+            }
+        }
+        (state.rigid_bodies[0].position[0], t)
+    }
+
+    fn closed_form(shoot_power: f64, inclination: f64, energy: f64) -> (f64, f64) {
+        let (k, g) = (0.45, 981.0);
+        let v = energy * 100.0 * shoot_power;
+        let (vx, vz) = (v * inclination.cos(), v * inclination.sin());
+        let (mut z, mut vzz, mut t) = (0.0, vz, 0.0);
+        let h = 0.0005;
+        while t == 0.0 || z > 0.0 {
+            vzz += (-g - k * vzz) * h;
+            z += vzz * h;
+            t += h;
+        }
+        (vx * (1.0 - (-k * t).exp()) / k, t)
+    }
