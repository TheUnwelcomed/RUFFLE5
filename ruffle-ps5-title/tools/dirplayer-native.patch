+// ---- particles ----
+
+pub struct ParticleProg {
+    view_projection: [f32; 16],
+    camera_right: [f32; 3],
+    camera_up: [f32; 3],
+    size_start: f32,
+    size_end: f32,
+    lifetime: f32,
+    color_start: [f32; 3],
+    color_end: [f32; 3],
+    blend_start: f32,
+    blend_end: f32,
+    has_tex: i32,
+    tex: Option<SamplerTex>,
+}
+
+impl Program for ParticleProg {
+    fn interp(&self) -> usize {
+        3
+    }
+
+    fn vertex(&self, a: &[[f32; 4]; NATTR]) -> VOut {
+        let center = [a[0][0], a[0][1], a[0][2]];
+        let age = a[1][0];
+        let corner = [a[2][0], a[2][1]];
+        let age_ratio = (age / self.lifetime).clamp(0.0, 1.0);
+        let size = (self.size_start + (self.size_end - self.size_start) * age_ratio) * 0.5;
+        let cc = mul4(&self.view_projection, [center[0], center[1], center[2], 1.0]);
+        let e = add3(center, scale3(self.camera_right, size));
+        let ec = mul4(&self.view_projection, [e[0], e[1], e[2], 1.0]);
+        let bad = cc[3] <= 0.0001 || ec[3] <= 0.0001;
+        let ndc_half = if bad {
+            1e9
+        } else {
+            let dx = ec[0] / ec[3] - cc[0] / cc[3];
+            let dy = ec[1] / ec[3] - cc[1] / cc[3];
+            (dx * dx + dy * dy).sqrt()
+        };
+        let pos = if bad || ndc_half > 1.0 {
+            [2.0, 2.0, 2.0, 1.0]
+        } else {
+            let w = add3(add3(center, scale3(self.camera_right, corner[0] * size)), scale3(self.camera_up, corner[1] * size));
+            mul4(&self.view_projection, [w[0], w[1], w[2], 1.0])
+        };
+        let mut o = VOut { pos, v: [0.0; MAXV] };
+        o.v[0] = age_ratio;
+        o.v[1] = corner[0] * 0.5 + 0.5;
+        o.v[2] = corner[1] * 0.5 + 0.5;
+        o
+    }
+
+    fn fragment(&self, f: &Frag) -> Option<[f32; 4]> {
+        let t = f.v[0];
+        let mut color = mix3(self.color_start, self.color_end, t);
+        let opacity = ((self.blend_start + (self.blend_end - self.blend_start) * t) / 100.0).clamp(0.0, 1.0);
+        let alpha = if self.has_tex > 0 {
+            let tex = sample(&self.tex, f.v[1], f.v[2], f, 1, 2);
+            color = mulc3(color, [tex[0], tex[1], tex[2]]);
+            tex[3]
+        } else {
+            let (dx, dy) = (f.v[1] - 0.5, f.v[2] - 0.5);
+            let dist = (dx * dx + dy * dy).sqrt() * 2.0;
+            if dist > 1.0 {
+                return None;
+            }
+            1.0 - dist * dist
+        };
+        Some([color[0], color[1], color[2], alpha * opacity])
+    }
+}
+
+// ---- post-processing ----
+
+pub struct PostProg {
+    input: Option<SamplerTex>,
+    resolution: [f32; 2],
+    direction: [f32; 2],
+    threshold: f32,
+    intensity: f32,
+    mode: i32,
+    color_matrix: [f32; 16],
+}
+
+impl Program for PostProg {
+    fn interp(&self) -> usize {
+        2
+    }
+
+    fn vertex(&self, a: &[[f32; 4]; NATTR]) -> VOut {
+        let mut o = VOut { pos: [a[0][0], a[0][1], 0.0, 1.0], v: [0.0; MAXV] };
+        o.v[0] = a[0][0] * 0.5 + 0.5;
+        o.v[1] = a[0][1] * 0.5 + 0.5;
+        o
+    }
+
+    fn fragment(&self, f: &Frag) -> Option<[f32; 4]> {
+        let (u, v) = (f.v[0], f.v[1]);
+        let at = |du: f32, dv: f32| -> [f32; 4] { sample(&self.input, u + du, v + dv, f, 0, 1) };
+        let color = at(0.0, 0.0);
+        let lum = |c: [f32; 4]| c[0] * 0.299 + c[1] * 0.587 + c[2] * 0.114;
+        Some(match self.mode {
+            0 => {
+                let l = lum(color);
+                if l > self.threshold {
+                    [color[0] - self.threshold, color[1] - self.threshold, color[2] - self.threshold, 1.0]
+                } else {
+                    [0.0, 0.0, 0.0, 1.0]
+                }
+            }
+            1 => {
+                let tx = self.direction[0] / self.resolution[0];
+                let ty = self.direction[1] / self.resolution[1];
+                let mut r = scale3([color[0], color[1], color[2]], 0.227);
+                for (k, w) in [(1.0, 0.1945), (2.0, 0.1216), (3.0, 0.0540), (4.0, 0.0162)] {
+                    let p = at(tx * k, ty * k);
+                    let m = at(-tx * k, -ty * k);
+                    r = add3(r, scale3([p[0], p[1], p[2]], w));
+                    r = add3(r, scale3([m[0], m[1], m[2]], w));
+                }
+                [r[0], r[1], r[2], 1.0]
+            }
+            2 => [color[0] * self.intensity, color[1] * self.intensity, color[2] * self.intensity, 1.0],
+            3 => {
+                let c = mul4(&self.color_matrix, color);
+                [c[0], c[1], c[2], color[3]]
+            }
+            4 => {
+                let l = lum(color);
+                let x = u * self.resolution[0] * 12.9898 + v * self.resolution[1] * 78.233;
+                let noise = ((x.sin() * 43758.547).fract()) * 0.05;
+                let g = (l * 2.0 + noise).clamp(0.0, 1.0);
+                [g * 0.1, g, g * 0.1, 1.0]
+            }
+            5 => {
+                let (tx, ty) = (1.0 / self.resolution[0], 1.0 / self.resolution[1]);
+                let radius = self.threshold;
+                let mut r = [0.0f32; 3];
+                let mut total = 0.0;
+                for x in -2i32..=2 {
+                    for y in -2i32..=2 {
+                        let w = 1.0 / (1.0 + (x * x + y * y) as f32);
+                        let s = at(x as f32 * tx * radius, y as f32 * ty * radius);
+                        r = add3(r, scale3([s[0], s[1], s[2]], w));
+                        total += w;
+                    }
+                }
+                [r[0] / total, r[1] / total, r[2] / total, 1.0]
+            }
+            _ => color,
+        })
+    }
+}
+
+// ---- #inker outline ----
+
+pub struct OutlineProg {
+    model: [f32; 16],
+    view: [f32; 16],
+    projection: [f32; 16],
+    outline_width: f32,
+    outline_pixels: f32,
+    viewport: [f32; 2],
+    far_only: f32,
+    outline_color: [f32; 4],
+}
+
+impl Program for OutlineProg {
+    fn interp(&self) -> usize {
+        1
+    }
+
+    fn vertex(&self, a: &[[f32; 4]; NATTR]) -> VOut {
+        let n = [a[1][0], a[1][1], a[1][2]];
+        let p = add3([a[0][0], a[0][1], a[0][2]], scale3(n, self.outline_width));
+        let vm = mat_mul(&self.view, &self.model);
+        let pv = mul4(&vm, [p[0], p[1], p[2], 1.0]);
+        let mut clip = mul4(&self.projection, pv);
+        let nv = normalize3(mul3(&vm, n));
+        let facing = dot3(nv, normalize3([pv[0], pv[1], pv[2]]));
+        if self.outline_pixels > 0.0 {
+            let nc = mul4(&self.projection, [nv[0], nv[1], nv[2], 0.0]);
+            let l2 = nc[0] * nc[0] + nc[1] * nc[1];
+            if l2 > 1e-12 {
+                let l = l2.sqrt();
+                clip[0] += nc[0] / l * (self.outline_pixels * 2.0 / self.viewport[0]) * clip[3];
+                clip[1] += nc[1] / l * (self.outline_pixels * 2.0 / self.viewport[1]) * clip[3];
+            }
+        }
+        let mut o = VOut { pos: clip, v: [0.0; MAXV] };
+        o.v[0] = facing;
+        o
+    }
+
+    fn fragment(&self, f: &Frag) -> Option<[f32; 4]> {
+        if self.far_only > 0.5 && f.v[0] <= 0.0 {
+            return None;
+        }
+        Some(self.outline_color)
+    }
+}
