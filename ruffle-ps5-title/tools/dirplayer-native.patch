new file mode 100644
index 00000000..fbf31838
--- /dev/null
+++ b/vm-rust/src/player/native_audio.rs
@@ -0,0 +1,265 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE — sound without a browser.
+//!
+//! On the web every sound channel plays through Web Audio (an `AudioContext`, buffer sources,
+//! gain and panner nodes). Off the web — Ruffle5 on the PS5, the native tests — there is no
+//! `AudioContext`, so a channel hands its decoded samples to this mixer instead: one [`Voice`] per
+//! playing sound, mixed on demand into whatever buffer the host's audio thread asks for
+//! ([`mix`]). The channel keeps owning the playback *state* (status, loops, playlists, fades,
+//! cues); a voice only knows its samples, where it is, its volume and pan, and whether it has
+//! reached the end — which `SoundChannel::update` turns into the same "ended" the Web Audio
+//! callback reports.
+//!
+//! MP3 (Shockwave Audio, and MP3 cast members) is decoded with Symphonia, the decoder Ruffle
+//! uses; the web build hands those bytes to the browser's `decodeAudioData` instead.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+
+/// One playing sound: its samples (interleaved, `channels` per frame) and where it is.
+pub struct Voice {
+    samples: Arc<Vec<f32>>,
+    channels: usize,
+    frames: usize,
+    rate: f64,
+    looping: bool,
+    /// Playback position in source frames (an `f64`, stored as bits).
+    pos: AtomicU64,
+    /// Linear gain 0..1 and pan -1..1 (`f32` bits).
+    volume: AtomicU32,
+    pan: AtomicU32,
+    paused: AtomicBool,
+    stopped: AtomicBool,
+    finished: AtomicBool,
+}
+
+impl Voice {
+    /// `samples` interleaved with `channels` per frame (1 or 2 are mixed; more use the first two).
+    pub fn new(samples: Arc<Vec<f32>>, channels: u16, rate: u32, looping: bool, volume: f32, pan: f32) -> Arc<Voice> {
+        let channels = (channels.max(1)) as usize;
+        let frames = samples.len() / channels;
+        Arc::new(Voice {
+            samples,
+            channels,
+            frames,
+            rate: rate.max(1) as f64,
+            looping,
+            pos: AtomicU64::new(0f64.to_bits()),
+            volume: AtomicU32::new(volume.clamp(0.0, 1.0).to_bits()),
+            pan: AtomicU32::new(pan.clamp(-1.0, 1.0).to_bits()),
+            paused: AtomicBool::new(false),
+            stopped: AtomicBool::new(false),
+            finished: AtomicBool::new(frames == 0),
+        })
+    }
+
+    pub fn set_volume(&self, volume: f32) {
+        self.volume.store(volume.clamp(0.0, 1.0).to_bits(), Ordering::Relaxed);
+    }
+
+    pub fn set_pan(&self, pan: f32) {
+        self.pan.store(pan.clamp(-1.0, 1.0).to_bits(), Ordering::Relaxed);
+    }
+
+    pub fn set_paused(&self, paused: bool) {
+        self.paused.store(paused, Ordering::Relaxed);
+    }
+
+    /// Silences the voice at once; the mixer drops it.
+    pub fn stop(&self) {
+        self.stopped.store(true, Ordering::Relaxed);
+    }
+
+    /// Played to its end (a looping voice never is).
+    pub fn is_finished(&self) -> bool {
+        self.finished.load(Ordering::Relaxed)
+    }
+
+    /// Seconds into the sound.
+    pub fn position_secs(&self) -> f64 {
+        f64::from_bits(self.pos.load(Ordering::Relaxed)) / self.rate
+    }
+
+    pub fn duration_secs(&self) -> f64 {
+        self.frames as f64 / self.rate
+    }
+
+    #[inline]
+    fn frame(&self, i: usize) -> (f32, f32) {
+        let base = i * self.channels;
+        let l = self.samples[base];
+        let r = if self.channels > 1 { self.samples[base + 1] } else { l };
+        (l, r)
+    }
+
+    /// Adds this voice into `out` (interleaved stereo) at `out_rate`.
+    fn mix_into(&self, out: &mut [f32], out_rate: f64) {
+        if self.paused.load(Ordering::Relaxed) || self.stopped.load(Ordering::Relaxed) || self.is_finished() {
+            return;
+        }
+        let volume = f32::from_bits(self.volume.load(Ordering::Relaxed));
+        let pan = f32::from_bits(self.pan.load(Ordering::Relaxed));
+        // Web Audio's StereoPannerNode on a stereo source keeps the near side and moves part of
+        // the far side across; for the mix here a linear balance is close enough.
+        let gl = volume * (1.0 - pan.max(0.0));
+        let gr = volume * (1.0 + pan.min(0.0));
+        let step = self.rate / out_rate;
+        let mut pos = f64::from_bits(self.pos.load(Ordering::Relaxed));
+        let frames = self.frames;
+        for o in out.chunks_exact_mut(2) {
+            if pos >= frames as f64 {
+                if self.looping && frames > 0 {
+                    pos %= frames as f64;
+                } else {
+                    self.finished.store(true, Ordering::Relaxed);
+                    break;
+                }
+            }
+            let i = pos as usize;
+            let t = (pos - i as f64) as f32;
+            let (l0, r0) = self.frame(i);
+            let next = if i + 1 < frames { i + 1 } else if self.looping { 0 } else { i };
+            let (l1, r1) = self.frame(next);
+            o[0] += (l0 + (l1 - l0) * t) * gl;
+            o[1] += (r0 + (r1 - r0) * t) * gr;
+            pos += step;
+        }
+        self.pos.store(pos.to_bits(), Ordering::Relaxed);
+    }
+}
+
+static VOICES: Mutex<Vec<Arc<Voice>>> = Mutex::new(Vec::new());
+
+/// Starts mixing `voice`.
+pub fn start(voice: &Arc<Voice>) {
+    if let Ok(mut voices) = VOICES.lock() {
+        voices.push(voice.clone());
+    }
+}
+
+/// Silences every voice (a movie ends, or the host leaves it).
+pub fn stop_all() {
+    if let Ok(mut voices) = VOICES.lock() {
+        for v in voices.iter() {
+            v.stop();
+        }
+        voices.clear();
+    }
+}
+
+/// How many voices are playing.
+pub fn playing() -> usize {
+    VOICES.lock().map(|v| v.len()).unwrap_or(0)
+}
+
+/// Adds every playing voice into `out`, interleaved stereo `f32` at `out_rate` Hz (the caller
+/// zeroes it first, and clamps when converting to integers). Voices that ended or were stopped are
+/// dropped here.
+pub fn mix(out: &mut [f32], out_rate: u32) {
+    let Ok(mut voices) = VOICES.lock() else { return };
+    voices.retain(|v| !v.stopped.load(Ordering::Relaxed) && !v.is_finished());
+    for v in voices.iter() {
+        v.mix_into(out, out_rate as f64);
+    }
+}
+
+type Decoded = (Arc<Vec<f32>>, u32, u16);
+
+/// [`decode_mp3`], remembering the last few results: a game plays the same punch or jingle many
+/// times, and decoding it again each time would cost a frame's worth of CPU for longer sounds.
+pub fn decode_mp3_cached(bytes: &[u8]) -> Option<Decoded> {
+    const KEEP: usize = 64;
+    static CACHE: Mutex<Vec<(u64, usize, Decoded)>> = Mutex::new(Vec::new());
+    // FNV-1a over the bytes: cheap next to decoding them.
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in bytes {
+        h = (h ^ *b as u64).wrapping_mul(0x100000001b3);
+    }
+    if let Ok(cache) = CACHE.lock() {
+        if let Some((_, _, d)) = cache.iter().find(|(k, len, _)| *k == h && *len == bytes.len()) {
+            return Some(d.clone());
+        }
+    }
+    let (samples, rate, channels) = decode_mp3(bytes)?;
+    let decoded: Decoded = (Arc::new(samples), rate, channels);
+    if let Ok(mut cache) = CACHE.lock() {
+        if cache.len() >= KEEP {
+            cache.remove(0);
+        }
+        cache.push((h, bytes.len(), decoded.clone()));
+    }
+    Some(decoded)
+}
+
+/// An MP3 stream (MPEG-1/2 layer III, as Shockwave Audio and MP3 members hold it) to samples:
+/// (interleaved f32, sample rate, channels). `None` if Symphonia finds no stream in it.
+pub fn decode_mp3(bytes: &[u8]) -> Option<(Vec<f32>, u32, u16)> {
+    use symphonia::core::{audio::SampleBuffer, errors::Error, formats::FormatReader, io};
+    use symphonia::default::formats::MpaReader;
+
+    let cursor = std::io::Cursor::new(bytes.to_vec());
+    let source = io::MediaSourceStream::new(Box::new(cursor) as Box<dyn io::MediaSource>, Default::default());
+    let mut reader = MpaReader::try_new(source, &Default::default()).ok()?;
+    let track = reader.default_track()?;
+    let params = track.codec_params.clone();
+    let mut decoder = symphonia::default::get_codecs().make(&params, &Default::default()).ok()?;
+    let mut rate = params.sample_rate.unwrap_or(0);
+    let mut channels = params.channels.map(|c| c.count() as u16).unwrap_or(0);
+    let mut out: Vec<f32> = Vec::new();
+    let mut buf: Option<SampleBuffer<f32>> = None;
+    loop {
+        let packet = match reader.next_packet() {
+            Ok(p) => p,
+            Err(_) => break,
+        };
+        match decoder.decode(&packet) {
+            Ok(decoded) => {
+                let spec = *decoded.spec();
+                rate = spec.rate;
+                channels = spec.channels.count() as u16;
+                let needed = decoded.capacity() as u64;
+                if buf.as_ref().map_or(true, |b| (b.capacity() as u64) < needed * spec.channels.count() as u64) {
+                    buf = Some(SampleBuffer::new(needed, spec));
+                }
+                let b = buf.as_mut().unwrap();
+                b.copy_interleaved_ref(decoded);
+                out.extend_from_slice(b.samples());
+            }
+            Err(Error::DecodeError(_)) => continue,
+            Err(_) => break,
+        }
+    }
+    if out.is_empty() || rate == 0 || channels == 0 {
+        return None;
+    }
+    Some((out, rate, channels))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_voice_plays_to_its_end_and_loops_when_asked() {
+        let once = Voice::new(Arc::new(vec![0.5; 100]), 1, 100, false, 1.0, 0.0);
+        let mut out = vec![0.0f32; 2 * 150];
+        once.mix_into(&mut out, 100.0);
+        assert!(once.is_finished());
+        assert_eq!(out[0], 0.5);
+        assert_eq!(out[2 * 120], 0.0);
+
+        let looping = Voice::new(Arc::new(vec![0.25; 10]), 1, 100, true, 1.0, 0.0);
+        let mut out = vec![0.0f32; 2 * 50];
+        looping.mix_into(&mut out, 100.0);
+        assert!(!looping.is_finished());
+        assert_eq!(out[2 * 45], 0.25);
+    }
+
+    #[test]
+    fn volume_and_pan_reach_the_mix() {
+        let v = Voice::new(Arc::new(vec![1.0; 10]), 1, 100, false, 0.5, 1.0);
+        let mut out = vec![0.0f32; 2 * 4];
+        v.mix_into(&mut out, 100.0);
+        assert_eq!((out[0], out[1]), (0.0, 0.5));
+    }
+}
diff --git a/vm-rust/src/player/native_rt.rs b/vm-rust/src/player/native_rt.rs
new file mode 100644
index 00000000..27ca6b1a
--- /dev/null
+++ b/vm-rust/src/player/native_rt.rs
@@ -0,0 +1,255 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE — DirPlayer's task executor and timers off the web, without
+//! async-std's runtime.
+//!
+//! On the web DirPlayer spawns its helper tasks with `async_std::task::spawn_local` and waits with
+//! `async_std::task::sleep` / `async_std::future::timeout`. Natively those run on async-io: a
+//! reactor (a kqueue on FreeBSD, woken by an EVFILT_USER event) and an "async-io" thread. On the
+//! PS5 that reactor does not start — `Poller::new()` answers EINVAL and async-io panics ("cannot
+//! initialize I/O event notification", Ruffle5 1.000.021 on hardware, 2026-10-24). DirPlayer does
+//! no I/O through it; it only needs a local executor and a clock. This is both:
+//!
+//! * [`spawn_local`] puts a task on this thread's `futures` `LocalPool`;
+//! * [`block_on`] polls the given future, runs the pool's tasks until they stall, wakes the
+//!   timers that are due, and otherwise parks the thread until the next deadline (at most 5 ms);
+//! * [`sleep`] and [`timeout`] are deadline futures registered with that loop.
+//!
+//! [`crate::player::rt`] picks these or async-std's per target.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::task::{Context, Poll, Wake, Waker};
+use std::time::{Duration, Instant};
+
+use futures::executor::{LocalPool, LocalSpawner};
+use futures::task::LocalSpawnExt;
+
+thread_local! {
+    /// The pool, while no `block_on` runs it (it is taken out for that).
+    static POOL: RefCell<Option<LocalPool>> = const { RefCell::new(None) };
+    /// The running (or resting) pool's spawner.
+    static SPAWNER: RefCell<Option<LocalSpawner>> = const { RefCell::new(None) };
+    /// Deadlines and the wakers waiting for them.
+    static TIMERS: RefCell<Vec<(Instant, Waker)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The longest the loop parks when nothing is due (a wake from another thread ends it sooner).
+const MAX_PARK: Duration = Duration::from_millis(5);
+
+fn spawner() -> LocalSpawner {
+    SPAWNER.with(|s| {
+        let mut s = s.borrow_mut();
+        if s.is_none() {
+            POOL.with(|p| {
+                let mut p = p.borrow_mut();
+                *s = Some(p.get_or_insert_with(LocalPool::new).spawner());
+            });
+        }
+        s.as_ref().expect("spawner").clone()
+    })
+}
+
+/// Runs `fut` on this thread's executor (while a [`block_on`] runs it). Like async-std's, the task
+/// is detached: it keeps running when nobody waits for it.
+pub fn spawn_local<F>(fut: F)
+where
+    F: Future<Output = ()> + 'static,
+{
+    if spawner().spawn_local(fut).is_err() {
+        log::warn!("native_rt: the executor is gone; task dropped");
+    }
+}
+
+/// Gives the tasks [`spawn_local`] started their turn: pending once, so [`block_on`] runs the
+/// pool until it stalls (and wakes the timers that are due) before carrying on.
+///
+/// 1.000.028: the host's frame loop (Ruffle5's src/shockwave.rs, dcr-probe) runs the whole game
+/// in one `block_on` and waits for the display with a plain sleep, so a frame that awaits nothing
+/// pending never gave the pool a turn: work DirPlayer spawns — a sound channel's playlist
+/// (`queue` + `play()`, `setPlayList`), net tasks — waited until some script happened to sleep
+/// (updateStage, nothing()). Trick or Treat Beat queues every sound and played none.
+pub async fn yield_now() {
+    struct YieldNow(bool);
+    impl Future for YieldNow {
+        type Output = ();
+        fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+            if self.0 {
+                return Poll::Ready(());
+            }
+            self.0 = true;
+            cx.waker().wake_by_ref();
+            Poll::Pending
+        }
+    }
+    YieldNow(false).await
+}
+
+/// A future ready once `deadline` has passed.
+pub struct Sleep {
+    deadline: Instant,
+}
+
+impl Future for Sleep {
+    type Output = ();
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        if Instant::now() >= self.deadline {
+            return Poll::Ready(());
+        }
+        let deadline = self.deadline;
+        TIMERS.with(|t| t.borrow_mut().push((deadline, cx.waker().clone())));
+        Poll::Pending
+    }
+}
+
+/// Ready after `dur`.
+pub fn sleep(dur: Duration) -> Sleep {
+    Sleep { deadline: Instant::now() + dur }
+}
+
+/// [`timeout`]'s error: the time ran out first.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct TimeoutError {
+    _private: (),
+}
+
+impl std::fmt::Display for TimeoutError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        "future has timed out".fmt(f)
+    }
+}
+
+impl std::error::Error for TimeoutError {}
+
+/// `f`'s output, or [`TimeoutError`] if `dur` passes first (async-std's `future::timeout`).
+pub async fn timeout<F, T>(dur: Duration, f: F) -> Result<T, TimeoutError>
+where
+    F: Future<Output = T>,
+{
+    let mut f = std::pin::pin!(f);
+    let mut deadline = sleep(dur);
+    std::future::poll_fn(|cx| {
+        if let Poll::Ready(v) = f.as_mut().poll(cx) {
+            return Poll::Ready(Ok(v));
+        }
+        match Pin::new(&mut deadline).poll(cx) {
+            Poll::Ready(()) => Poll::Ready(Err(TimeoutError { _private: () })),
+            Poll::Pending => Poll::Pending,
+        }
+    })
+    .await
+}
+
+/// Wakes the timers that are due. (true if any were, the next deadline if any is left)
+fn fire_timers() -> (bool, Option<Instant>) {
+    let now = Instant::now();
+    let due: Vec<Waker> = TIMERS.with(|t| {
+        let mut t = t.borrow_mut();
+        let mut due = Vec::new();
+        t.retain(|(at, w)| {
+            if *at <= now {
+                due.push(w.clone());
+                false
+            } else {
+                true
+            }
+        });
+        due
+    });
+    let fired = !due.is_empty();
+    for w in due {
+        w.wake();
+    }
+    let next = TIMERS.with(|t| t.borrow().iter().map(|(at, _)| *at).min());
+    (fired, next)
+}
+
+/// The main future's waker: a flag, and the thread to unpark.
+struct MainWake {
+    woken: AtomicBool,
+    thread: std::thread::Thread,
+}
+
+impl Wake for MainWake {
+    fn wake(self: Arc<Self>) {
+        self.wake_by_ref();
+    }
+    fn wake_by_ref(self: &Arc<Self>) {
+        self.woken.store(true, Ordering::Release);
+        self.thread.unpark();
+    }
+}
+
+/// Runs `f` to completion on this thread, running the spawned tasks and the timers meanwhile.
+pub fn block_on<F: Future>(f: F) -> F::Output {
+    let mut pool = POOL.with(|p| p.borrow_mut().take()).unwrap_or_else(LocalPool::new);
+    SPAWNER.with(|s| *s.borrow_mut() = Some(pool.spawner()));
+    let main = Arc::new(MainWake { woken: AtomicBool::new(true), thread: std::thread::current() });
+    let waker = Waker::from(main.clone());
+    let mut cx = Context::from_waker(&waker);
+    let mut f = std::pin::pin!(f);
+    let out = loop {
+        if main.woken.swap(false, Ordering::AcqRel) {
+            if let Poll::Ready(v) = f.as_mut().poll(&mut cx) {
+                break v;
+            }
+        }
+        pool.run_until_stalled();
+        let (fired, next) = fire_timers();
+        if fired || main.woken.load(Ordering::Acquire) {
+            continue;
+        }
+        let wait = next.map_or(MAX_PARK, |at| at.saturating_duration_since(Instant::now()).min(MAX_PARK));
+        if !wait.is_zero() {
+            std::thread::park_timeout(wait);
+        }
+    };
+    POOL.with(|p| *p.borrow_mut() = Some(pool));
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+    use std::rc::Rc;
+
+    #[test]
+    fn tasks_timers_and_timeouts_run() {
+        let hits = Rc::new(Cell::new(0));
+        let h = hits.clone();
+        let started = Instant::now();
+        let out = block_on(async move {
+            let h2 = h.clone();
+            spawn_local(async move {
+                sleep(Duration::from_millis(20)).await;
+                h2.set(h2.get() + 1);
+            });
+            // a timeout used as a sleep, as DirPlayer does
+            let r = timeout(Duration::from_millis(40), std::future::pending::<()>()).await;
+            assert!(r.is_err());
+            // a timeout that does not run out
+            let ok = timeout(Duration::from_secs(5), async { 7 }).await;
+            assert_eq!(ok, Ok(7));
+            h.get()
+        });
+        assert_eq!(out, 1);
+        assert!(started.elapsed() >= Duration::from_millis(40));
+        assert!(started.elapsed() < Duration::from_secs(2));
+    }
+
+    #[test]
+    fn a_channel_wakes_the_main_future() {
+        let (tx, rx) = async_std::channel::unbounded::<u32>();
+        let got = block_on(async move {
+            spawn_local(async move {
+                sleep(Duration::from_millis(5)).await;
+                let _ = tx.send(42).await;
+            });
+            rx.recv().await.unwrap()
+        });
+        assert_eq!(got, 42);
+    }
+}
