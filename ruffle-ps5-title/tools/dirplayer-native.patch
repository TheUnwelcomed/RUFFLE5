+/// The launch command's `--doBefore`, run once (a host that loads the movie itself runs it just
+/// before; [`NativePlayer::load`] does).
+pub async fn run_launch_do_before() {
+    crate::player::run_startup_do_before().await;
+}
+
+/// 1.000.036: what the Flash members said to Lingo since the last time
+/// ([`super::flash_host::post`]), in the order said: `getURL("event:…")` and `fscommand` as the
+/// web front end's `dispatch_flash_event` makes them (the handler, for the sprites showing the
+/// member), `getURL("lingo:…")` as its `dispatch_flash_lingo` (the text as a Lingo command). What
+/// those handlers make the Flash movies say runs too, for 16 rounds; then it waits for the next
+/// time. A script error is logged and the movie goes on, as for the other native input.
+pub async fn run_flash_calls() {
+    use super::flash_host::FlashCall;
+    for _ in 0..16 {
+        let calls = super::flash_host::take_calls();
+        if calls.is_empty() {
+            return;
+        }
+        for call in calls {
+            match call {
+                FlashCall::Event { cast_lib, cast_member, body } => {
+                    let Some(command) = crate::flash_event_command(cast_lib, cast_member, &body) else {
+                        continue;
+                    };
+                    if let Err(err) = run_player_command(command).await {
+                        log::warn!("Flash {cast_lib}:{cast_member} event {body:?}: {}", err.message);
+                    }
+                }
+                FlashCall::Lingo(body) => {
+                    let body = body.trim().to_string();
+                    if body.is_empty() {
+                        log::warn!("Flash: an empty lingo: address");
+                        continue;
+                    }
+                    if let Err(err) = crate::player::eval::eval_lingo_command(body.clone()).await {
+                        log::warn!("Flash lingo: {body:?}: {}", err.message);
+                    }
+                }
+            }
+        }
+    }
+}
+
+thread_local! {
+    /// The Flash sprite the mouse is over (for its `Leave`), as `flash_mouse_move` last found it.
+    static FLASH_HOVER: std::cell::Cell<Option<i32>> = const { std::cell::Cell::new(None) };
+}
+
+/// 1.000.036: the mouse moved to stage point (`x`, `y`): the topmost sprite there, when it shows a
+/// Flash member, gets the move at its own point (the same lookup and point as the click
+/// forwarding in commands.rs), and a Flash sprite the mouse left gets a `Leave`. On the web the
+/// page's Ruffle players get no moves but those before a click; here their buttons light up under
+/// the mouse as in Director, where the Flash sprite gets the mouse.
+pub fn flash_mouse_move(x: i32, y: i32) {
+    use super::flash_host::{with_host, MouseKind};
+    if !super::flash_host::has_host() {
+        return;
+    }
+    let target = reserve_player_ref(|player| {
+        let sn = crate::player::score::get_sprite_at(player, x, y, false)?;
+        let sprite = player.movie.score.get_sprite(sn as i16)?;
+        let member = player.movie.cast_manager.find_member_by_ref(sprite.member.as_ref()?)?;
+        if !matches!(member.member_type, crate::player::cast_member::CastMemberType::Flash(_)) {
+            return None;
+        }
+        let rect = crate::player::score::get_concrete_sprite_rect(player, sprite);
+        Some((sn as i32, x - rect.left, y - rect.top, rect.right - rect.left, rect.bottom - rect.top))
+    });
+    let before = FLASH_HOVER.with(|h| h.replace(target.map(|t| t.0)));
+    if let Some(left) = before.filter(|b| Some(*b) != target.map(|t| t.0)) {
+        with_host(|h| h.mouse(left, MouseKind::Leave, 0, 0, 0, 0));
+    }
+    if let Some((sn, lx, ly, w, h)) = target {
+        with_host(|host| host.mouse(sn, MouseKind::Move, lx, ly, w, h));
+    }
+}
+
+/// One score frame the way the web front end's frame loop (`run_frame_loop`) runs one, without
+/// its pacing (the host decides when frames run, at the movie's tempo):
+///
+/// * a pending restart (`play movie` of the current movie) or a finished `gotoNetMovie` first;
+/// * the timeouts that are due, then the frame (`run_single_frame`: its scripts and events, the
+///   playhead's advance); `stopMovie` once the movie has stopped;
+/// * then what the loop does after each frame: the movie's `idle` event (to the frame and movie
+///   scripts), the sound channels' tick — fades, and the end of a sound: the channel goes idle
+///   (`soundBusy` turns FALSE), loops, plays its queue's next sound — the `cuePassed` events that
+///   tick found, and the tempo read again (a `puppetTempo` on a held frame).
+///
+/// 1.000.024: until then the host ran only the timeouts and `run_single_frame`, so a channel's
+/// sound ending never reached it — every channel a game had used stayed busy, and once a game
+/// had used them all (Teen Titans: Battle Blitz, about a minute in) it found no free channel and
+/// played nothing more; its fight music, restarted when it ends, stopped too.
+///
+/// 1.000.028: last, the tasks the frame spawned get their turn ([`super::native_rt::yield_now`]),
+/// which a host running every frame in one `block_on` gave them only when something in a frame
+/// waited — among them the event loop, so mouseEnter, mouseLeave and mouseWithin now reach the
+/// movie as the mouse moves (and Teen Titans: Battle Blitz's START button needed the film-loop
+/// `go` of DirPlayer::go_tell_film_loop).
+pub async fn run_native_frame() -> bool {
+    if reserve_player_ref(|player| player.pending_restart) {
+        super::restart_current_movie().await;
+        return reserve_player_ref(|player| player.is_playing);
+    }
+    let goto_transition = reserve_player_ref(|player| match player.pending_goto_net_movie {
+        Some((task_id, ref target)) if player.net_manager.is_task_done(Some(task_id)) => Some((task_id, target.clone())),
+        _ => None,
+    });
+    if let Some((task_id, target)) = goto_transition {
+        super::transition_to_net_movie(task_id, target).await;
+        return reserve_player_ref(|player| player.is_playing);
+    }
+
+    // 1.000.036: what the Flash members said, then (as the web frame loop does before each frame)
+    // a player for each Flash sprite that came on stage
+    run_flash_calls().await;
+    reserve_player_mut(|player| player.pre_dispatch_flash_members());
+    fire_pending_timeouts().await;
+    let (is_playing, _) = run_single_frame().await;
+    if !is_playing {
+        super::stop_movie_sequence().await;
+        return false;
+    }
+
+    let active = reserve_player_ref(|player| player.is_playing && !player.is_script_paused && !player.pending_movie_init);
+    if active {
+        if let Err(err) = player_invoke_frame_and_movie_scripts(Symbol::from_str("idle"), &vec![]).await {
+            log::warn!("idle dispatch failed: {}", err.message);
+        }
+    }
+
+    let tempo = reserve_player_ref(|player| player.current_frame_tempo);
+    super::tick_sound_manager(if tempo == 0 { 1.0 / 30.0 } else { 1.0 / tempo as f64 });
+
+    loop {
+        let events = reserve_player_mut(|player| std::mem::take(&mut player.pending_cue_events));
+        if events.is_empty() {
+            break;
+        }
+        for (channel_num, cue_number, cue_name) in events {
+            let args = reserve_player_mut(|player| {
+                let channel = player.alloc_datum(Datum::Symbol(Symbol::from_str(&format!("sound{}", channel_num))));
+                let number = player.alloc_datum(Datum::Int(cue_number));
+                let name = player.alloc_datum(Datum::String(cue_name));
+                vec![channel, number, name]
+            });
+            if let Err(err) = player_invoke_frame_and_movie_scripts(Symbol::from_str("cuePassed"), &args).await {
+                log::warn!("cuePassed dispatch failed: {}", err.message);
+            }
+        }
+    }
+
+    reserve_player_mut(|player| player.refresh_frame_tempo());
+    // the tasks this frame started (a sound channel's playlist, a download, the event loop's
+    // mouseEnter / mouseLeave / mouseWithin) get their turn now
+    crate::player::native_rt::yield_now().await;
+    true
+}
+
+pub struct NativePlayer {
+    _tx: channel::Sender<PlayerVMExecutionItem>,
+    stage: Option<Bitmap>,
+}
+
+impl NativePlayer {
+    /// Sets up the global VM. Call inside [`block_on`].
+    pub fn new() -> NativePlayer {
+        // a new movie: no prefs folder until the host names one, no notices from the last one
+        if let Ok(mut p) = PREFS.lock() {
+            *p = (None, Vec::new());
+        }
+        crate::player::net_task::set_web_root(None);
+        crate::player::net_task::set_fetcher(None);
+        // 1.000.036: no Flash host (the host installs its own after) and nothing left from the
+        // last movie's Flash members
+        super::flash_host::set_host(None);
+        super::flash_host::clear_calls();
+        FLASH_HOVER.with(|h| h.set(None));
+        // 1.000.030: a new player draws 3D from nothing (the software renderer keeps members'
+        // geometry and textures by cast member number).
+        crate::rendering_gpu::softgl::reset();
+        let _ = take_notices();
+        let (tx, _rx) = channel::unbounded();
+        let (event_tx, event_rx) = channel::unbounded();
+        unsafe {
+            crate::player::PLAYER_TX = Some(tx.clone());
+            crate::player::PLAYER_EVENT_TX = Some(event_tx.clone());
+            crate::player::xtra::multiuser::MULTIUSER_XTRA_MANAGER_OPT =
+                Some(crate::player::xtra::multiuser::MultiuserXtraManager::new());
+            crate::player::xtra::xmlparser::XMLPARSER_XTRA_MANAGER_OPT =
+                Some(crate::player::xtra::xmlparser::XmlParserXtraManager::new());
+            crate::player::xtra::curl::CURL_XTRA_MANAGER_OPT = Some(crate::player::xtra::curl::CurlXtraManager::new());
+            PLAYER_OPT = Some(DirPlayer::new(tx.clone()));
+        }
+        // the system font the web front end has the VM fetch at start (SetSystemFontPath)
+        if let Err(e) = reserve_player_mut(|player| crate::player::font::native_load_system_font(player)) {
+            log::warn!("system font: {e}");
+        }
+        crate::player::spawn_player_local(async move {
+            run_event_loop(event_rx).await;
+        });
+        NativePlayer { _tx: tx, stage: None }
+    }
+
+    /// Loads the movie at `path` (a .dir, .dxr or .dcr); its casts and the movies it goes to are
+    /// looked up in the same folder. A launch command's `--doBefore` runs first, as the web front
+    /// end runs it (LoadMovieFromFile).
+    pub async fn load(&mut self, path: &str) -> Result<(), String> {
+        let bytes = std::fs::read(path).map_err(|e| format!("{path}: {e}"))?;
+        self.load_bytes(bytes, path).await
+    }
+
+    /// `load` with the movie's bytes given: a Windows projector's movie, read out of the program
+    /// by the title (1.000.037). `path` names the file (`the movieName`) and the folder its
+    /// relative addresses are read from.
+    pub async fn load_bytes(&mut self, bytes: Vec<u8>, path: &str) -> Result<(), String> {
+        run_launch_do_before().await;
+        let path = Path::new(path);
+        let file_name = path.file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_default();
+        let dir = path.parent().ok_or_else(|| format!("{}: no folder", path.display()))?;
+        let dir = std::fs::canonicalize(dir).unwrap_or_else(|_| dir.to_path_buf());
+        let base_url = url::Url::from_directory_path(&dir)
+            .map_err(|_| format!("{}: not a usable folder", dir.display()))?
+            .to_string();
+        let dir_file = read_director_file_bytes(&bytes, &file_name, &base_url)?;
+        reserve_player_mut(|player| {
+            player.is_playing = true;
+            player.is_script_paused = false;
+        });
+        unsafe {
+            let player = crate::player::player_mut();
+            player.load_movie_from_dir(dir_file).await;
+        }
+        // 1.000.038: the movie's own stream. Shockwave reports the movie's download to
+        // `streamStatus` once the movie asked with tellStreamStatus(TRUE); loaders built on that
+        // (Cartoon Network's: The Jetsons' Longshot Golf, Meteor Mayhem) wait for its
+        // bytesSoFar = bytesTotal before leaving their loading frame. Here the file is all there at
+        // once, so it is a task done from the start — the web build's own load task, which the
+        // same reporting sees. Named by the address the movie is told it has, as the web build's.
+        reserve_player_mut(|player| {
+            let url = match &player.movie_path_override {
+                // the address as given (the movie's own), or its folder with the file's name
+                Some(a) if a.rsplit('/').next().is_some_and(|n| n.eq_ignore_ascii_case(&file_name)) => a.clone(),
+                Some(a) if !a.is_empty() => format!("{}/{}", a.trim_end_matches('/'), file_name),
+                _ => format!("{base_url}{file_name}"),
+            };
+            player.net_manager.add_done_task(&url, bytes);
+        });
+        Ok(())
+    }
+
