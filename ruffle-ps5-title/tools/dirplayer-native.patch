+    /// A software context whose default framebuffer is `width` x `height`.
+    pub fn new_soft(width: u32, height: u32) -> WebGl2RenderingContext {
+        WebGl2RenderingContext { st: Rc::new(RefCell::new(State::new(width, height))), tr: false }
+    }
+    /// The same, its calls recorded when DIRPLAYER_SOFTGL_TRACE asks for a trace.
+    pub fn new_soft_traced(width: u32, height: u32) -> WebGl2RenderingContext {
+        trace::init();
+        let tr = trace::ON.load(std::sync::atomic::Ordering::Relaxed);
+        let g = WebGl2RenderingContext { st: Rc::new(RefCell::new(State::new(width, height))), tr };
+        tr!(g, "context", J::U(width), J::U(height));
+        g
+    }
