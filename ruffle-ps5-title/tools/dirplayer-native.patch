@@ -0,0 +1,685 @@
+//! PS5_RUFFLE_DIRPLAYER_NATIVE: text in a system font, measured and drawn without a browser.
+//!
+//! A text or field member whose font the movie does not carry ("Arial", "Verdana", ...) is laid
+//! out and drawn by font.rs's native path (and measured by charPosToLoc in handlers/manager.rs),
+//! which on the web asks a Canvas2D context for it: `ctx.font = "bold 12px Arial"`,
+//! `textBaseline = "top"`, `measureText(s).width`, `fillText`, an underline's
+//! `beginPath`/`moveTo`/`lineTo`/`stroke`, and `getImageData` to read the coverage back. Off the
+//! web there is no document, and those calls panic. TextCtx does those things itself, with the
+//! fonts the host gives it (`add_font`): Ruffle5 and dcr-probe give it Liberation Sans, Serif and
+//! Mono 2.1.5 (SIL Open Font License 1.1), which have the advance widths of Arial, Times New Roman
+//! and Courier New.
+//!
+//! Matched against headless Chromium's canvas drawing the same fonts (on Linux Chromium gets them
+//! for "Arial", "Times New Roman" and "Courier New" through fontconfig), with the measurements
+//! and drawings in dcr-probe's textcheck:
+//!   * `measureText().width` is the sum of the glyphs' advances at the font size, unhinted, plus
+//!     the font's kerning pairs within a word: in 100px Arial "AV" measures 125.9765625, A and V
+//!     alone 66.69921875 each, and the font's A-V pair is -152/2048 em; " A" is a space and an A;
+//!   * `textBaseline = "top"` puts the alphabetic baseline sTypoAscender / (sTypoAscender -
+//!     sTypoDescender) of the font size below y, rounded to 1/64 px: 77.578125 for 100px Arial,
+//!     9.3125 for 12px;
+//!   * tabs and line breaks in a string measure and draw as spaces (the canvas spec replaces ASCII
+//!     whitespace with U+0020 before shaping).
+//! The glyphs land where Chromium's do; their edges differ by hinting and Skia's contrast boost.
+//! A family is chosen by its name: Courier-, mono- and typewriter-like names get Mono, Times-like
+//! serif names Serif, every other name Sans (Chromium draws a family it does not have in its
+//! default font, Times New Roman; for the Verdanas, Tahomas and Genevas of Director movies a sans
+//! is the nearer stand-in). A name a browser would refuse as CSS ("12px *Arial", a name starting
+//! with a digit) is used all the same: Chromium ignores such a string and keeps the font before
+//! it. Bold and italic come from the font string's keywords. Drawing is grayscale-antialiased
+//! coverage composited source-over, through the context's scale and translate.
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::cell::{Cell, RefCell};
+use std::sync::RwLock;
+
+use ab_glyph::{Font, FontArc, GlyphId, PxScale};
+
+/// The three kinds of face a system font is drawn in.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Family {
+    Sans,
+    Serif,
+    Mono,
+}
+
+struct Face {
+    family: Family,
+    bold: bool,
+    italic: bool,
+    font: FontArc,
+    /// sTypoAscender and sTypoDescender (OS/2), else the hhea ascent and descent, in font units.
+    ascent: f32,
+    descent: f32,
+    /// The ascent and descent the font gives its line (hhea), in font units.
+    line_ascent: f32,
+    line_descent: f32,
+    units: f32,
+    height: f32,
+}
+
+static FACES: RwLock<Vec<Face>> = RwLock::new(Vec::new());
+static WARNED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static MEASURED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static DRAWN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// How many strings have been measured and drawn so far (for a host's log).
+pub fn counts() -> (u64, u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    (MEASURED.load(Relaxed), DRAWN.load(Relaxed))
+}
+
+fn be16(b: &[u8], at: usize) -> Option<i16> {
+    Some(i16::from_be_bytes([*b.get(at)?, *b.get(at + 1)?]))
+}
+
+fn be32(b: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_be_bytes([*b.get(at)?, *b.get(at + 1)?, *b.get(at + 2)?, *b.get(at + 3)?]))
+}
+
+/// sTypoAscender and sTypoDescender from a TrueType/OpenType file's OS/2 table.
+fn typo_metrics(data: &[u8]) -> Option<(f32, f32)> {
+    let tables = u16::from_be_bytes([*data.get(4)?, *data.get(5)?]) as usize;
+    for i in 0..tables {
+        let rec = 12 + 16 * i;
+        if data.get(rec..rec + 4)? == b"OS/2" {
+            let off = be32(data, rec + 8)? as usize;
+            let asc = be16(data, off + 68)? as f32;
+            let desc = be16(data, off + 70)? as f32;
+            return (asc - desc > 0.0).then_some((asc, desc));
+        }
+    }
+    None
+}
+
+fn add(family: Family, bold: bool, italic: bool, font: FontArc, typo: Option<(f32, f32)>) {
+    let units = font.units_per_em().unwrap_or(2048.0);
+    let (ascent, descent) = typo.unwrap_or((font.ascent_unscaled(), font.descent_unscaled()));
+    let height = font.height_unscaled();
+    let (line_ascent, line_descent) = (font.ascent_unscaled(), font.descent_unscaled());
+    let face = Face { family, bold, italic, font, ascent, descent, line_ascent, line_descent, units, height };
+    let mut faces = FACES.write().unwrap_or_else(|e| e.into_inner());
+    faces.retain(|f| !(f.family == family && f.bold == bold && f.italic == italic));
+    faces.push(face);
+}
+
+/// Give the text drawing a font for `family` in this weight and slant (a font built into the
+/// host). A later font for the same family and style replaces the earlier one.
+pub fn add_font(family: Family, bold: bool, italic: bool, data: &'static [u8]) -> Result<(), String> {
+    let font = FontArc::try_from_slice(data).map_err(|e| format!("{family:?}: {e}"))?;
+    add(family, bold, italic, font, typo_metrics(data));
+    Ok(())
+}
+
+/// The same, from a font file read at run time.
+pub fn add_font_file(family: Family, bold: bool, italic: bool, data: Vec<u8>) -> Result<(), String> {
+    let typo = typo_metrics(&data);
+    let font = FontArc::try_from_vec(data).map_err(|e| format!("{family:?}: {e}"))?;
+    add(family, bold, italic, font, typo);
+    Ok(())
+}
+
+/// The Liberation fonts' file names, and what each stands in for.
+pub const LIBERATION: [(&str, Family, bool, bool); 12] = [
+    ("LiberationSans-Regular.ttf", Family::Sans, false, false),
+    ("LiberationSans-Bold.ttf", Family::Sans, true, false),
+    ("LiberationSans-Italic.ttf", Family::Sans, false, true),
+    ("LiberationSans-BoldItalic.ttf", Family::Sans, true, true),
+    ("LiberationSerif-Regular.ttf", Family::Serif, false, false),
+    ("LiberationSerif-Bold.ttf", Family::Serif, true, false),
+    ("LiberationSerif-Italic.ttf", Family::Serif, false, true),
+    ("LiberationSerif-BoldItalic.ttf", Family::Serif, true, true),
+    ("LiberationMono-Regular.ttf", Family::Mono, false, false),
+    ("LiberationMono-Bold.ttf", Family::Mono, true, false),
+    ("LiberationMono-Italic.ttf", Family::Mono, false, true),
+    ("LiberationMono-BoldItalic.ttf", Family::Mono, true, true),
+];
+
+/// Read the Liberation fonts in `dir` (by the names in LIBERATION). Returns how many were read.
+pub fn add_liberation_fonts(dir: &str) -> usize {
+    let mut n = 0;
+    for (name, family, bold, italic) in LIBERATION {
+        let path = std::path::Path::new(dir).join(name);
+        match std::fs::read(&path) {
+            Ok(data) => match add_font_file(family, bold, italic, data) {
+                Ok(()) => n += 1,
+                Err(e) => log::warn!("native_text: {}: {e}", path.display()),
+            },
+            Err(e) => log::warn!("native_text: {}: {e}", path.display()),
+        }
+    }
+    n
+}
+
+/// How many fonts the text drawing has.
+pub fn fonts() -> usize {
+    FACES.read().map(|f| f.len()).unwrap_or(0)
+}
+
+/// Whether text in `name` is drawn with that font's own advance widths: one of the families the
+/// Liberation fonts (and the Arimo, Tinos and Cousine they come from) have the metrics of, and
+/// a font for it was given. BudAPI's baFontInstalled asks this.
+pub fn has_font(name: &str) -> bool {
+    let n = name.trim().trim_matches(|c| c == '"' || c == '\'').to_ascii_lowercase();
+    let family = match n.as_str() {
+        "arial" | "helvetica" | "liberation sans" | "arimo" => Family::Sans,
+        "times new roman" | "times" | "liberation serif" | "tinos" => Family::Serif,
+        "courier new" | "courier" | "liberation mono" | "cousine" => Family::Mono,
+        _ => return false,
+    };
+    FACES.read().map(|f| f.iter().any(|face| face.family == family)).unwrap_or(false)
+}
+
+/// The face a family name stands for.
+pub fn family_of(name: &str) -> Family {
+    let first = name.split(',').next().unwrap_or("");
+    let n = first.trim().trim_matches(|c| c == '"' || c == '\'').to_ascii_lowercase();
+    const MONO: [&str; 11] = ["courier", "mono", "consol", "lucida console", "typewriter", "andale", "fixedsys", "terminal", "monaco", "ocr", "prestige"];
+    const SERIF: [&str; 16] = ["times", "georgia", "garamond", "palatino", "book antiqua", "bookman", "century schoolbook", "new york", "baskerville", "cambria", "didot", "bodoni", "caslon", "goudy", "perpetua", "minion"];
+    if MONO.iter().any(|k| n.contains(k)) {
+        Family::Mono
+    } else if SERIF.iter().any(|k| n.contains(k)) || (n.contains("serif") && !n.contains("sans")) {
+        Family::Serif
+    } else {
+        Family::Sans
+    }
+}
+
+/// A CSS font shorthand as DirPlayer writes it ("bold italic 12px Arial", "12px Times New Roman"):
+/// (bold, italic, size in px, family). None when it has no size, as a canvas ignores such a string.
+pub fn parse_font(s: &str) -> Option<(bool, bool, f64, String)> {
+    let mut bold = false;
+    let mut italic = false;
+    let mut rest = s.trim();
+    loop {
+        let (word, after) = match rest.find(char::is_whitespace) {
+            Some(i) => (&rest[..i], rest[i..].trim_start()),
+            None => (rest, ""),
+        };
+        let lower = word.to_ascii_lowercase();
+        let size_part = lower.split('/').next().unwrap_or("");
+        let size = if let Some(n) = size_part.strip_suffix("px") {
+            n.parse::<f64>().ok()
+        } else if let Some(n) = size_part.strip_suffix("pt") {
+            n.parse::<f64>().ok().map(|p| p * 4.0 / 3.0)
+        } else {
+            None
+        };
+        if let Some(size) = size {
+            if !(size.is_finite() && size > 0.0) {
+                return None;
+            }
+            let family = after.trim().to_string();
+            return Some((bold, italic, size, if family.is_empty() { "sans-serif".into() } else { family }));
+        }
+        match lower.as_str() {
+            "bold" | "bolder" => bold = true,
+            "italic" | "oblique" => italic = true,
+            w if w.parse::<u32>().is_ok_and(|n| n >= 600) => bold = true,
+            "" => return None,
+            _ => {}
+        }
+        if after.is_empty() {
+            return None;
+        }
+        rest = after;
+    }
+}
+
+/// The current font: its face, the size in px, and the face's units, height and typo ascent and
+/// descent as fractions of their sum (the em box "top" and "bottom" are measured from).
+#[derive(Clone)]
+struct Current {
+    font: FontArc,
+    size: f64,
+    units: f64,
+    height: f32,
+    ascent_ratio: f64,
+    descent_ratio: f64,
+    line_ascent: f64,
+    line_descent: f64,
+}
+
+/// The face for a family and style: the family's own (Sans when it has none), then the weight,
+/// then the slant.
+fn pick(bold: bool, italic: bool, family: Family) -> Option<Current> {
+    let faces = FACES.read().ok()?;
+    let score = |f: &Face| -> u32 {
+        (if f.family == family { 100 } else if f.family == Family::Sans { 10 } else { 0 })
+            + (if f.bold == bold { 2 } else { 0 })
+            + (if f.italic == italic { 1 } else { 0 })
+    };
+    let f = faces.iter().max_by_key(|f| score(f))?;
+    let em = f.ascent - f.descent;
+    Some(Current {
+        font: f.font.clone(),
+        size: 0.0,
+        units: f.units as f64,
+        height: f.height,
+        ascent_ratio: (f.ascent / em) as f64,
+        descent_ratio: (-f.descent / em) as f64,
+        line_ascent: f.line_ascent as f64,
+        line_descent: -f.line_descent as f64,
+    })
+}
+
+fn round_64th(v: f64) -> f64 {
+    (v * 64.0).round() / 64.0
+}
+
+/// A canvas's colour string: rgb()/rgba(), #rgb/#rrggbb, black/white/transparent.
+fn parse_color(s: &str) -> Option<[f64; 4]> {
+    let s = s.trim().to_ascii_lowercase();
+    match s.as_str() {
+        "black" => return Some([0.0, 0.0, 0.0, 1.0]),
+        "white" => return Some([255.0, 255.0, 255.0, 1.0]),
+        "transparent" => return Some([0.0, 0.0, 0.0, 0.0]),
+        _ => {}
+    }
+    if let Some(hex) = s.strip_prefix('#') {
+        let v: Vec<u32> = hex.chars().map(|c| c.to_digit(16)).collect::<Option<_>>()?;
+        return match v.len() {
+            3 => Some([(v[0] * 17) as f64, (v[1] * 17) as f64, (v[2] * 17) as f64, 1.0]),
+            6 => Some([(v[0] * 16 + v[1]) as f64, (v[2] * 16 + v[3]) as f64, (v[4] * 16 + v[5]) as f64, 1.0]),
+            _ => None,
+        };
+    }
+    let inner = s.strip_prefix("rgba(").or_else(|| s.strip_prefix("rgb("))?.strip_suffix(')')?;
+    let parts: Vec<f64> = inner.split(',').map(|p| p.trim().parse::<f64>().ok()).collect::<Option<_>>()?;
+    match parts.len() {
+        3 => Some([parts[0].clamp(0.0, 255.0), parts[1].clamp(0.0, 255.0), parts[2].clamp(0.0, 255.0), 1.0]),
+        4 => Some([parts[0].clamp(0.0, 255.0), parts[1].clamp(0.0, 255.0), parts[2].clamp(0.0, 255.0), parts[3].clamp(0.0, 1.0)]),
+        _ => None,
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Baseline {
+    Alphabetic,
+    Top,
+    Middle,
+    Bottom,
+}
+
+/// What `measure_text` returns: TextMetrics' width, and its fontBoundingBoxAscent / Descent
+/// (the font's line ascent and descent, rounded to whole pixels as Chromium has them — 91 and 21
+/// for 100px Arial — measured from the baseline the context is set to).
+pub struct TextMetrics {
+    width: f64,
+    ascent: f64,
+    descent: f64,
+}
+
+impl TextMetrics {
+    pub fn width(&self) -> f64 {
+        self.width
+    }
+
+    pub fn font_bounding_box_ascent(&self) -> f64 {
+        self.ascent
+    }
+
+    pub fn font_bounding_box_descent(&self) -> f64 {
+        self.descent
+    }
+}
+
+/// What `get_image_data` returns: RGBA, not premultiplied, row by row.
+pub struct ImageData {
+    data: Vec<u8>,
+}
+
+impl ImageData {
+    pub fn data(self) -> Vec<u8> {
+        self.data
+    }
+}
+
+/// The Canvas2D context font.rs and charPosToLoc draw and measure text with off the web.
+pub struct TextCtx {
+    w: usize,
+    h: usize,
+    px: RefCell<Vec<u8>>,
+    font_str: RefCell<String>,
+    font: RefCell<Option<Current>>,
+    baseline: Cell<Baseline>,
+    fill: Cell<[f64; 4]>,
+    stroke_color: Cell<[f64; 4]>,
+    line_width: Cell<f64>,
+    /// sx, sy, tx, ty: device = (sx·x + tx, sy·y + ty).
+    m: Cell<[f64; 4]>,
+    /// Sub-paths in device coordinates.
+    path: RefCell<Vec<Vec<(f64, f64)>>>,
+}
+
+impl TextCtx {
+    /// A canvas of `width` × `height` transparent black pixels, with a canvas's defaults (black
+    /// fill and stroke, line width 1, "10px sans-serif", alphabetic baseline).
+    pub fn new(width: u32, height: u32) -> TextCtx {
+        let (w, h) = (width as usize, height as usize);
+        let ctx = TextCtx {
+            w,
+            h,
+            px: RefCell::new(vec![0; w * h * 4]),
+            font_str: RefCell::new(String::new()),
+            font: RefCell::new(None),
+            baseline: Cell::new(Baseline::Alphabetic),
+            fill: Cell::new([0.0, 0.0, 0.0, 1.0]),
+            stroke_color: Cell::new([0.0, 0.0, 0.0, 1.0]),
+            line_width: Cell::new(1.0),
+            m: Cell::new([1.0, 1.0, 0.0, 0.0]),
+            path: RefCell::new(Vec::new()),
+        };
+        ctx.set_font("10px sans-serif");
+        ctx
+    }
+
+    pub fn set_font(&self, font: &str) {
+        if *self.font_str.borrow() == font {
+            return;
+        }
+        let Some((bold, italic, size, family)) = parse_font(font) else {
+            return;
+        };
+        let picked = pick(bold, italic, family_of(&family)).map(|mut c| {
+            c.size = size;
+            c
+        });
+        if picked.is_none() && !WARNED.swap(true, std::sync::atomic::Ordering::Relaxed) {
+            log::warn!("native_text: no fonts were given; text in system fonts is not drawn");
+        }
+        *self.font.borrow_mut() = picked;
+        *self.font_str.borrow_mut() = font.to_string();
+    }
+
+    pub fn set_text_baseline(&self, baseline: &str) {
+        self.baseline.set(match baseline {
+            "top" | "hanging" => Baseline::Top,
+            "middle" => Baseline::Middle,
+            "bottom" | "ideographic" => Baseline::Bottom,
+            _ => Baseline::Alphabetic,
+        });
+    }
+
+    pub fn set_fill_style_str(&self, color: &str) {
+        if let Some(c) = parse_color(color) {
+            self.fill.set(c);
+        }
+    }
+
+    pub fn set_stroke_style_str(&self, color: &str) {
+        if let Some(c) = parse_color(color) {
+            self.stroke_color.set(c);
+        }
+    }
+
+    pub fn set_line_width(&self, w: f64) {
+        if w.is_finite() && w > 0.0 {
+            self.line_width.set(w);
+        }
+    }
+
+    pub fn scale(&self, x: f64, y: f64) -> Result<(), ()> {
+        let [sx, sy, tx, ty] = self.m.get();
+        self.m.set([sx * x, sy * y, tx, ty]);
+        Ok(())
+    }
+
+    pub fn translate(&self, x: f64, y: f64) -> Result<(), ()> {
+        let [sx, sy, tx, ty] = self.m.get();
+        self.m.set([sx, sy, tx + sx * x, ty + sy * y]);
+        Ok(())
+    }
+
+    fn device(&self, x: f64, y: f64) -> (f64, f64) {
+        let [sx, sy, tx, ty] = self.m.get();
+        (sx * x + tx, sy * y + ty)
+    }
+
+    /// Composite `color` at `coverage` onto one pixel (source-over).
+    fn blend(px: &mut [u8], w: usize, h: usize, x: i64, y: i64, color: [f64; 4], coverage: f64) {
+        if x < 0 || y < 0 || x as usize >= w || y as usize >= h {
+            return;
+        }
+        let a = (coverage.clamp(0.0, 1.0) * color[3]).clamp(0.0, 1.0);
+        if a <= 0.0 {
+            return;
+        }
+        let i = (y as usize * w + x as usize) * 4;
+        let da = px[i + 3] as f64 / 255.0;
+        let out_a = a + da * (1.0 - a);
+        for k in 0..3 {
+            let d = px[i + k] as f64;
+            let v = if out_a > 0.0 { (color[k] * a + d * da * (1.0 - a)) / out_a } else { 0.0 };
+            px[i + k] = v.round().clamp(0.0, 255.0) as u8;
+        }
+        px[i + 3] = (out_a * 255.0).round().clamp(0.0, 255.0) as u8;
+    }
+
+    pub fn fill_rect(&self, x: f64, y: f64, w: f64, h: f64) {
+        let (ax, ay) = self.device(x, y);
+        let (bx, by) = self.device(x + w, y + h);
+        let (x0, x1) = (ax.min(bx).max(0.0), ax.max(bx).min(self.w as f64));
+        let (y0, y1) = (ay.min(by).max(0.0), ay.max(by).min(self.h as f64));
+        if x1 <= x0 || y1 <= y0 {
+            return;
+        }
+        let color = self.fill.get();
+        let mut px = self.px.borrow_mut();
+        for py in y0.floor() as i64..y1.ceil() as i64 {
+            let cy = (y1.min(py as f64 + 1.0) - y0.max(py as f64)).clamp(0.0, 1.0);
+            for pxx in x0.floor() as i64..x1.ceil() as i64 {
+                let cx = (x1.min(pxx as f64 + 1.0) - x0.max(pxx as f64)).clamp(0.0, 1.0);
+                Self::blend(&mut px, self.w, self.h, pxx, py, color, cx * cy);
+            }
+        }
+    }
+
+    /// Characters as a canvas shapes them: ASCII whitespace becomes a space.
+    fn chars(text: &str) -> impl Iterator<Item = char> + '_ {
+        text.chars().map(|c| if matches!(c, '\t' | '\n' | '\x0C' | '\r') { ' ' } else { c })
+    }
+
+    /// The glyphs of `text` and each one's pen position in font units from the start. Kerning
+    /// pairs apply within a word only: Chromium shapes a string a word at a time, split at spaces,
+    /// so the font's pairs with a space never apply there (" A" in 100px Arial measures 94.482421875,
+    /// a space and an A; the font's space-A pair is -113/2048 em).
+    fn layout(cur: &Current, text: &str) -> (Vec<(GlyphId, f64)>, f64) {
+        let mut out = Vec::new();
+        let mut pen = 0.0f64;
+        let mut prev: Option<(GlyphId, char)> = None;
+        for c in Self::chars(text) {
+            let id = cur.font.glyph_id(c);
+            if let Some((p, pc)) = prev {
+                if pc != ' ' && c != ' ' {
+                    pen += cur.font.kern_unscaled(p, id) as f64;
+                }
+            }
+            out.push((id, pen));
+            pen += cur.font.h_advance_unscaled(id) as f64;
+            prev = Some((id, c));
+        }
+        (out, pen)
+    }
+
+    pub fn measure_text(&self, text: &str) -> Result<TextMetrics, ()> {
+        MEASURED.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let cur = self.font.borrow();
+        let Some(cur) = cur.as_ref() else {
+            // no fonts: font.rs's own estimate for a failed measure
+            let size = parse_font(&self.font_str.borrow()).map(|f| f.2).unwrap_or(10.0);
+            return Ok(TextMetrics { width: Self::chars(text).count() as f64 * size * 0.55, ascent: size * 0.9, descent: size * 0.2 });
+        };
+        let (_, units) = Self::layout(cur, text);
+        let offset = self.baseline_offset(cur);
+        Ok(TextMetrics {
+            width: units * cur.size / cur.units,
+            ascent: (cur.line_ascent * cur.size / cur.units).round() - offset,
+            descent: (cur.line_descent * cur.size / cur.units).round() + offset,
+        })
+    }
+
+    /// How far below y the alphabetic baseline is for the current baseline setting (CSS px).
+    fn baseline_offset(&self, cur: &Current) -> f64 {
+        match self.baseline.get() {
+            Baseline::Alphabetic => 0.0,
+            Baseline::Top => round_64th(cur.size * cur.ascent_ratio),
+            Baseline::Bottom => -round_64th(cur.size * cur.descent_ratio),
+            Baseline::Middle => (round_64th(cur.size * cur.ascent_ratio) - round_64th(cur.size * cur.descent_ratio)) / 2.0,
+        }
+    }
+
+    pub fn fill_text(&self, text: &str, x: f64, y: f64) -> Result<(), ()> {
+        DRAWN.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let cur = self.font.borrow();
+        let Some(cur) = cur.as_ref() else {
+            return Ok(());
+        };
+        let [sx, sy, _, _] = self.m.get();
+        let (glyphs, _) = Self::layout(cur, text);
+        let per_unit = cur.size / cur.units;
+        let base_y = y + self.baseline_offset(cur);
+        // ab_glyph's PxScale is the font's ascent-to-descent height in pixels
+        let scale = PxScale {
+            x: (cur.size * sx.abs()) as f32 * cur.height / cur.units as f32,
+            y: (cur.size * sy.abs()) as f32 * cur.height / cur.units as f32,
+        };
+        let color = self.fill.get();
+        let mut px = self.px.borrow_mut();
+        for (id, pen) in glyphs {
+            if id.0 == 0 {
+                continue;
+            }
+            let (dx, dy) = self.device(x + pen * per_unit, base_y);
+            let glyph = id.with_scale_and_position(scale, ab_glyph::point(dx as f32, dy as f32));
+            if let Some(outlined) = cur.font.outline_glyph(glyph) {
+                let b = outlined.px_bounds();
+                let (ox, oy) = (b.min.x as i64, b.min.y as i64);
+                outlined.draw(|gx, gy, c| {
+                    Self::blend(&mut px, self.w, self.h, ox + gx as i64, oy + gy as i64, color, c as f64);
+                });
+            }
+        }
+        Ok(())
+    }
+
+    pub fn begin_path(&self) {
+        self.path.borrow_mut().clear();
+    }
+
+    pub fn move_to(&self, x: f64, y: f64) {
+        let p = self.device(x, y);
+        self.path.borrow_mut().push(vec![p]);
+    }
+
+    pub fn line_to(&self, x: f64, y: f64) {
+        let p = self.device(x, y);
+        let mut path = self.path.borrow_mut();
+        match path.last_mut() {
+            Some(sub) => sub.push(p),
+            None => path.push(vec![p]),
+        }
+    }
+
+    /// Each segment as a line `line_width` wide with butt ends, 4×4 samples a pixel.
+    pub fn stroke(&self) {
+        let [sx, sy, _, _] = self.m.get();
+        let half = self.line_width.get() * (sx * sy).abs().sqrt() / 2.0;
+        let color = self.stroke_color.get();
+        let path = self.path.borrow();
+        let mut px = self.px.borrow_mut();
+        for sub in path.iter() {
+            for seg in sub.windows(2) {
+                let ((x0, y0), (x1, y1)) = (seg[0], seg[1]);
+                let (dx, dy) = (x1 - x0, y1 - y0);
+                let len2 = dx * dx + dy * dy;
+                if len2 <= 0.0 {
+                    continue;
+                }
+                let len = len2.sqrt();
+                let lo_x = (x0.min(x1) - half).floor().max(0.0) as i64;
+                let hi_x = (x0.max(x1) + half).ceil().min(self.w as f64) as i64;
+                let lo_y = (y0.min(y1) - half).floor().max(0.0) as i64;
+                let hi_y = (y0.max(y1) + half).ceil().min(self.h as f64) as i64;
+                for py in lo_y..hi_y {
+                    for pxx in lo_x..hi_x {
+                        let mut inside = 0;
+                        for j in 0..4 {
+                            for i in 0..4 {
+                                let (qx, qy) = (pxx as f64 + (i as f64 + 0.5) / 4.0 - x0, py as f64 + (j as f64 + 0.5) / 4.0 - y0);
+                                let t = (qx * dx + qy * dy) / len2;
+                                let dist = (qx * dy - qy * dx).abs() / len;
+                                if (0.0..=1.0).contains(&t) && dist <= half {
+                                    inside += 1;
+                                }
+                            }
+                        }
+                        if inside > 0 {
+                            Self::blend(&mut px, self.w, self.h, pxx, py, color, inside as f64 / 16.0);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn get_image_data(&self, x: f64, y: f64, w: f64, h: f64) -> Result<ImageData, ()> {
+        if !(w.is_finite() && h.is_finite()) || w < 1.0 || h < 1.0 {
+            return Err(());
+        }
+        let (x, y, w, h) = (x as i64, y as i64, w as usize, h as usize);
+        let src = self.px.borrow();
+        let mut data = vec![0u8; w * h * 4];
+        for row in 0..h {
+            let sy = y + row as i64;
+            if sy < 0 || sy as usize >= self.h {
+                continue;
+            }
+            for col in 0..w {
+                let sx = x + col as i64;
+                if sx < 0 || sx as usize >= self.w {
+                    continue;
+                }
+                let s = (sy as usize * self.w + sx as usize) * 4;
+                let d = (row * w + col) * 4;
+                data[d..d + 4].copy_from_slice(&src[s..s + 4]);
+            }
+        }
+        Ok(ImageData { data })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn font_strings_parse_as_a_canvas_reads_them() {
+        assert_eq!(parse_font("12px Arial"), Some((false, false, 12.0, "Arial".into())));
+        assert_eq!(parse_font("bold italic 12px Arial"), Some((true, true, 12.0, "Arial".into())));
+        assert_eq!(parse_font("italic bold 12px Times New Roman"), Some((true, true, 12.0, "Times New Roman".into())));
+        assert_eq!(parse_font("700 9.5px \"Courier New\""), Some((true, false, 9.5, "\"Courier New\"".into())));
+        assert_eq!(parse_font("Arial"), None);
+        assert_eq!(parse_font("bold Arial"), None);
+        assert_eq!(parse_font("0px Arial"), None);
+    }
+
+    #[test]
+    fn families_by_name() {
+        assert_eq!(family_of("Arial"), Family::Sans);
+        assert_eq!(family_of("Verdana"), Family::Sans);
+        assert_eq!(family_of("Times New Roman"), Family::Serif);
+        assert_eq!(family_of("\"Courier New\""), Family::Mono);
+        assert_eq!(family_of("sans-serif"), Family::Sans);
+        assert_eq!(family_of("serif"), Family::Serif);
+        assert_eq!(family_of("Monaco, Courier"), Family::Mono);
+    }
+
+    #[test]
+    fn colours() {
+        assert_eq!(parse_color("rgb(255,255,255)"), Some([255.0, 255.0, 255.0, 1.0]));
+        assert_eq!(parse_color("#0f0"), Some([0.0, 255.0, 0.0, 1.0]));
+        assert_eq!(parse_color("nonsense"), None);
+    }
+}
