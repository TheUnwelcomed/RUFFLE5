+        assert_eq!(bridge::dispatch_mouse(3, "down", 1, 2, 10, 10), Ok(FlashValue::Bool(true)));
+        assert_eq!(bridge::is_ready(3), Ok(FlashValue::Bool(true)));
+        assert_eq!(bridge::frame_count(3), 7);
+        assert_eq!(bridge::hit_test(3, 0.0, 0.0), 2);
