+    #[test]
+    fn the_bridge_reaches_the_host_and_answers_nothing_without_one() {
+        let seen = std::rc::Rc::new(RefCell::new(Vec::new()));
+        set_host(None);
+        assert_eq!(bridge::get_variable(1, "x"), Err(FlashValue::Undefined));
+        assert!(!bridge::is_playing(1));
+        assert_eq!(bridge::call_function(1, "_root.f", "[]"), Err(FlashValue::Undefined));
+        set_host(Some(Box::new(Recorder(seen.clone()))));
+        assert_eq!(bridge::get_variable(3, "_root.isReady"), Ok(FlashValue::String("12".into())));
+        assert_eq!(bridge::set_variable(3, "_root.progress", "50"), Ok(FlashValue::Bool(true)));
+        assert_eq!(bridge::call_function(3, "_root.mc.gotoAndStop", "[101]"), Ok(FlashValue::Null));
+        assert_eq!(bridge::call_function(3, "_root.f", "not json"), Ok(FlashValue::Null), "as flashPlayerManager.ts: a bad list answers null");
