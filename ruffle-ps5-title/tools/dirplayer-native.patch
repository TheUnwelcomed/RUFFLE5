+    }
+
+    /// A green with its cup cut out: the ball held on the green's plane drops once
+    /// it is over the opening, and stays up where the green is under it.
+    #[test]
+    fn a_ball_over_the_cup_falls_in() {
+        use super::super::havok_physics::CollisionMesh;
+        init_symbol_table();
+        let green = |state: &mut HavokPhysicsState| {
+            // a 2000 x 2000 green at z 0 with a 40 x 40 opening at its centre: a ring
+            // of 8 triangles between the outer square and the opening
+            let outer = [[-1000.0, -1000.0, 0.0], [1000.0, -1000.0, 0.0], [1000.0, 1000.0, 0.0], [-1000.0, 1000.0, 0.0]];
+            let inner = [[-20.0, -20.0, 0.0], [20.0, -20.0, 0.0], [20.0, 20.0, 0.0], [-20.0, 20.0, 0.0]];
+            let mut vertices = Vec::new();
+            vertices.extend_from_slice(&outer);
+            vertices.extend_from_slice(&inner);
+            let mut triangles = Vec::new();
+            for i in 0..4u32 {
+                let j = (i + 1) % 4;
+                triangles.push([i, j, 4 + i]);
+                triangles.push([j, 4 + j, 4 + i]);
+            }
+            let mut m = CollisionMesh { name: Symbol::from_str("g_green"), vertices, triangles, aabb_min: [0.0; 3], aabb_max: [0.0; 3], body_index: None };
+            m.compute_aabb();
+            state.collision_meshes.push(m);
+        };
+        let ball_at = |x: f64| {
+            let mut state = HavokPhysicsState::default();
+            state.scale = 0.01;
+            state.tolerance = 0.7;
+            state.gravity = [0.0, 0.0, -981.0];
+            green(&mut state);
+            let mut rb = HavokRigidBody::new_movable(Symbol::from_str("golf_ball_1"), 1.0, true);
+            rb.position = [x, 0.0, 6.1];
+            rb.inertia_half_extents = [5.4; 3];
+            rb.active = true;
+            rb.resting_normal = Some(crate::player::cast_member::RestingContact {
+                normal: [0.0, 0.0, 1.0],
+                plane_point: [x + 10.0, 0.0, 0.0],
+                ground_friction: 0.4,
+                aabb_min: [-1000.0, -1000.0, 0.0],
+                aabb_max: [1000.0, 1000.0, 0.0],
+                mesh_name: Symbol::from_str("g_green"),
+            });
+            state.rigid_bodies.push(rb);
+            state
+        };
+        let mut on_green = ball_at(300.0);
+        let mut over_cup = ball_at(0.0);
+        for _ in 0..5 {
+            step_native(&mut on_green, 1.0 / 17.0, 14);
+            step_native(&mut over_cup, 1.0 / 17.0, 14);
+        }
+        assert!(on_green.rigid_bodies[0].resting_normal.is_some(), "the ball on the green is still held on it");
+        assert!((on_green.rigid_bodies[0].position[2] - 6.1).abs() < 0.5, "the ball on the green stays up: z {}", on_green.rigid_bodies[0].position[2]);
+        assert!(over_cup.rigid_bodies[0].resting_normal.is_none(), "the ball over the cup is released");
+        assert!(over_cup.rigid_bodies[0].position[2] < 0.0, "the ball over the cup falls: z {}", over_cup.rigid_bodies[0].position[2]);
+    }
+
+    #[test]
+    fn a_pitching_wedge_carries_what_the_drag_law_says() {
+        for (name, power, incl) in [("1w", 100.5, 0.5), ("9i", 57.11, 0.8), ("pw", 49.0, 0.85)] {
+            let (x, t) = carry(power, incl, 1.0, 1.0 / 17.0);
+            let (xc, tc) = closed_form(power, incl, 1.0);
+            println!("{name}: carry {:.0} display ({:.0} y) in {t:.2} s; drag law says {:.0} ({:.0} y) in {tc:.2} s", x, x / 91.44, xc, xc / 91.44);
+            assert!((x - xc).abs() < 0.08 * xc, "{name}: {x:.0} vs {xc:.0}");
+        }
+    }
