+            plane_point: [0.0, 0.0, 0.0],
+            ground_friction: 0.0,
+            aabb_min: [-1e6, -1e6, -1e6],
+            aabb_max: [1e6, 1e6, 1e6],
+            mesh_name: Symbol::from_str("g_green01"),
+        });
+        state.rigid_bodies.push(rb);
+        for _ in 0..3 {
+            step_native(&mut state, 1.0 / 17.0, 14);
+            let named: Vec<String> = state.collision_list_cache.iter().map(|c| format!("{}~{} nrv {}", c.body_a, c.body_b, c.normal_rel_vel)).collect();
+            assert_eq!(named, vec!["golf_ball_1~g_green01 nrv 0".to_string()], "{named:?}");
+        }
+        state.rigid_bodies[0].active = false;
