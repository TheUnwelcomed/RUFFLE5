+
+/// The text form, keyword per line, nested with BEGIN_… / END_… — into the same world the binary
+/// form gives. ROTATION's four numbers are kept as written (the binary form's order: angle, then
+/// the axis). Primitives other than spheres are kept by name (a mesh of that name, if any).
+fn parse_hke_text(data: &[u8], world: &mut HkeWorld) {
+    let text = String::from_utf8_lossy(data);
+    let mut body: Option<HkeBodyProps> = None;
+    let mut prim: Option<HkePrimitive> = None;
+    let mut action: Option<String> = None;
+    let (mut drag_lin, mut drag_ang) = (0.0f32, 0.0f32);
+    let nums = |rest: &[&str]| -> Vec<f32> { rest.iter().filter_map(|t| t.parse::<f32>().ok()).collect() };
+    for line in text.lines() {
+        let parts: Vec<&str> = line.split_whitespace().collect();
+        let Some(&key) = parts.first() else { continue };
+        let rest = &parts[1..];
+        let v = nums(rest);
+        let v3 = |v: &Vec<f32>| if v.len() >= 3 { Some([v[0], v[1], v[2]]) } else { None };
+        let flag = |rest: &[&str]| rest.first().map(|t| t.eq_ignore_ascii_case("TRUE") || *t == "1");
+        match key {
+            "BEGIN_WORLD" => world.world_name = rest.first().unwrap_or(&"").to_string(),
+            "WORLD_SCALE" => if let Some(&s) = v.first() { if s > 0.0 { world.world_scale = s; } },
+            "GRAVITY" => world.gravity = v3(&v),
+            "TOLERANCE" => world.tolerance = v.first().copied(),
+            "BEGIN_RIGID_BODY" => {
+                body = Some(HkeBodyProps {
+                    name: Symbol::from_str(rest.first().unwrap_or(&"")),
+                    total_mass: 0.0,
+                    restitution: None,
+                    static_friction: None,
+                    dynamic_friction: None,
+                    translation: None,
+                    orientation: None,
+                    linear_velocity: None,
+                    angular_velocity: None,
+                    active: None,
+                    collisions_disabled: None,
+                    displacement: None,
+                    casts_shadows: None,
+                    primitives: Vec::new(),
+                });
+            }
+            "END_RIGID_BODY" => {
+                if let Some(mut b) = body.take() {
+                    b.total_mass = b.primitives.iter().map(|p| p.mass).sum();
+                    world.bodies.push(b);
+                }
+            }
+            "BEGIN_PRIMITIVE" => {
+                let kind = rest.first().copied().unwrap_or("");
+                let name = rest.get(1).copied().unwrap_or("").to_string();
+                prim = Some(HkePrimitive {
+                    kind: match kind {
+                        "SphericalPrimitive" | "SpherePrimitive" => HkePrimitiveKind::Sphere { radius: 0.0 },
+                        "PlanePrimitive" => HkePrimitiveKind::Plane { normal: [0.0, 0.0, 1.0], dist: 0.0 },
+                        _ => HkePrimitiveKind::Mesh { mesh_name: name },
+                    },
+                    local_translation: [0.0; 3],
+                    mass: 0.0,
+                });
+            }
+            "END_PRIMITIVE" => {
+                if let (Some(p), Some(b)) = (prim.take(), body.as_mut()) {
+                    b.primitives.push(p);
+                }
+            }
+            "BEGIN_ACTION" => action = rest.first().map(|a| a.to_string()),
+            "END_ACTION" => {
+                if action.as_deref() == Some("Drag") {
+                    world.drag = Some(HkeDragAction { linear_drag: drag_lin, angular_drag: drag_ang });
+                }
+                action = None;
+            }
+            "LINEAR_DRAG" => drag_lin = v.first().copied().unwrap_or(0.0),
+            "ANGULAR_DRAG" => drag_ang = v.first().copied().unwrap_or(0.0),
+            _ => {
+                if let Some(p) = prim.as_mut() {
+                    match key {
+                        "MASS" => p.mass = v.first().copied().unwrap_or(0.0),
+                        "RADIUS" => if let HkePrimitiveKind::Sphere { radius } = &mut p.kind { *radius = v.first().copied().unwrap_or(0.0); },
+                        "TRANSLATION" => if let Some(t) = v3(&v) { p.local_translation = t; },
+                        "PLANE" => if let (HkePrimitiveKind::Plane { normal, dist }, true) = (&mut p.kind, v.len() >= 4) { *normal = [v[0], v[1], v[2]]; *dist = v[3]; },
+                        _ => {}
+                    }
+                } else if let Some(b) = body.as_mut() {
+                    match key {
+                        "ELLASTICITY" | "ELASTICITY" | "RESTITUTION" => b.restitution = v.first().copied(),
+                        "STATIC_FRICTION" => b.static_friction = v.first().copied(),
+                        "DYNAMIC_FRICTION" => b.dynamic_friction = v.first().copied(),
+                        "ROTATION" => if v.len() >= 4 { b.orientation = Some([v[0], v[1], v[2], v[3]]); },
+                        "TRANSLATION" => b.translation = v3(&v),
+                        "LINEAR_VELOCITY" => b.linear_velocity = v3(&v),
+                        "ANGULAR_VELOCITY" => b.angular_velocity = v3(&v),
+                        "ACTIVE" => b.active = flag(rest),
+                        "COLLISIONS_DISABLED" => b.collisions_disabled = flag(rest),
+                        "DISPLACEMENT" => b.displacement = v3(&v),
+                        "CASTS_SHADOWS" => b.casts_shadows = flag(rest),
+                        _ => {}
+                    }
+                }
+            }
+        }
+    }
+}
